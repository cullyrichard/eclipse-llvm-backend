#!/usr/bin/env bash
# eclipse-cc: compile one or more C source files to a runnable dgasm/
# eclipseemu program for the Data General Nova/Eclipse LLVM backend.
#
# Usage: eclipse-cc [-o out.simh] [--ieee] [--hwfloat] file.c [file.c ...]
#
# As of DEBUGGING_NOTES.md entry #30, this target's DEFAULT (no flags at
# all) is DG hardware-accelerated float: real Eclipse S/140 FPU
# instructions (FAS/FSS) for add/subtract instead of the software
# __addsf3/__subsf3, plus a fix for a pre-existing bug where a file-
# scope/`static` float global's initializer silently materialized as 0
# (EclipseAsmPrinter.cpp had no ConstantFP case at all -- see entry #27
# point 9). Multiply/divide and int<->float conversion stay on their
# original software implementations either way (entry #30 re-probed
# FMS/FDS/FLAS/FFAS fresh on eclipseemu and found no safe additional
# hardware path for those -- see that entry for the full story).
#
# --ieee: opt OUT of the above and restore this target's *original*,
# pre-entry-#30 default: pure IEEE-754 float, software arithmetic,
# including the pre-existing global-float-initializer bug preserved
# exactly (verified byte-for-byte identical to every pre-entry-#30
# build -- see DEBUGGING_NOTES.md entry #30's own verification section).
#
# --hwfloat: this flag's OWN meaning is unchanged since it was
# introduced (entry #27) -- real-hardware-FPU float add/subtract only,
# nothing else. Since that's now also what happens with no flags at
# all, this script sets `--ieee` together with `--hwfloat` automatically
# whenever `--hwfloat` is passed, so `eclipse-cc --hwfloat` alone still
# reproduces its own pre-entry-#30 behavior exactly (IEEE-754 ABI/
# storage, hardware add/subtract only, global-float-initializer bug
# still present) -- see rt/eclipse_hwfloat.s's own header comment for
# the hardware-FPU design itself and DEBUGGING_NOTES.md for the
# reverse-engineering/verification behind it.
#
# Pipeline: clang -cc1 (one .ll per source, incl. the runtime library) ->
# llvm-link (merge into one module) -> opt -internalize,globaldce (strip
# whichever runtime-library functions the program doesn't actually call
# — page-zero data is a hard, shared 256-word budget across the *whole*
# program; every unused function's constant pool/call-slot/etc. eats
# into it for nothing, confirmed empirically: eclipse_rt.c linked in
# whole overflows page-zero on its own once enough of it exists) -> llc
# -> reorder_asm.py (dgasm has no linker/sections, so page-zero data
# must precede code textually — see reorder_asm.py's own comment) ->
# dgasm.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LLVM_BUILD="${LLVM_BUILD:-$HOME/dev/llvm-build}"
CLANG="$LLVM_BUILD/bin/clang"
LLC="$LLVM_BUILD/bin/llc"
LLVM_LINK="$LLVM_BUILD/bin/llvm-link"
OPT="$LLVM_BUILD/bin/opt"
RT_SRC="$SCRIPT_DIR/rt/eclipse_rt.c"
HWFLOAT_SRC="$SCRIPT_DIR/rt/eclipse_hwfloat.s"
REORDER="$SCRIPT_DIR/reorder_asm.py"
TRIPLE="eclipse-dg-none"
RESOURCE_DIR="$("$CLANG" -print-resource-dir)"

out="a.simh"
hwfloat=0
ieee=0
sources=()
while [ $# -gt 0 ]; do
  case "$1" in
    -o) out="$2"; shift 2 ;;
    --hwfloat) hwfloat=1; shift ;;
    --ieee) ieee=1; shift ;;
    *) sources+=("$1"); shift ;;
  esac
done

# --hwfloat implies --ieee -- see this script's own header comment on
# why: preserves --hwfloat's own pre-entry-#30 meaning (IEEE-754 ABI/
# storage, hardware add/subtract only) exactly, now that hardware
# add/subtract alone is also what the bare default does.
if [ "$hwfloat" -eq 1 ]; then
  ieee=1
fi

# clang-side flags, only meaningful for future Clang-level uses of these
# features (nothing in the current implementation reads them there -- the
# actual libcall-selection/constant-emission decisions are entirely
# llc/subtarget-side, see EclipseSubtarget.cpp/EclipseISelLowering.cpp/
# EclipseAsmPrinter.cpp) -- passed anyway so `-target-feature` and
# `-mattr` never drift out of sync with each other.
cc1_float_flags=()
mattr_list=()
if [ "$hwfloat" -eq 1 ]; then
  cc1_float_flags+=(-target-feature +hwfloat)
  mattr_list+=("+hwfloat")
fi
if [ "$ieee" -eq 1 ]; then
  cc1_float_flags+=(-target-feature +ieee)
  mattr_list+=("+ieee")
fi
# Single comma-joined -mattr= (not one per feature) -- confirmed this
# matters: llc's cl::list<std::string> -mattr accumulates multiple
# occurrences as separate *entries*, each independently comma-split, so
# two separate `-mattr=+hwfloat -mattr=+ieee` args do work the same as
# one `-mattr=+hwfloat,+ieee` -- but joining them explicitly here avoids
# ever depending on that accumulation behavior.
llc_float_flags=()
if [ "${#mattr_list[@]}" -gt 0 ]; then
  IFS=,
  llc_float_flags=("-mattr=${mattr_list[*]}")
  unset IFS
fi

if [ ${#sources[@]} -eq 0 ]; then
  echo "eclipse-cc: no input files" >&2
  exit 1
fi

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

ll_files=()

compile_one() {
  local src="$1" base ll
  base="$(basename "${src%.*}")"
  ll="$work/${base}.ll"
  # -nostdsysteminc: without it, -cc1 (bypassing the normal driver, which is
  # what would otherwise set this up) falls through to the *host*
  # machine's real system headers on a bare #include <...> lookup — e.g.
  # <stdio.h> silently resolving to glibc's, whose declarations (FILE*,
  # va_list layout, 64-bit size_t, ...) are wrong for this 16-bit
  # freestanding target. -isystem "$RESOURCE_DIR/include" keeps clang's
  # own compiler-provided headers (stdarg.h, stddef.h) reachable, since
  # those aren't part of this project's own headers. -I "rt/include" is
  # this project's real <stdio.h>/<string.h>/<ctype.h>/<stdlib.h>; -I
  # "rt" is kept for "eclipse_rt.h" (quoted-include backward
  # compatibility — see eclipse_rt.h).
  "$CLANG" -cc1 -triple "$TRIPLE" -nostdsysteminc \
    -isystem "$RESOURCE_DIR/include" \
    -I "$SCRIPT_DIR/rt/include" -I "$SCRIPT_DIR/rt" \
    "${cc1_float_flags[@]}" \
    -emit-llvm "$src" -o "$ll"
  ll_files+=("$ll")
}

for src in "${sources[@]}"; do
  compile_one "$src"
done
compile_one "$RT_SRC"

merged="$work/merged.ll"
"$LLVM_LINK" -S "${ll_files[@]}" -o "$merged"

# Only `main` needs to survive as an external symbol — this is always
# the whole program (dgasm has no separate-compilation/linking model),
# so anything unreachable from it is genuinely dead, not "might be used
# by another translation unit later" the way it would be in a normal
# multi-TU build.
#
# The soft-float runtime symbols are a special case: `llc`'s own codegen
# inserts calls to these (float arithmetic/compare/convert get
# "softened" into libcalls during instruction selection, not visible as
# explicit IR calls) *after* this opt pass has already run — so from
# globaldce's point of view they're unreferenced and get stripped, even
# on programs that genuinely need them. Confirmed empirically
# ("Undefined symbol: __fixsfsi" at the dgasm step on any program using
# `float`). The same thing happens for memcpy/memmove/memset/memcmp
# once those are wired up as RTLIB::MEMCPY/etc. implementations
# (EclipseISelLowering.cpp): an initialized local aggregate (e.g. `int
# Array[10] = {...};`) can make llc's own lowering insert a call to
# memcpy that likewise doesn't exist as a visible IR call before this
# opt pass runs. The retry regex below originally only matched `__`-
# prefixed names (every soft-float symbol happens to be one), so
# "Undefined symbol: memcpy" silently fell through as a hard failure
# with no retry at all — broadened to match any C identifier so this
# same protect-and-retry loop covers both symbol families.
#
# Protecting all of them unconditionally, always, was tried first and
# rejected: it costs real page-zero budget even for a program using
# just one float op, confirmed to push an otherwise-small,
# single-float-function program over the shared 256-word ceiling on its
# own (see eclipse_rt.c's soft-float section header comment and
# README.md's "Known limitations") — before this program even had a
# chance to need more than one or two of the fourteen. So instead:
# iteratively discover exactly which ones this specific program needs.
# Each retry adds only the symbols dgasm *just* reported undefined
# (there can be more than one still-undefined per pass — e.g. protecting
# __addsf3 alone doesn't pull in __fixsfsi too, they're independent
# libcalls) and tries again, stopping as soon as a pass reports no *new*
# undefined-symbol names (either success, or a genuine failure — page-
# zero overflow from needing too many at once, or a real undefined
# symbol unrelated to soft-float — that finding more names won't fix.
build_and_assemble() {
  local pub_api="$1"
  local stripped="$work/stripped.ll"
  "$OPT" -S -passes="internalize,globaldce" \
    -internalize-public-api-list="$pub_api" \
    "$merged" -o "$stripped"

  local asm="$work/out.s"
  "$LLC" -mtriple="$TRIPLE" "${llc_float_flags[@]}" -filetype=asm "$stripped" -o "$asm"

  # Append the hand-written __addsf3_hw/__subsf3_hw assembly (see
  # rt/eclipse_hwfloat.s's own header comment) onto llc's own output
  # before reorder_asm.py runs, so its `var` lines get hoisted to
  # page-zero exactly like every compiler-emitted one -- reorder_asm.py
  # is pure line-oriented text manipulation with no dependency on where a
  # line originally came from (see its own header comment). Needed
  # whenever llc's own ADD_F32/SUB_F32 choice (EclipseSubtarget.cpp's
  # useHardwareFloat(), mirrored here) actually resolved to
  # __addsf3_hw/__subsf3_hw -- as of DEBUGGING_NOTES.md entry #30 that's
  # the DEFAULT (no flags at all), not just `--hwfloat` -- get this
  # condition wrong in either direction and dgasm either reports
  # "Undefined symbol: __addsf3_hw" (llc referenced it, this script
  # didn't provide it) or wastes page-zero budget providing a function
  # nothing calls. `--ieee` (without `--hwfloat`) is the only combination
  # that does NOT need it.
  if [ "$ieee" -eq 0 ] || [ "$hwfloat" -eq 1 ]; then
    cat "$HWFLOAT_SRC" >> "$asm"
  fi

  local reordered="$work/out_r.s"
  python3 "$REORDER" "$asm" "$reordered"

  dgasm -t eclipse_s140 -f simh -o "$out" "$reordered"
}

# dgasm's own exit code is not trustworthy here: confirmed empirically
# (repeatedly, on real "Address out of range" page-zero overflows) that
# it can print a real error and still exit 0 — the "Undefined symbol"
# case happens to set a nonzero exit correctly, but that's dgasm's own
# inconsistency, not something this script can rely on in general. Using
# `if build_and_assemble ...; then` (trusting the exit code) meant any
# *other* kind of dgasm error silently fell through as if it had
# succeeded, printing "wrote $out" even though $out was never actually
# (fully) written — i.e. dgasm's real errors were invisible. Fixed by
# checking whether $out actually exists instead: that's true ground
# truth regardless of what dgasm's exit code claims, and works for any
# dgasm error type, not just the ones this script already knows how to
# retry past. `rm -f "$out"` before each attempt so a stale file from an
# earlier failed pass can't masquerade as this pass's success.
protected="main"
pass=1
while :; do
  rm -f "$out"
  output="$(build_and_assemble "$protected" 2>&1)" || true
  if [ -f "$out" ]; then
    echo "$output"
    break
  fi
  # `|| true` on both: under `set -e -o pipefail`, a `var=$(...)` assignment
  # whose pipeline's *last-failing* command is `grep` finding zero matches
  # (the normal, expected case once there's no "Undefined symbol" text left
  # to find — e.g. dgasm's real failure this pass is something else
  # entirely, like a genuine page-zero overflow) silently aborts the whole
  # script right here, with exit status 0 — confirmed empirically, and a
  # second, independent way dgasm's real errors were going invisible even
  # after the $out-existence fix above. Without the guard, that abort skips
  # the error reporting below entirely.
  missing="$(echo "$output" | grep -oE 'Undefined symbol: [A-Za-z_][A-Za-z0-9_]*' \
             | sed 's/Undefined symbol: //' | sort -u)" || true
  new="$(comm -23 <(echo "$missing") <(echo "$protected" | tr ',' '\n' | sort -u))" || true
  if [ -z "$new" ] || [ "$pass" -ge 15 ]; then
    echo "eclipse-cc: dgasm failed:" >&2
    echo "$output" >&2
    exit 1
  fi
  echo "eclipse-cc: retrying with $(echo "$new" | tr '\n' ' ')protected (needed by this program)" >&2
  protected="$protected,$(echo "$new" | tr '\n' ',' | sed 's/,$//')"
  pass=$((pass + 1))
done

echo "eclipse-cc: wrote $out"
