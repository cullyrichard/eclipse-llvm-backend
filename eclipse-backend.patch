+// Builds the dgasm address-expression text for an ELEF/ELDA/ESTA
+// instruction targeting a GlobalAddress operand: the target's own symbol
+// name, plus "+N"/"-N" if the operand carries a nonzero compile-time
+// offset. dgasm's expression evaluator resolves "symbol+integer" to the
+// symbol's own assigned address plus that integer at assemble time
+// (confirmed empirically -- see DEBUGGING_NOTES.md), so folding a
+// constant offset in here needs no extra instruction or page-zero word,
+// unlike the old LEAGA/_PTR scheme's runtime AC2-based ADD for the same
+// case.
+//
+// MO.getOffset() is a *byte* offset (LLVM's GlobalAddress offsets always
+// are), but this backend's addresses are word-granular (every Eclipse
+// word is 2 of those DataLayout bytes -- same reason
+// EclipseFrameLowering::processFunctionBeforeFrameFinalized divides
+// object sizes by 2). That "2 DataLayout bytes per word" rule only holds
+// for globals this backend actually *packs* two-bytes-to-a-word -- i.e.
+// numeric array initializers, emitted one full word per element by
+// emitGlobalVariable regardless of the element's own DataLayout size (so
+// 2 bytes worth of offset really does mean 1 word of address). A string
+// literal is emitted completely differently: dgasm's `var name = "..."`
+// (no `packed` suffix) reserves one full word *per character* (see
+// dgasm's assembler.c, VARIABLE_STRING vs VARIABLE_PACKED_STRING) -- so a
+// byte offset into a string is already a word offset, and dividing it by
+// 2 here would truncate every *odd* byte offset down to its even
+// neighbour's word, silently reading/writing the wrong character (the
+// exact bug the original LEAGA implementation of this same rule fixed --
+// see the "found via a local char arr[5]" history in this project's
+// DEBUGGING_NOTES.md).
+std::string EclipseAsmPrinter::extendedAddrExpr(const MachineOperand &MO) {
+  StringRef Target = getSymbol(MO.getGlobal())->getName();
+  int64_t Divisor = 2;
+  if (const auto *GV = dyn_cast<GlobalVariable>(MO.getGlobal())) {
+    if (GV->hasInitializer()) {
+      if (const auto *CDA = dyn_cast<ConstantDataArray>(GV->getInitializer()))
+        if (CDA->isString())
+          Divisor = 1;
+    }
+  }
+  int64_t Offset = MO.getOffset() / Divisor;
+  if (Offset == 0)
+    return Target.str();
+  return (Target + (Offset > 0 ? "+" : "") + Twine(Offset)).str();
+}
