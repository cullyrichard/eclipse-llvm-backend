+// Alternate ADD_F32/SUB_F32 implementations for the Eclipse (Data
+// General Nova/Eclipse) target's optional `+hwfloat` SubtargetFeature:
+// real Eclipse S/140 hardware FPU instructions (FAS/FSS) instead of the
+// default software libcall (__addsf3/__subsf3, still the unconditional
+// default -- see llvm/lib/Target/Eclipse/EclipseSubtarget.cpp). Mirrors
+// the existing __addsf3vfp/__subsf3vfp pattern ARM uses for its own
+// optional hardware-FPU alternates above. Selected explicitly via
+// setLibcallImpl, not any triple-keyed availability list, the same way
+// this target already wires up every other libcall it uses.
+def __addsf3_hw : RuntimeLibcallImpl<ADD_F32>;
+def __subsf3_hw : RuntimeLibcallImpl<SUB_F32>;
+
 def __subsf3 : RuntimeLibcallImpl<SUB_F32>;
 def __subdf3 : RuntimeLibcallImpl<SUB_F64>;
 def __subxf3 : RuntimeLibcallImpl<SUB_F80>;
