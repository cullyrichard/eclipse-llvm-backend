+namespace {
+// Which real skip-test instruction each conditional branch pseudo prints,
+// and whether it's the zero test (MOV#) or the sign test (MOVL#) — see
+// docs/CALLING_CONVENTION.md's verified idiom in the sibling eccc project.
+struct SkipTest {
+  const char *Mnemonic; // "MOV#" or "MOVL#"
+  const char *Skip;     // "SZR", "SNR", "SZC", "SNC"
+};
+
+// The printed sequence is "<test>,<skip>" then "JMP $dst": the *skip*
+// fires (and the JMP is *not* taken) exactly when the skip-condition
+// holds. So to make the JMP execute — i.e. actually branch — precisely
+// when this pseudo's own named condition holds, each one needs the
+// *opposite* skip test: BRZ (branch when val==0) must skip when val!=0
+// (SNR), not when val==0 (that would skip the JMP in exactly the case
+// BRZ is supposed to take it). Same inversion for the other three.
+SkipTest skipTestFor(unsigned Opcode) {
+  switch (Opcode) {
+  case Eclipse::BRZ:
+    return {"MOV#", "SNR"};
+  case Eclipse::BRNZ:
+    return {"MOV#", "SZR"};
+  case Eclipse::BGEZ:
+    return {"MOVL#", "SNC"};
+  case Eclipse::BLTZ:
+    return {"MOVL#", "SZC"};
+  // BGEU/BLTU aren't in this table: unlike the other four, they test the
+  // *native* carry from "SUB# rhs,lhs" directly, not a rotated copy of a
+  // single already-computed value — see emitInstruction's own BGEU/BLTU
+  // case, which prints "SUB#" (not this function's Mnemonic) against two
+  // distinct operands. Same skip letters apply, though (SNC/SZC), which
+  // is why they're documented alongside these here rather than
+  // separately: BGEU's "branch if no borrow occurred" is the same SNC
+  // used by BGEZ's "branch if sign bit clear", just fed by a different
+  // preceding instruction.
+  default:
+    llvm_unreachable("not a conditional branch");
+  }
+}
+} // namespace
+
+void EclipseAsmPrinter::emitInstruction(const MachineInstr *MI) {
+  switch (MI->getOpcode()) {
+  case Eclipse::BRZ:
+  case Eclipse::BRNZ:
+  case Eclipse::BGEZ:
+  case Eclipse::BLTZ: {
+    SkipTest T = skipTestFor(MI->getOpcode());
+    StringRef Reg = EclipseInstPrinter::getRegisterName(MI->getOperand(0).getReg());
+    OutStreamer->emitRawText(
+        (Twine("\t") + T.Mnemonic + " " + Reg + "," + Reg + "," + T.Skip).str());
+    OutStreamer->emitRawText(
+        (Twine("\tJMP ") + MI->getOperand(1).getMBB()->getSymbol()->getName())
+            .str());
+    return;
+  }
+  case Eclipse::BGEU:
+  case Eclipse::BLTU: {
+    // Bare "SUB# rhs,lhs,<skip>" (the original design here) turned out to
+    // be a genuine hardware bug in this lowering, not just a documentation
+    // slip: on real Nova/Eclipse ALU encoding, the carry field of a plain
+    // SUB (no Z/O/C modifier) is "none" — the carry it leaves behind is
+    // *whatever carry was already set* before the instruction executed,
+    // completely independent of lhs/rhs. Confirmed empirically against
+    // eclipseemu with a direct carry-in/carry-out truth table: bare SUB#'s
+    // carry-out equals its carry-in in all four (carry-in, lhs-vs-rhs)
+    // combinations tested. This is what caused the "same source, different
+    // compiled skip letter" contradiction — the residual carry differs by
+    // program, not the node type.
+    //
+    // The real fix needs a *forced* carry-in, i.e. "SUBZ" (the Z carry
+    // modifier). But SUBZ can't be combined with "#" (test mode / no
+    // writeback) — that specific combination decodes as an unrelated XOP
+    // instruction on this hardware/simulator (also confirmed empirically:
+    // "ADDZ#"/"SUBZ#" both mis-decode). So the comparison can't be done
+    // in a single non-clobbering instruction the way the signed BGEZ/BLTZ
+    // path does.
+    //
+    // Instead: borrow AC2 (the frame pointer) as scratch, exactly like the
+    // MUL/DIV pseudo-expansion already does elsewhere in this file/backend
+    // — save it to the software stack, copy lhs into it, SUBZ rhs into it
+    // (now carry is a clean, deterministic function of lhs/rhs only:
+    // confirmed via truth table that carry=1 iff lhs>=rhs, unsigned),
+    // restore AC2, then read that already-set carry with a *bare* "SUB#"
+    // self-test (confirmed pure carry passthrough, i.e. doesn't disturb
+    // the carry we just restored-past) purely to attach the skip
+    // modifier. DSZ/STA/LDA/ISZ (the save/restore sequence) were each
+    // confirmed not to disturb carry either.
+    // Skip-field semantics confirmed via a direct, isolated eclipseemu
+    // test (deposit carry explicitly, execute *only* the skip
+    // instruction, watch whether PC advances by one word or two): "SZC"
+    // fires (skips) when C=1, "SNC" fires when C=0 — the opposite of
+    // what the mnemonics suggest. Combined with the SUBZ truth table
+    // above (C=1 iff lhs>=rhs), BGEU needs "SNC" (skip — i.e. don't take
+    // the branch — when C=0/lhs<rhs) and BLTU needs "SZC" (skip when
+    // C=1/lhs>=rhs).
+    const char *Skip = MI->getOpcode() == Eclipse::BGEU ? "SNC" : "SZC";
+    StringRef Lhs = EclipseInstPrinter::getRegisterName(MI->getOperand(0).getReg());
+    StringRef Rhs = EclipseInstPrinter::getRegisterName(MI->getOperand(1).getReg());
+    // 040: fixed hardware stack-pointer location — same one real SAVE/
+    // RTN use natively (EclipseInstrInfo.td), not a separate `_SP`
+    // variable, so this scratch save/restore can never drift out of
+    // sync with the frame SAVE/RTN are managing at the same time. Real
+    // SAVE grows this stack *upward* (increment-then-store), so push
+    // here is ISZ-then-store and pop is load-then-DSZ — the opposite of
+    // what the old, purely-software `_SP` stack this replaced used.
+    OutStreamer->emitRawText("\tISZ 040,0");
+    OutStreamer->emitRawText("\tSTA 2,@040");
+    OutStreamer->emitRawText((Twine("\tMOV ") + Lhs + ",2").str());
+    OutStreamer->emitRawText((Twine("\tSUBZ ") + Rhs + ",2").str());
+    OutStreamer->emitRawText("\tLDA 2,@040");
+    OutStreamer->emitRawText("\tDSZ 040,0");
+    OutStreamer->emitRawText((Twine("\tSUB# 2,2,") + Skip).str());
+    OutStreamer->emitRawText(
+        (Twine("\tJMP ") + MI->getOperand(2).getMBB()->getSymbol()->getName())
+            .str());
+    return;
+  }
+  case Eclipse::LEAGA: {
+    StringRef Dst = EclipseInstPrinter::getRegisterName(MI->getOperand(0).getReg());
+    std::string Addr = extendedAddrExpr(MI->getOperand(1));
+    // ELEF: real Eclipse S/140 "extended load effective address" -- loads
+    // the operand's own resolved *address*, not the word stored there
+    // (confirmed empirically -- see DEBUGGING_NOTES.md). A single
+    // instruction, no page-zero pointer word at all.
+    OutStreamer->emitRawText((Twine("\tELEF ") + Dst + "," + Addr).str());
+    return;
+  }
+  case Eclipse::ELDAGA: {
+    StringRef Dst = EclipseInstPrinter::getRegisterName(MI->getOperand(0).getReg());
+    std::string Addr = extendedAddrExpr(MI->getOperand(1));
+    OutStreamer->emitRawText((Twine("\tELDA ") + Dst + "," + Addr).str());
+    return;
+  }
+  case Eclipse::ESTAGA: {
+    StringRef Src = EclipseInstPrinter::getRegisterName(MI->getOperand(0).getReg());
+    std::string Addr = extendedAddrExpr(MI->getOperand(1));
+    OutStreamer->emitRawText((Twine("\tESTA ") + Src + "," + Addr).str());
+    return;
+  }
+  default:
+    break;
+  }
+
+  EclipseMCInstLower Lower(OutContext, *this);
+  MCInst TmpInst;
+  Lower.Lower(MI, TmpInst);
+  EmitToStreamer(*OutStreamer, TmpInst);
+}
+
+void EclipseAsmPrinter::printOperand(const MachineInstr *MI, int OpNum,
+                                      raw_ostream &O) {
+  const MachineOperand &MO = MI->getOperand(OpNum);
+  switch (MO.getType()) {
+  case MachineOperand::MO_Register:
+    O << EclipseInstPrinter::getRegisterName(MO.getReg());
+    break;
+  case MachineOperand::MO_Immediate:
+    O << MO.getImm();
+    break;
+  case MachineOperand::MO_MachineBasicBlock:
+    MO.getMBB()->getSymbol()->print(O, MAI);
+    break;
+  case MachineOperand::MO_GlobalAddress:
+    getSymbol(MO.getGlobal())->print(O, MAI);
+    break;
+  case MachineOperand::MO_ExternalSymbol:
+    GetExternalSymbolSymbol(MO.getSymbolName())->print(O, MAI);
+    break;
+  default:
+    llvm_unreachable("unsupported inline-asm operand kind");
+  }
+}
+
+// No ExtraCode ('%a'/'%c'/'%n'/'%s'-style) modifiers are supported yet —
+// only plain %0/%1/... substitution, which is all a device-I/O
+// instruction's operands (an accumulator, a device code) need.
+bool EclipseAsmPrinter::PrintAsmOperand(const MachineInstr *MI, unsigned OpNo,
+                                         const char *ExtraCode,
+                                         raw_ostream &O) {
+  if (ExtraCode && ExtraCode[0])
+    return true; // unknown/unsupported modifier
+  printOperand(MI, OpNo, O);
+  return false;
+}
+
+extern "C" LLVM_ABI LLVM_EXTERNAL_VISIBILITY void
+LLVMInitializeEclipseAsmPrinter() {
+  RegisterAsmPrinter<EclipseAsmPrinter> X(getTheEclipseTarget());
+}
diff --git a/llvm/lib/Target/Eclipse/EclipseAsmPrinter.h b/llvm/lib/Target/Eclipse/EclipseAsmPrinter.h
new file mode 100644
index 000000000..cd561d350
--- /dev/null
+++ b/llvm/lib/Target/Eclipse/EclipseAsmPrinter.h
@@ -0,0 +1,118 @@
+//===-- EclipseAsmPrinter.h - Eclipse LLVM assembly writer -----*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM
+// Exceptions. See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// Drives the module-level structure a real dgasm source file needs (an
+// `org`/`dev` preamble, an optional `_start`/HALT entry trampoline when
+// the module defines `main`, and `var` declarations for globals/string
+// literals/constant-pool entries) around the per-function instruction
+// text. See README.md and the sibling `eccc` project's
+// crates/eccc-codegen/src/symbolic.rs, which this mirrors. Direct calls
+// (EJSR) and global access (ELEF/ELDA/ESTA) both reach their targets via
+// real Eclipse S/140 extended addressing now, with no page-zero
+// jump-table or pointer-slot bookkeeping left for this file to track at
+// all -- see EclipseInstrInfo.td's CALL and LEAGA comments, and
+// DEBUGGING_NOTES.md, for that history.
+//
+// IMPORTANT — page-zero placement: all `var` declarations that must
+// still be page-zero-resident (the constant pool, `_STACKTOP`/
+// `_STACKLIM`/`_scratch`) must physically end up within the first ~200
+// words of the address space: `LDA`/`STA ac,addr` default to
+// *page-zero* (absolute, no index) addressing with only an 8-bit
+// displacement, and dgasm assigns addresses strictly in textual source
+// order starting at `org` (confirmed by reading its assembler.c
+// directly, not assumed). Growing function bodies can push a `var` line
+// emitted after them past address 255, which dgasm rejects.
+//
+// This AsmPrinter does *not* solve that itself (it would require
+// buffering and reordering essentially everything AsmPrinter emits,
+// including labels emitted by its own internal machinery, not just this
+// file's explicit emitRawText calls — real surgery for a marginal gain
+// over the alternative). Instead, the toolchain wrapper this project
+// ships (see the driver script) runs a small, separate text-level
+// reordering pass on `llc`'s output before handing it to dgasm: keep the
+// fixed org/dev/_start preamble first, then move every remaining `var `
+// line before every remaining non-`var` line, preserving relative order
+// within each group. Pure line-oriented text manipulation, easy to
+// verify independently of AsmPrinter's internals. Matches eccc's own
+// proven layout (docs/DESIGN.md / docs/CALLING_CONVENTION.md): small
+// page-zero data first, arbitrarily-large code after.
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_LIB_TARGET_ECLIPSE_ECLIPSEASMPRINTER_H
+#define LLVM_LIB_TARGET_ECLIPSE_ECLIPSEASMPRINTER_H
+
+#include "llvm/ADT/SmallVector.h"
+#include "llvm/CodeGen/AsmPrinter.h"
+#include <string>
+
+namespace llvm {
+
+class EclipseAsmPrinter : public AsmPrinter {
+  bool HasMain = false;
+
+  // Name of the module's `__attribute__((interrupt))` function, if any
+  // (computed once in doInitialization, before any function body is
+  // emitted, since emitStartOfAsmFile needs it for the vector directive
+  // it writes ahead of everything else). Empty means no interrupt handler
+  // in this module. Real hardware has exactly one interrupt vector
+  // (memory location 1), so more than one such function is a hard error
+  // (doInitialization), not a "pick one" situation.
+  std::string InterruptHandlerName;
+
+  // Builds the dgasm address-expression text ("target" or "target+-N")
+  // for an ELEF/ELDA/ESTA instruction's GlobalAddress operand -- see the
+  // definition in EclipseAsmPrinter.cpp for the full rationale (dgasm's
+  // "symbol+integer" expression folding, and the byte-vs-word offset
+  // divisor rule shared with emitGlobalVariable).
+  std::string extendedAddrExpr(const MachineOperand &MO);
+
+  // NB: internal JMPs (conditional-branch trailing jumps and plain
+  // unconditional ones) stay direct/PC-relative, base-ISA JMP (no
+  // extended EJMP form used here) — a real program can have many dozens
+  // of basic blocks; giving every one a permanent page-zero slot (the
+  // scheme CALL itself used before it moved to direct EJSR) was tried and
+  // overflowed the 256-word page-zero budget on nothing fancier than
+  // eclipse_rt.c's printf/scanf. Out-of-range jumps (dgasm:
+  // "Address out of range", displacement outside -128..127) are instead
+  // relaxed selectively, only where actually needed, by
+  // eclipse-toolchain/reorder_asm.py — it runs after llc, when real
+  // per-instruction addresses are computable, which this AsmPrinter
+  // (still mid-codegen, no real addresses yet) cannot do itself.
+
+public:
+  explicit EclipseAsmPrinter(TargetMachine &TM,
+                              std::unique_ptr<MCStreamer> Streamer)
+      : AsmPrinter(TM, std::move(Streamer), ID) {}
+
+  StringRef getPassName() const override { return "Eclipse Assembly Printer"; }
+
+  bool doInitialization(Module &M) override;
+  void emitStartOfAsmFile(Module &M) override;
+  void emitEndOfAsmFile(Module &M) override;
+  void emitInstruction(const MachineInstr *MI) override;
+  void emitGlobalVariable(const GlobalVariable *GV) override;
+  void emitConstantPool() override;
+
+  // Inline asm operand substitution (e.g. `asm volatile("DOAS %0,012" ::
+  // "r"(ch))` — the escape hatch for device I/O instructions, since those
+  // have no ordinary-C-semantics mapping; see README.md).
+  void printOperand(const MachineInstr *MI, int OpNum, raw_ostream &O);
+  bool PrintAsmOperand(const MachineInstr *MI, unsigned OpNo,
+                        const char *ExtraCode, raw_ostream &O) override;
+
+  // dgasm's grammar has no linkage-visibility directive (".globl" and
+  // friends are a GNU-assembler concept) — labels are just labels.
+  void emitLinkage(const GlobalValue *, MCSymbol *) const override {}
+
+  static char ID;
+};
+
+} // namespace llvm
+
+#endif // LLVM_LIB_TARGET_ECLIPSE_ECLIPSEASMPRINTER_H
diff --git a/llvm/lib/Target/Eclipse/EclipseFrameLowering.cpp b/llvm/lib/Target/Eclipse/EclipseFrameLowering.cpp
new file mode 100644
index 000000000..8d9f53ac1
--- /dev/null
+++ b/llvm/lib/Target/Eclipse/EclipseFrameLowering.cpp
@@ -0,0 +1,211 @@
+//===-- EclipseFrameLowering.cpp - Eclipse Frame Information -------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM
+// Exceptions. See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "EclipseFrameLowering.h"
+#include "EclipseInstrInfo.h"
+#include "EclipseRegisterInfo.h"
+#include "EclipseSubtarget.h"
+#include "llvm/CodeGen/MachineFrameInfo.h"
+#include "llvm/CodeGen/MachineFunction.h"
+#include "llvm/CodeGen/MachineInstrBuilder.h"
+#include "llvm/CodeGen/RegisterScavenging.h"
+
+using namespace llvm;
+
+// StackGrowsUp, not StackGrowsDown: real hardware SAVE reserves its
+// "Words" local/temp area *above* the frame pointer (FP+1..FP+Words -
+// see emitPrologue's comment and EclipseInstrInfo.td's SAVE comment),
+// not below it. Locals need to live there, on the *opposite* side of
+// FP from arguments (which sit below FP, at FP-5 and beyond - see
+// LowerFormalArguments in EclipseISelLowering.cpp) and from SAVE's own
+// 5 pushed linkage words (also below FP, at FP through FP-4). Confirmed
+// the hard way this distinction matters: with StackGrowsDown (the
+// setting the old, software-only _SP calling convention this replaced
+// correctly used, since *that* stack did grow downward), LLVM's
+// generic PEI frame-object-offset pass placed ordinary locals at
+// negative FP-relative offsets same as arguments - for a function with
+// enough locals, or in a deep-enough call chain, that put a local
+// right on top of one of SAVE's own linkage words (observed: FP-4,
+// AC0's saved-caller-value slot, got overwritten mid-function and then
+// clobbered again by the epilogue's own return-value store - by the
+// time RTN read it back the real value was long gone, so RTN restored
+// garbage into AC2/PC and the program jumped to a bogus address).
+// Moving locals to the positive side removes the collision entirely
+// instead of just relocating it.
+EclipseFrameLowering::EclipseFrameLowering(const EclipseSubtarget & /*STI*/)
+    : TargetFrameLowering(TargetFrameLowering::StackGrowsUp, Align(2), 2) {}
+// LocalAreaOffset = 2 (bytes = 1 word), not 0: offset 0 itself is also
+// reserved - it's SAVE's own return-address slot (mem[FP], the word
+// RTN reads to jump back to the caller). With LocalAreaOffset=0, PEI's
+// generic pass placed one function's spill/local object *at* offset 0
+// (confirmed by inspecting the generated assembly: "STA 0,0,2" in a
+// function using long-typed parameters), directly overwriting the
+// return address before RTN could read it back - the exact same class
+// of bug this whole StackGrowsUp change exists to fix, just relocated
+// by one word instead of eliminated. Shifting the local area to start
+// one word later closes that last gap.
+
+// Frame linkage (push/pop the caller's FP + return address, establish/
+// tear down this function's own frame pointer) is built entirely from
+// the real hardware SAVE/RTN instructions — see EclipseInstrInfo.td's
+// SAVE/RET(="RTN") definitions for the verified semantics and why this
+// is safe, contrary to this file's own history (this used to say real
+// hardware PSH/POP/SAVE/RTN "were tried and rejected as needing an
+// OS-managed environment this bare-metal target doesn't have" — an
+// unverified claim inherited from the sibling eccc project; direct
+// testing on eclipseemu found that's not actually true once the three
+// fixed hardware-register locations SAVE/RTN use are initialized once
+// at program start, see EclipseAsmPrinter.cpp's _start emission).
+//
+// Argument push/pop (emitPushPop/emitAdjCallStack, EclipseISelLowering.cpp)
+// and a couple of scratch-register save/restore sites (EclipseAsmPrinter.cpp,
+// EclipseInstrInfo.cpp's MUL/DIV expansion) still use a software
+// push/pop sequence — but now against the same fixed hardware stack-
+// pointer location (040) SAVE/RTN themselves use, not a separate `_SP`
+// variable, so the two never drift apart or overlap.
+
+void EclipseFrameLowering::emitPrologue(MachineFunction &MF,
+                                         MachineBasicBlock &MBB) const {
+  MachineBasicBlock::iterator MBBI = MBB.begin();
+  DebugLoc DL;
+  const auto &TII =
+      *MF.getSubtarget<EclipseSubtarget>().getInstrInfo();
+  MachineFrameInfo &MFI = MF.getFrameInfo();
+
+  // SAVE pushes AC0/AC1/AC2/old-FP/AC3(retaddr) and reserves Words more
+  // local/temp words, all in a single instruction.
+  uint64_t Words = MFI.getStackSize();
+  BuildMI(MBB, MBBI, DL, TII.get(Eclipse::SAVE)).addImm(Words);
+  // SAVE leaves the new frame pointer in AC3 (and hardware location
+  // 041) — copy into AC2 so every *other* frame-relative address
+  // computation already in this backend (eliminateFrameIndex,
+  // LowerFormalArguments, LowerVASTART/VAARG, ...) keeps working exactly
+  // as before, completely unmodified. Costs one extra instruction here
+  // but keeps this whole change contained to prologue/epilogue instead
+  // of touching every existing AC2-is-the-frame-pointer assumption
+  // throughout the backend.
+  BuildMI(MBB, MBBI, DL, TII.get(Eclipse::MOVrr), Eclipse::AC2)
+      .addReg(Eclipse::AC3);
+}
+
+void EclipseFrameLowering::emitEpilogue(MachineFunction &MF,
+                                         MachineBasicBlock &MBB) const {
+  MachineBasicBlock::iterator MBBI = MBB.getFirstTerminator();
+  DebugLoc DL = MBBI != MBB.end() ? MBBI->getDebugLoc() : DebugLoc();
+  const auto &TII =
+      *MF.getSubtarget<EclipseSubtarget>().getInstrInfo();
+
+  // RTN (the terminator this inserts before — see EclipseInstrInfo.td's
+  // RET definition, which now prints "RTN") unconditionally restores
+  // AC0/AC1 from whatever SAVE pushed at function entry: the *caller's*
+  // pre-call values, not this function's return value. Overwrite those
+  // two saved stack slots with the real return value — already computed
+  // into AC0/AC1 by this point via ordinary LowerReturn-generated code,
+  // unchanged — immediately before RTN runs, so what RTN pops back out
+  // *is* the return value. Slots are FP-4 (AC0) and FP-3 (AC1), matching
+  // SAVE's own push order (see its .td comment); AC2 already holds the
+  // frame pointer here (the prologue's MOV), so STFI's implicit ",2"
+  // base is exactly right. Harmless to do unconditionally even for a
+  // void function or one returning via a hidden sret pointer — nothing
+  // reads AC0/AC1 after such a call anyway.
+  BuildMI(MBB, MBBI, DL, TII.get(Eclipse::STFI)).addReg(Eclipse::AC0).addImm(-4);
+  BuildMI(MBB, MBBI, DL, TII.get(Eclipse::STFI)).addReg(Eclipse::AC1).addImm(-3);
+  // No explicit local-space deallocation loop needed here, unlike the
+  // old per-word ISZABS epilogue: RTN resets the hardware stack pointer
+  // straight from the frame pointer (hardware location 041), discarding
+  // the whole frame — locals, temps, anything else — in one step, as
+  // part of the very same instruction that also restores AC0-AC3 and
+  // returns.
+}
+
+MachineBasicBlock::iterator EclipseFrameLowering::eliminateCallFramePseudoInstr(
+    MachineFunction &MF, MachineBasicBlock &MBB,
+    MachineBasicBlock::iterator MI) const {
+  // ADJCALLSTACKDOWN/UP are always expanded earlier, during isel, by their
+  // hasCustomInserter handler (EclipseISelLowering.cpp) — nothing should
+  // reach PEI still holding one of these pseudos.
+  return MBB.erase(MI);
+}
+
+void EclipseFrameLowering::processFunctionBeforeFrameFinalized(
+    MachineFunction &MF, RegScavenger *RS) const {
+  MachineFrameInfo &MFI = MF.getFrameInfo();
+
+  // EclipseRegisterInfo::requiresRegisterScavenging/
+  // requiresFrameIndexScavenging both unconditionally return true (see
+  // their comment) — LEAFI's post-regalloc expansion (eliminateFrameIndex)
+  // needs a genuine scratch physical register it can't just conjure, so
+  // PEI always builds a RegScavenger for this target. But a scavenger can
+  // only *use* a register that's already live by spilling its current
+  // occupant somewhere first, and it has no stack slot to spill into
+  // unless one is explicitly reserved and registered here — without this,
+  // any function with enough register pressure to actually need a
+  // mid-function scavenge (a local array plus a loop plus call-heavy code
+  // was enough to trigger it) crashed with "Cannot scavenge register
+  // without an emergency spill slot!" during PEI.
+  //
+  // Originally reserved just one word-sized slot ("nothing on this target
+  // ever needs to scavenge more than one register at a time") — no longer
+  // true since EclipseRegisterInfo::eliminateFrameIndex's out-of-range
+  // LDFI/STFI fallback (large stack-frame offsets that don't fit real
+  // hardware's 8-bit indexed-addressing displacement) can need *two*
+  // scratch registers live at once (a running address total plus the bit
+  // it's currently folding in) out of only two allocatable GPRs
+  // (AC0/AC1) total. Confirmed empirically: a large enough frame (58
+  // separately out-of-range locals, c-testsuite 00128/00200) drove the
+  // backward scavenger into needing both AC0 and AC1 spilled
+  // simultaneously at some point deep in a block, which one slot can't
+  // represent — "Error while trying to spill AC0 ... Cannot scavenge
+  // register without an emergency spill slot!" even though a slot *did*
+  // exist, just not a second one. RegScavenger natively supports more
+  // than one scavenging slot (its own `Scavenged` list, queried via
+  // isScavengingFrameIndex/getScavengingFrameIndices) — reserving two
+  // instead of one covers this target's actual worst case (its whole
+  // allocatable register file).
+  int EmergencyFI = MFI.CreateStackObject(2, Align(2), /*isSpillSlot=*/true);
+  RS->addScavengingFrameIndex(EmergencyFI);
+  int EmergencyFI2 = MFI.CreateStackObject(2, Align(2), /*isSpillSlot=*/true);
+  RS->addScavengingFrameIndex(EmergencyFI2);
+
+  int64_t Offset = 0;
+  // Locals, temps, and register-allocator spill slots are all just more
+  // stack objects by this point — assign them cumulative negative
+  // FP-relative displacements exactly like the sibling `eccc` project's
+  // frame.rs does for its own temps/locals. Parameters are separate,
+  // *fixed* objects created with their final FP+2.. offset already baked
+  // in at LowerFormalArguments time (see EclipseISelLowering.cpp) and are
+  // skipped here.
+  for (int i = 0, e = MFI.getObjectIndexEnd(); i != e; ++i) {
+    if (MFI.isDeadObjectIndex(i) || MFI.isFixedObjectIndex(i))
+      continue;
+    // MachineFrameInfo object sizes are in real (8-bit) DataLayout bytes;
+    // every Eclipse word is 2 of those (EclipseTargetMachine's DataLayout
+    // is a standard 16-bit-pointer layout, not a "1 byte = 1 word" one —
+    // only the offsets *this backend itself* assigns, here and in
+    // LowerFormalArguments, are word-granular).
+    //
+    // NOTE: as of investigating a local-char-array miscompilation, this
+    // loop's offsets turned out to be moot in practice: PEI's own generic
+    // PEIImpl::calculateFrameObjectOffsets (llvm/lib/CodeGen/
+    // PrologEpilogInserter.cpp) runs immediately after
+    // processFunctionBeforeFrameFinalized and unconditionally overwrites
+    // every non-fixed, non-scavenging object's offset with its own
+    // byte-granular, alignment-respecting computation — confirmed by
+    // instrumenting both this loop and eliminateFrameIndex and finding
+    // completely different values for the same frame index. It happens
+    // to still produce non-overlapping (if 2x wasteful) slots for
+    // scalars, which is why nothing here was ever noticed before. Left
+    // as-is (harmless, and correct in spirit) since actually fixing the
+    // real problem means addressing PEI's overwrite directly rather than
+    // this loop — see DEBUGGING_NOTES.md.
+    int64_t Words = (MFI.getObjectSize(i) + 1) / 2;
+    Offset -= Words;
+    MFI.setObjectOffset(i, Offset);
+  }
+  MFI.setStackSize(static_cast<uint64_t>(-Offset));
+}
diff --git a/llvm/lib/Target/Eclipse/EclipseFrameLowering.h b/llvm/lib/Target/Eclipse/EclipseFrameLowering.h
new file mode 100644
index 000000000..1002a0ccd
--- /dev/null
+++ b/llvm/lib/Target/Eclipse/EclipseFrameLowering.h
@@ -0,0 +1,67 @@
+//===-- EclipseFrameLowering.h - Define frame lowering ---------*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM
+// Exceptions. See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// Implements exactly the prologue/epilogue sequence verified (against a
+// real `eclipseemu` simulator) and documented in the sibling `eccc`
+// project's docs/CALLING_CONVENTION.md: push caller's FP (AC2) and the
+// JSR return address (AC3) onto the software stack, adopt the new stack
+// top as FP, reserve locals+temps; epilogue reverses it. Every function
+// uses this same sequence, including leaf functions — eccc documents that
+// as a deliberate v1 simplification (docs/LIMITATIONS.md) and this backend
+// keeps it for the same reason: correctness first, a leaf-function fast
+// path is follow-up work (see README.md).
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_LIB_TARGET_ECLIPSE_ECLIPSEFRAMELOWERING_H
+#define LLVM_LIB_TARGET_ECLIPSE_ECLIPSEFRAMELOWERING_H
+
+#include "llvm/CodeGen/TargetFrameLowering.h"
+
+namespace llvm {
+
+class EclipseSubtarget;
+
+class EclipseFrameLowering : public TargetFrameLowering {
+public:
+  explicit EclipseFrameLowering(const EclipseSubtarget &STI);
+
+  void emitPrologue(MachineFunction &MF, MachineBasicBlock &MBB) const override;
+  void emitEpilogue(MachineFunction &MF, MachineBasicBlock &MBB) const override;
+
+  bool hasFPImpl(const MachineFunction &MF) const override { return true; }
+
+  MachineBasicBlock::iterator
+  eliminateCallFramePseudoInstr(MachineFunction &MF, MachineBasicBlock &MBB,
+                                 MachineBasicBlock::iterator MI) const override;
+
+  void processFunctionBeforeFrameFinalized(
+      MachineFunction &MF, RegScavenger *RS = nullptr) const override;
+
+  // No assignCalleeSavedSpillSlots override: AC2/AC3 never appear in
+  // getCalleeSavedRegs (EclipseRegisterInfo.cpp) regardless of function
+  // kind, so they're already never subject to the generic CSR mechanism —
+  // saved/restored explicitly by emitPrologue/emitEpilogue instead. An
+  // earlier version of this class *did* override this to unconditionally
+  // `return true` (meaning "already handled, PEI shouldn't do anything
+  // more"), which was harmless back when the callee-saved list was always
+  // empty, but became a real bug once __attribute__((interrupt)) started
+  // making it non-empty for AC0/AC1: `return true` with no real per-entry
+  // frame-index assignment left every CalleeSavedInfo's frame index at its
+  // default, causing every CSR save/restore to collide onto the same stack
+  // slot as whatever unrelated object happened to already have that
+  // default index — verified against a real generated interrupt handler,
+  // where AC0's and AC1's CSR saves silently clobbered each other and a
+  // register-allocator temp, all sharing one slot. Falling through to the
+  // base class's default implementation makes PEI create one real,
+  // distinct stack object per saved register instead.
+};
+
+} // namespace llvm
+
+#endif // LLVM_LIB_TARGET_ECLIPSE_ECLIPSEFRAMELOWERING_H
diff --git a/llvm/lib/Target/Eclipse/EclipseISelDAGToDAG.cpp b/llvm/lib/Target/Eclipse/EclipseISelDAGToDAG.cpp
new file mode 100644
index 000000000..a4880e3ab
--- /dev/null
+++ b/llvm/lib/Target/Eclipse/EclipseISelDAGToDAG.cpp
@@ -0,0 +1,106 @@
+//===-- EclipseISelDAGToDAG.cpp - A dag to dag inst selector -------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM
+// Exceptions. See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// Most Eclipse addressing shapes are expressed as plain TableGen
+// instruction Patterns in EclipseInstrInfo.td (wrapped global/
+// constant-pool addresses -> LDABS/STABS, any other register-valued
+// pointer -> the general LDIND/STIND indirection). Frame-index addressing
+// (LDFI/STFI/LEAFI) is the one exception, handled here by hand instead —
+// like other backends that have to do this: a plain `Operand<i16>` isn't
+// specifically typed to bind a FrameIndex SDNode value, so table-driven
+// matching doesn't reliably select it.
+//
+//===----------------------------------------------------------------------===//
+
+#include "Eclipse.h"
+#include "EclipseTargetMachine.h"
+#include "llvm/CodeGen/SelectionDAGISel.h"
+#include "llvm/CodeGen/SelectionDAGNodes.h"
+
+using namespace llvm;
+
+#define DEBUG_TYPE "eclipse-isel"
+#define PASS_NAME "Eclipse DAG->DAG Pattern Instruction Selection"
+
+namespace {
+
+class EclipseDAGToDAGISel : public SelectionDAGISel {
+public:
+  EclipseDAGToDAGISel() = delete;
+  explicit EclipseDAGToDAGISel(EclipseTargetMachine &TM)
+      : SelectionDAGISel(TM) {}
+
+private:
+#include "EclipseGenDAGISel.inc"
+
+  void Select(SDNode *N) override;
+};
+
+class EclipseDAGToDAGISelLegacy : public SelectionDAGISelLegacy {
+public:
+  static char ID;
+  explicit EclipseDAGToDAGISelLegacy(EclipseTargetMachine &TM)
+      : SelectionDAGISelLegacy(ID, std::make_unique<EclipseDAGToDAGISel>(TM)) {
+  }
+};
+
+} // namespace
+
+char EclipseDAGToDAGISelLegacy::ID = 0;
+
+INITIALIZE_PASS(EclipseDAGToDAGISelLegacy, DEBUG_TYPE, PASS_NAME, false, false)
+
+void EclipseDAGToDAGISel::Select(SDNode *Node) {
+  if (Node->isMachineOpcode()) {
+    Node->setNodeId(-1);
+    return;
+  }
+
+  switch (Node->getOpcode()) {
+  case ISD::FrameIndex: {
+    int FI = cast<FrameIndexSDNode>(Node)->getIndex();
+    SDValue TFI = CurDAG->getTargetFrameIndex(FI, MVT::i16);
+    CurDAG->SelectNodeTo(Node, Eclipse::LEAFI, MVT::i16, TFI);
+    return;
+  }
+  case ISD::LOAD: {
+    auto *LD = cast<LoadSDNode>(Node);
+    if (auto *FIN = dyn_cast<FrameIndexSDNode>(LD->getBasePtr())) {
+      SDValue TFI = CurDAG->getTargetFrameIndex(FIN->getIndex(), MVT::i16);
+      SDValue Ops[] = {TFI, LD->getChain()};
+      SDNode *MN =
+          CurDAG->SelectNodeTo(Node, Eclipse::LDFI, MVT::i16, MVT::Other, Ops);
+      CurDAG->setNodeMemRefs(cast<MachineSDNode>(MN), {LD->getMemOperand()});
+      return;
+    }
+    break;
+  }
+  case ISD::STORE: {
+    auto *ST = cast<StoreSDNode>(Node);
+    if (auto *FIN = dyn_cast<FrameIndexSDNode>(ST->getBasePtr())) {
+      SDValue TFI = CurDAG->getTargetFrameIndex(FIN->getIndex(), MVT::i16);
+      SDValue Ops[] = {ST->getValue(), TFI, ST->getChain()};
+      SDNode *MN = CurDAG->SelectNodeTo(Node, Eclipse::STFI, MVT::Other, Ops);
+      CurDAG->setNodeMemRefs(cast<MachineSDNode>(MN), {ST->getMemOperand()});
+      return;
+    }
+    break;
+  }
+  default:
+    break;
+  }
+
+  SelectCode(Node);
+}
+
+EclipseISelDAGToDAGPass::EclipseISelDAGToDAGPass(EclipseTargetMachine &TM)
+    : SelectionDAGISelPass(std::make_unique<EclipseDAGToDAGISel>(TM)) {}
+
+FunctionPass *llvm::createEclipseISelDagLegacyPass(EclipseTargetMachine &TM) {
+  return new EclipseDAGToDAGISelLegacy(TM);
+}
diff --git a/llvm/lib/Target/Eclipse/EclipseISelLowering.cpp b/llvm/lib/Target/Eclipse/EclipseISelLowering.cpp
new file mode 100644
index 000000000..c9a0c4406
--- /dev/null
+++ b/llvm/lib/Target/Eclipse/EclipseISelLowering.cpp
@@ -0,0 +1,1942 @@
+//===-- EclipseISelLowering.cpp - Eclipse DAG Lowering Implementation ---===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM
+// Exceptions. See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "EclipseISelLowering.h"
+#include "EclipseMachineFunctionInfo.h"
+#include "EclipseSubtarget.h"
+#include "MCTargetDesc/EclipseMCTargetDesc.h"
+#include "llvm/CodeGen/CallingConvLower.h"
+#include "llvm/CodeGen/MachineFrameInfo.h"
+#include "llvm/CodeGen/MachineFunction.h"
+#include "llvm/CodeGen/MachineInstrBuilder.h"
+#include "llvm/CodeGen/MachineRegisterInfo.h"
+#include "llvm/CodeGen/SelectionDAG.h"
+#include "llvm/IR/Constants.h"
+#include "llvm/IR/DiagnosticInfo.h"
+#include "llvm/IR/Function.h"
+#include "llvm/IR/GlobalVariable.h"
+
+using namespace llvm;
+
+#define DEBUG_TYPE "eclipse-isel-lowering"
+
+// Every Eclipse word is 16 bits: one InputArg/OutputArg (after the common
+// SelectionDAG type legalizer has already split anything wider — e.g. an
+// i32 parameter arrives here as two separate i16 entries) occupies exactly
+// one stack word. See docs/CALLING_CONVENTION.md in the sibling `eccc`
+// project.
+static constexpr int64_t kWordBytes = 2;
+
+EclipseTargetLowering::EclipseTargetLowering(const TargetMachine &TM,
+                                              const EclipseSubtarget &STI)
+    : TargetLowering(TM, STI) {
+  addRegisterClass(MVT::i16, &Eclipse::GPRRegClass);
+  computeRegisterProperties(STI.getRegisterInfo());
+
+  // `char` is real i8 IR (Clang doesn't allow customizing CHAR_BIT — see
+  // clang/lib/Basic/Targets/Eclipse.h), even though no i8 register class
+  // exists here: i8 values live in a full i16 register/word, matching
+  // eccc's own "char is stored one per 16-bit word" convention at the
+  // storage-layout level. Note this only covers *scalar* char (locals,
+  // parameters, single-value pointers): char *arrays* and structs mixing
+  // char with other types would need genuine byte-addressed packing,
+  // which — like eccc — this backend doesn't implement (no LDB/STB
+  // byte-pointer instructions; see README.md "Known limitations").
+  //
+  // Loads/stores: since every real memory access here is a full 16-bit
+  // word regardless of the IR's notional 8-bit type, an i8-extending
+  // load or truncating store is *exactly* the same physical instruction
+  // as a plain i16 one — LDFI/STFI (custom-selected in
+  // EclipseISelDAGToDAG.cpp, which is already extension-agnostic) and
+  // LDABS/STABS/LDIND/STIND (declarative patterns added below).
+  for (MVT VT : {MVT::i1, MVT::i8}) {
+    setLoadExtAction(ISD::EXTLOAD, MVT::i16, VT, Legal);
+    setLoadExtAction(ISD::SEXTLOAD, MVT::i16, VT, Legal);
+    setLoadExtAction(ISD::ZEXTLOAD, MVT::i16, VT, Legal);
+    setTruncStoreAction(MVT::i16, VT, Legal);
+  }
+  setOperationAction(ISD::SIGN_EXTEND_INREG, MVT::i8, Custom);
+  setOperationAction(ISD::SIGN_EXTEND_INREG, MVT::i1, Expand);
+
+  setOperationAction(ISD::SHL, MVT::i16, Custom);
+  setOperationAction(ISD::SRL, MVT::i16, Custom);
+  setOperationAction(ISD::SRA, MVT::i16, Custom);
+
+  // See LowerSDIVREM: the hardware DIV instruction is only ever driven
+  // unsigned (via UDIVREMrr, below); signed division is decomposed here.
+  setOperationAction(ISD::SDIV, MVT::i16, Custom);
+  setOperationAction(ISD::SREM, MVT::i16, Custom);
+
+  // udiv/urem are deliberately Expand, not the default Legal: the real
+  // hardware DIV instruction always produces *both* quotient (AC1) and
+  // remainder (AC0) from a single execution, regardless of which one the
+  // IR asked for. Leaving udiv/urem individually Legal (matched straight
+  // to separate UDIVrr/UREMrr pseudos, as an earlier version of this
+  // backend did) meant each one's post-RA expansion ran that same full
+  // sequence and unconditionally destroyed AC0 *and* AC1 with no way to
+  // declare that to the register allocator (UDIVrr/UREMrr can only
+  // declare AC2 as clobbered -- see EclipseInstrInfo.td's MUL/DIV
+  // comment for why declaring AC0/AC1 too breaks allocation outright).
+  // Two separate calls computing div and rem of the *same* operands,
+  // needed live at the same time (e.g. both passed to one printf), would
+  // then silently corrupt whichever one's result was still sitting in
+  // AC0/AC1 when the other one ran -- a real, confirmed bug (see
+  // DEBUGGING_NOTES.md).
+  //
+  // Marking these Expand instead routes every udiv/urem -- standalone or
+  // paired -- through ISD::UDIVREM (Custom below, LowerUDIVREM) and a
+  // single combined UDIVREMrr pseudo that declares *both* real outputs.
+  // This costs nothing extra even for a standalone udiv/urem (it's the
+  // same one hardware DIV either way), and permanently removes the
+  // hidden clobber: TargetLowering::ExpandNode/expandREM convert a lone
+  // udiv/urem to UDIVREM once legality says to (LegalizeDAG.cpp), and
+  // DAGCombiner's useDivRem() additionally takes the earlier, better
+  // opportunity to fuse an explicit matching udiv+urem pair into one
+  // UDIVREM node before legalization ever runs -- either way, ordinary
+  // SelectionDAG CSE (same opcode/operands/VTList) guarantees a genuine
+  // matching pair collapses onto the very same UDIVREM node no matter
+  // which order the two get legalized in.
+  setOperationAction(ISD::UDIV, MVT::i16, Expand);
+  setOperationAction(ISD::UREM, MVT::i16, Expand);
+  setOperationAction(ISD::UDIVREM, MVT::i16, Custom);
+
+  setBooleanContents(ZeroOrOneBooleanContent);
+  setStackPointerRegisterToSaveRestore(Register());
+  setMinFunctionAlignment(Align(1));
+
+  setOperationAction(ISD::GlobalAddress, MVT::i16, Custom);
+  setOperationAction(ISD::ExternalSymbol, MVT::i16, Custom);
+  setOperationAction(ISD::ConstantPool, MVT::i16, Custom);
+
+  // Dense/large `switch` statements (Duff's device is the textbook case)
+  // can make SelectionDAGBuilder lower a switch as a jump table
+  // (ISD::BR_JT) instead of a compare chain -- this backend has no
+  // pattern for that opcode at all (only ordinary conditional branches),
+  // which crashed ISel outright ("Cannot select: ... br_jt ...").
+  // Disabled the same way AVR/MSP430 (other small, address-space-
+  // constrained backends) do it: BR_JT -> Expand (so a target that ever
+  // did reach here with one legalizes it back down to a branch instead
+  // of erroring), plus setMinimumJumpTableEntries(UINT_MAX) as the real
+  // belt-and-suspenders fix -- that's what actually stops
+  // SelectionDAGBuilder's areJTsAllowed()/density heuristic from
+  // choosing a jump table in the first place, since BR_JT's default
+  // legality alone wasn't what triggered the crash to begin with.
+  setOperationAction(ISD::BR_JT, MVT::Other, Expand);
+  setMinimumJumpTableEntries(UINT_MAX);
+
+  setOperationAction(ISD::BR_CC, MVT::i16, Custom);
+  // Was `Expand` — relying on the generic legalizer to always eliminate
+  // BRCOND before instruction selection. That held for code shaped by
+  // this backend's own lowering, but broke once soft-float's more
+  // elaborate C (nested if/else-if/else over 32-bit comparisons, e.g.
+  // eclipse_rt.c's sf_add) gave the DAG combiner enough shape to
+  // rebuild a "Select feeding a brcond" pattern *after* the main
+  // BRCOND-Expand legalization pass had already run — confirmed
+  // empirically ("Cannot select: ... brcond ... Select ..."), not a
+  // theoretical concern. `Custom` (via LowerBRCOND, which just
+  // reduces it to the existing, already-robust BR_CC path: "branch if
+  // Cond != 0") gets re-invoked for *any* brcond node regardless of
+  // when it's introduced, since Custom-lowered results are always
+  // re-legalized — unlike Expand, which is a one-shot legalization-time
+  // rule with no such guarantee against post-legalize combines.
+  setOperationAction(ISD::BRCOND, MVT::i16, Custom);
+  setOperationAction(ISD::SETCC, MVT::i16, Custom);
+  setOperationAction(ISD::SELECT, MVT::i16, Expand);
+  setOperationAction(ISD::SELECT_CC, MVT::i16, Custom);
+
+  // No hardware rotate, funnel shift, or widening-multiply result.
+  setOperationAction(ISD::ROTL, MVT::i16, Expand);
+  setOperationAction(ISD::ROTR, MVT::i16, Expand);
+  setOperationAction(ISD::MULHS, MVT::i16, Expand);
+  setOperationAction(ISD::MULHU, MVT::i16, Expand);
+  setOperationAction(ISD::SMUL_LOHI, MVT::i16, Expand);
+  setOperationAction(ISD::UMUL_LOHI, MVT::i16, Expand);
+
+  // The base Nova/Eclipse ISA has no immediate-operand instructions at all
+  // (see EclipseInstrInfo.td) — every constant is really the address of a
+  // page-zero data word, so a bare ISD::Constant needs to become a
+  // constant-pool load rather than staying a plain immediate.
+  setOperationAction(ISD::Constant, MVT::i16, Custom);
+
+  // Variadic calls: arguments are pushed right-to-left on the flat
+  // software stack (LowerCall's comment) with no register-based argument
+  // passing to complicate things, so va_start just needs to point past
+  // the last named parameter (LowerFormalArguments/LowerVASTART) — no
+  // register-save area to build, unlike e.g. x86-64's varargs ABI.
+  // ISD::VAARG itself needs no Custom handling: SelectionDAG's generic
+  // expansion (load the va_list pointer, load the value, store the
+  // pointer back incremented by the type's size) works unmodified here
+  // since va_list is a plain i16 pointer into this flat address space.
+  setOperationAction(ISD::VASTART, MVT::Other, Custom);
+  // Not Expand: the generic VAARG expansion inserts pointer-alignment
+  // rounding ("(ap+1) & ~1") for a real byte-addressed machine where a
+  // 2-byte-aligned type might start at an odd address. There's no such
+  // thing here — every address already refers to a whole word, so that
+  // rounding is not just unneeded but actively wrong (it can silently
+  // round the va_list pointer down to the *previous* word depending on
+  // the runtime address's parity). Custom-lowered instead with plain,
+  // unconditional word-stepping — see LowerVAARG.
+  setOperationAction(ISD::VAARG, MVT::Other, Custom);
+  // va_end is a no-op on this stack-based ABI (no resources to release).
+  setOperationAction(ISD::VAEND, MVT::Other, Expand);
+
+  // Variable-length arrays: reserves a runtime-computed word count on
+  // the same hardware stack pointer SAVE/RTN and the argument push/pop
+  // machinery already share -- see LowerDYNAMIC_STACKALLOC and
+  // emitVLAAlloc for the full mechanism.
+  setOperationAction(ISD::DYNAMIC_STACKALLOC, MVT::i16, Custom);
+  // clang emits these unconditionally around any lexical block
+  // containing a VLA -- see STACKSAVE_PSEUDO/STACKRESTORE_PSEUDO's own
+  // comment in EclipseInstrInfo.td.
+  setOperationAction(ISD::STACKSAVE, MVT::Other, Custom);
+  setOperationAction(ISD::STACKRESTORE, MVT::Other, Custom);
+
+  // See PerformDAGCombine: a runtime array index into an indirectly-
+  // addressed ("large") global gets added, as a plain ADD, to the
+  // WRAPPER'd base pointer LEAGA materializes — and that ADD's other
+  // operand needs a word/byte-unit fixup this backend can't express any
+  // other way.
+  setTargetDAGCombine(ISD::ADD);
+  // See PerformDAGCombine: DAGCombiner's own generic "fold a branch
+  // whose condition is a compile-time constant" simplification (a
+  // "while (1)" loop, for instance, or any comparison it can prove
+  // always-true/-false) produces a plain ISD::BRCOND node holding
+  // that constant directly as its condition -- *after* the
+  // legalization pass where this target's BRCOND Custom-lowering
+  // (LowerBRCOND, above) normally runs, so it never gets a chance to
+  // run on this particular node. A real, confirmed-the-hard-way bug
+  // (found via the public c-testsuite, not this project's own
+  // examples): every constant this target materializes, even 0/1, is
+  // routed through a constant-pool WRAPPER rather than a raw
+  // ConstantSDNode (see the ADD combine's own comment above on why),
+  // and DAGCombiner's generic fold does not recognize that shape as
+  // "a constant" the way it would a plain ConstantSDNode on almost
+  // every other target -- so the fold only gets half done: the
+  // condition is simplified down to a bare constant, but the BRCOND
+  // itself is never simplified further into an unconditional branch
+  // (or removed entirely), leaving a shape this target's ISel has no
+  // pattern for ("Cannot select: ... brcond ...").
+  setTargetDAGCombine(ISD::BRCOND);
+
+  // f32 has no register class here (see this file's header — no
+  // addRegisterClass(MVT::f32, ...) above), so LLVM's type legalizer
+  // automatically "softens" every float op into an integer-typed libcall.
+  // On most in-tree targets that's all that's needed — the libcall *name*
+  // for each RTLIB::Libcall (e.g. RTLIB::ADD_F32) defaults to the usual
+  // compiler-rt symbol, resolved through a big per-architecture table
+  // (RuntimeLibcalls.inc's setTargetRuntimeLibcallSets) keyed off the
+  // Triple. "eclipse" isn't a recognized architecture in that generated
+  // table, so every RTLIB::LibcallImpl defaults to RTLIB::Unsupported for
+  // this target, and TargetLowering::makeLibCall hard-crashes
+  // ("unsupported library call operation") the first time softening
+  // needs one — confirmed empirically (this is exactly what happened
+  // before these lines were added). Fixed by explicitly wiring each
+  // RTLIB::Libcall this target's soft-float runtime (eclipse_rt.c)
+  // actually implements to its RTLIB::LibcallImpl (the compiler-rt-style
+  // symbol name) directly, bypassing the architecture table entirely.
+  //
+  // Only f32 (`float`) is wired up — `double` stays unimplemented (see
+  // eclipse_rt.c's soft-float section and the README's "no i32 runtime
+  // library" limitation: f64 softening would need genuine i64 support
+  // this backend doesn't have).
+  //
+  // ADD_F32/SUB_F32 alone are conditioned on STI.useHardwareFloat()
+  // (EclipseSubtarget.h): true by default (DEBUGGING_NOTES.md entry
+  // #30) or with `+hwfloat` set regardless — see Eclipse.td's
+  // FeatureIEEEFloat/FeatureHWFloat. When true, real Eclipse S/140
+  // hardware FPU instructions (FAS/FSS, run through a hand-written
+  // assembly wrapper matching this target's ordinary calling convention
+  // — see rt/eclipse_hwfloat.s in the eclipse-package repo) replace the
+  // software __addsf3/__subsf3 this target otherwise uses. Every other
+  // float libcall below stays on its software implementation
+  // unconditionally either way — FMS/FDS (hardware multiply/divide)
+  // were re-probed fresh at entry #30 and reconfirmed genuinely broken
+  // on eclipseemu (both operand orderings, several operand-register
+  // combinations, always silently zero the destination instead of
+  // computing a product/quotient). FLAS/FFAS (hardware int<->float
+  // conversion), by contrast, turned out reliable once probed with the
+  // right operand-order hypothesis — entry #27's original "inconsistent"
+  // verdict was a probing mistake, not a real limitation — but are left
+  // unused regardless: they only convert a single 16-bit AC, not this
+  // target's 32-bit `long` (SINTTOFP_I32_F32/FPTOSINT_F32_I32). See
+  // DEBUGGING_NOTES.md entry #30 for the full re-probe methodology and
+  // results, and entry #27 for FAS/FSS's own original verification.
+  // This exact ADD_F32/SUB_F32 choice is duplicated in
+  // EclipseSubtarget::initLibcallLoweringInfo — see that method's own
+  // comment for why both copies are needed.
+  bool UseHW = STI.useHardwareFloat();
+  setLibcallImpl(RTLIB::ADD_F32,
+                 UseHW ? RTLIB::impl___addsf3_hw : RTLIB::impl___addsf3);
+  setLibcallImpl(RTLIB::SUB_F32,
+                 UseHW ? RTLIB::impl___subsf3_hw : RTLIB::impl___subsf3);
+  setLibcallImpl(RTLIB::MUL_F32, RTLIB::impl___mulsf3);
+  setLibcallImpl(RTLIB::DIV_F32, RTLIB::impl___divsf3);
+  // NOTE: these are the *three-way* (-1/0/1) compare libcalls -- the
+  // FCMP3_PRED_* family, not the plain OEQ_F32/UNE_F32/... boolean
+  // family. eclipse_rt.c's __eqsf2/__nesf2/__ltsf2/__lesf2/__gtsf2/__gesf2
+  // are all thin aliases of a single sf_cmp() returning -1/0/1 (the
+  // libgcc/compiler-rt tri-state convention), tested by the generic
+  // softenSetCCOperands against 0 with a per-predicate CondCode (e.g.
+  // SETEQ for OEQ, SETGT for OGT). Registering them under the boolean
+  // family instead makes softenSetCCOperands test the tri-state result
+  // with SETNE for every predicate (nonzero-means-true), which only
+  // happens to agree with the tri-state convention for UNE (and for the
+  // single true case of OGT/OLT where the result is +1/-1) -- every
+  // other predicate silently gets the wrong condition code.
+  setLibcallImpl(RTLIB::FCMP3_PRED_OEQ_F32, RTLIB::impl___eqsf2);
+  setLibcallImpl(RTLIB::FCMP3_PRED_UNE_F32, RTLIB::impl___nesf2);
+  setLibcallImpl(RTLIB::FCMP3_PRED_OLT_F32, RTLIB::impl___ltsf2);
+  setLibcallImpl(RTLIB::FCMP3_PRED_OLE_F32, RTLIB::impl___lesf2);
+  setLibcallImpl(RTLIB::FCMP3_PRED_OGT_F32, RTLIB::impl___gtsf2);
+  setLibcallImpl(RTLIB::FCMP3_PRED_OGE_F32, RTLIB::impl___gesf2);
+  // Ordered-comparison softening pairs each predicate with this — see
+  // eclipse_rt.c's __unordsf2 comment.
+  setLibcallImpl(RTLIB::UO_F32, RTLIB::impl___unordsf2);
+  setLibcallImpl(RTLIB::SINTTOFP_I32_F32, RTLIB::impl___floatsisf);
+  setLibcallImpl(RTLIB::UINTTOFP_I32_F32, RTLIB::impl___floatunsisf);
+  setLibcallImpl(RTLIB::FPTOSINT_F32_I32, RTLIB::impl___fixsfsi);
+  setLibcallImpl(RTLIB::FPTOUINT_F32_I32, RTLIB::impl___fixunssfsi);
+
+  // Same "Unsupported means empty symbol name, not a graceful error"
+  // trap as the float libcalls above, hit via a completely different
+  // path: a local aggregate with a full constant initializer (e.g.
+  // `int Array[10] = {...};`) gets lowered by SelectionDAGBuilder as an
+  // llvm.memcpy intrinsic from a synthesized constant global into the
+  // stack slot, rather than a store per element, once it's larger than
+  // the generic legalizer's inline-expansion threshold. SelectionDAG::
+  // getMemcpy() then falls back to an actual call to the RTLIB::MEMCPY
+  // libcall -- which, like every other libcall on this target, defaults
+  // to RTLIB::Unsupported until wired up here. Unlike the float
+  // libcalls (which fail loudly: "unsupported library call operation"),
+  // this one fails silently and crashes much later: the resulting
+  // ExternalSymbolSDNode carries an *empty* symbol name rather than
+  // null, so LowerCall's dyn_cast<ExternalSymbolSDNode> succeeds and
+  // no report_fatal_error ever fires -- it instead SEGFAULTs with no
+  // diagnostic at all once codegen tries to actually use that empty
+  // name. Confirmed via direct instrumentation of LowerCall (temporary
+  // errs() prints of Callee's opcode/symbol before the crash): the
+  // ExternalSymbol was reached and printed as an empty string just
+  // before the SIGSEGV. eclipse_rt.c already implements memcpy/memmove/
+  // memset/memcmp directly (see string.h) -- wiring the four of them up
+  // the same way the float ops are here fixes it, and lets the
+  // generated call resolve to this target's own real implementations
+  // exactly like any other direct-symbol call.
+  setLibcallImpl(RTLIB::MEMCPY, RTLIB::impl_memcpy);
+  setLibcallImpl(RTLIB::MEMMOVE, RTLIB::impl_memmove);
+  setLibcallImpl(RTLIB::MEMSET, RTLIB::impl_memset);
+  setLibcallImpl(RTLIB::MEMCMP, RTLIB::impl_memcmp);
+
+  // Same "no register class for this width, so the type legalizer
+  // silently expands to an RTLIB::Libcall that then hard-crashes
+  // because nothing's wired up" trap as the float ops above, hit via a
+  // completely different IR pattern: a 32-bit (`long`/`unsigned long`)
+  // `/` or `%`. Only MVT::i16 SDIV/SREM get Custom lowering above (the
+  // native hardware DIV instruction, driven through UDIVrr/UREMrr, is
+  // 16-bit only -- see LowerSDIVREM); MVT::i32 has no register class at
+  // all, so the type legalizer's default int-widening path
+  // (DAGTypeLegalizer::ExpandIntRes_UDIV/SDIV/UREM/SREM) falls straight
+  // through to RTLIB::UDIV_I32/SDIV_I32/UREM_I32/SREM_I32 -- which,
+  // like every other libcall on this target, defaulted to
+  // RTLIB::Unsupported until wired up here. Confirmed empirically: any
+  // program dividing a `long` (e.g. c-testsuite's 00182.c, which
+  // extracts decimal digits from an `unsigned long` via repeated `/10`
+  // and `%10`) crashed llc outright ("LLVM ERROR: unsupported library
+  // call operation") in ExpandIntRes_UDIV -> makeLibCall. eclipse_rt.c
+  // now implements genuine 32-bit long division (__udivsi3/__umodsi3
+  // directly, a restoring shift-subtract bit loop; __divsi3/__modsi3
+  // derived from it with abs-value + conditional-negate sign handling,
+  // the same convention LowerSDIVREM uses for the 16-bit case) -- wiring
+  // the four of them up the same way MEMCPY/the float ops are above
+  // fixes it.
+  setLibcallImpl(RTLIB::UDIV_I32, RTLIB::impl___udivsi3);
+  setLibcallImpl(RTLIB::SDIV_I32, RTLIB::impl___divsi3);
+  setLibcallImpl(RTLIB::UREM_I32, RTLIB::impl___umodsi3);
+  setLibcallImpl(RTLIB::SREM_I32, RTLIB::impl___modsi3);
+}
+
+std::pair<unsigned, const TargetRegisterClass *>
+EclipseTargetLowering::getRegForInlineAsmConstraint(
+    const TargetRegisterInfo *TRI, StringRef Constraint, MVT VT) const {
+  if (Constraint.size() == 1) {
+    switch (Constraint[0]) {
+    case 'r':
+      return std::make_pair(0U, &Eclipse::GPRRegClass);
+    default:
+      break;
+    }
+  }
+  return TargetLowering::getRegForInlineAsmConstraint(TRI, Constraint, VT);
+}
+
+const char *EclipseTargetLowering::getTargetNodeName(unsigned Opcode) const {
+  switch (static_cast<EclipseISD::NodeType>(Opcode)) {
+  case EclipseISD::WRAPPER:
+    return "EclipseISD::WRAPPER";
+  case EclipseISD::WORD_ADD:
+    return "EclipseISD::WORD_ADD";
+  case EclipseISD::HALVE:
+    return "EclipseISD::HALVE";
+  case EclipseISD::CALL:
+    return "EclipseISD::CALL";
+  case EclipseISD::CALL_INDIRECT:
+    return "EclipseISD::CALL_INDIRECT";
+  case EclipseISD::RET_FLAG:
+    return "EclipseISD::RET_FLAG";
+  case EclipseISD::RETI_FLAG:
+    return "EclipseISD::RETI_FLAG";
+  case EclipseISD::BRZ:
+    return "EclipseISD::BRZ";
+  case EclipseISD::BRNZ:
+    return "EclipseISD::BRNZ";
+  case EclipseISD::BGEZ:
+    return "EclipseISD::BGEZ";
+  case EclipseISD::BLTZ:
+    return "EclipseISD::BLTZ";
+  case EclipseISD::BGEU:
+    return "EclipseISD::BGEU";
+  case EclipseISD::BLTU:
+    return "EclipseISD::BLTU";
+  default:
+    return nullptr;
+  }
+}
+
+//===----------------------------------------------------------------------===//
+// LowerOperation
+//===----------------------------------------------------------------------===//
+
+SDValue EclipseTargetLowering::LowerOperation(SDValue Op,
+                                               SelectionDAG &DAG) const {
+  switch (Op.getOpcode()) {
+  case ISD::GlobalAddress:
+    return LowerGlobalAddress(Op, DAG);
+  case ISD::ExternalSymbol:
+    return LowerExternalSymbol(Op, DAG);
+  case ISD::ConstantPool:
+    return LowerConstantPool(Op, DAG);
+  case ISD::Constant: {
+    // Route through the constant pool: see the ISD::Constant comment in
+    // the constructor above.
+    SDLoc dl(Op);
+    auto *C = cast<ConstantSDNode>(Op);
+    SDValue CP = DAG.getConstantPool(
+        ConstantInt::get(*DAG.getContext(), C->getAPIntValue()), MVT::i16);
+    return LowerConstantPool(CP, DAG);
+  }
+  case ISD::BR_CC:
+    return LowerBR_CC(Op, DAG);
+  case ISD::BRCOND:
+    return LowerBRCOND(Op, DAG);
+  case ISD::SELECT_CC:
+    return LowerSELECT_CC(Op, DAG);
+  case ISD::SETCC:
+    return LowerSETCC(Op, DAG);
+  case ISD::SIGN_EXTEND_INREG:
+    return LowerSIGN_EXTEND_INREG(Op, DAG);
+  case ISD::SHL:
+  case ISD::SRL:
+  case ISD::SRA:
+    return LowerShift(Op, DAG);
+  case ISD::SDIV:
+  case ISD::SREM:
+    return LowerSDIVREM(Op, DAG);
+  case ISD::UDIVREM:
+    return LowerUDIVREM(Op, DAG);
+  case ISD::VASTART:
+    return LowerVASTART(Op, DAG);
+  case ISD::VAARG:
+    return LowerVAARG(Op, DAG);
+  case ISD::DYNAMIC_STACKALLOC:
+    return LowerDYNAMIC_STACKALLOC(Op, DAG);
+  case ISD::STACKSAVE:
+    return LowerSTACKSAVE(Op, DAG);
+  case ISD::STACKRESTORE:
+    return LowerSTACKRESTORE(Op, DAG);
+  default:
+    report_fatal_error("unimplemented Eclipse LowerOperation for " +
+                        Twine(Op.getOpcode()));
+  }
+}
+
+SDValue EclipseTargetLowering::LowerGlobalAddress(SDValue Op,
+                                                   SelectionDAG &DAG) const {
+  const auto *N = cast<GlobalAddressSDNode>(Op);
+  SDLoc dl(Op);
+  SDValue Addr =
+      DAG.getTargetGlobalAddress(N->getGlobal(), dl, MVT::i16, N->getOffset());
+  return DAG.getNode(EclipseISD::WRAPPER, dl, MVT::i16, Addr);
+}
+
+SDValue EclipseTargetLowering::LowerExternalSymbol(SDValue Op,
+                                                    SelectionDAG &DAG) const {
+  const auto *N = cast<ExternalSymbolSDNode>(Op);
+  SDLoc dl(Op);
+  SDValue Sym = DAG.getTargetExternalSymbol(N->getSymbol(), MVT::i16);
+  return DAG.getNode(EclipseISD::WRAPPER, dl, MVT::i16, Sym);
+}
+
+// A "large" (indirectly-addressed) global's real address lives in a
+// page-zero _PTR word; LEAGA (see EclipseAsmPrinter.cpp's emitInstruction)
+// loads that word verbatim, so the value a WRAPPER node produces is
+// *word*-granular. A compile-time-constant GEP offset into such a global
+// gets folded straight into the GlobalAddressSDNode's own offset field by
+// LowerGlobalAddress above — EclipseAsmPrinter's LEAGA case already knows
+// to divide that by 2 before turning it into a word-address addend.
+//
+// A *runtime* (non-constant) index can't be folded that way: it shows up
+// here as an ordinary ADD combining the WRAPPER'd base pointer with some
+// separately-computed offset SDValue — and that offset was computed by
+// perfectly standard, target-independent GEP lowering, which always
+// scales a runtime array index by the element type's DataLayout size in
+// *bytes* (2, for the only element types this backend's array/pointer
+// access actually supports — i16, and i32 which legalizes into a pair of
+// i16 words). Added directly to a word-granular base pointer, that byte
+// offset lands exactly twice as far as it should (e.g. index 4 resolves
+// to element 8) — the same unit mismatch as the constant-offset case
+// above, just reaching this backend through generic arithmetic instead of
+// through GlobalAddressSDNode's offset field, so it can't be fixed in the
+// same place.
+//
+// This can't be fixed in LDIND's expansion either (EmitInstrWithCustomInserter
+// / emitIndirectMem): a computed address reaching LDIND might just as
+// well have come from an already-word-granular frame-index computation
+// (eliminateFrameIndex already divides object sizes by 2), and LDIND has
+// no way to tell those two origins apart.
+//
+// So: catch it here, at the one point where a WRAPPER'd base and a
+// (necessarily byte-scaled) runtime offset are still visibly distinct
+// operands of the same ADD, and halve the offset before they combine.
+// The rewritten node is built with the distinct EclipseISD::WORD_ADD
+// opcode rather than a plain ISD::ADD specifically so it can never match
+// this same `N->getOpcode() == ISD::ADD` check again when DAGCombiner
+// revisits it — an earlier version returned a plain ADD guarded by an
+// "is the offset already SRL-by-1" heuristic instead, which triggered an
+// infinite DAGCombine loop (llc hung indefinitely) once DAGCombiner's own
+// canonicalization re-shaped the node between visits.
+//
+// The halving itself uses EclipseISD::HALVE, not a plain ISD::SRL/UDIV,
+// for the same reason: a bare `DAG.getNode(ISD::SRL, ...)` here was tried
+// first and produced its own infinite loop, empirically confirmed via
+// `llc -debug-only=dagcombine` — LowerShift Custom-lowers SRL-by-1 into
+// UDIV(x,2) (see below), and DAGCombiner's own standard "udiv by a
+// power-of-two constant -> shift" fold immediately turns that back into
+// SRL-by-1; since SRL is only ever Custom here (never strictly Legal),
+// every generated SRL re-enters LowerShift and the two folds ping-pong
+// forever. HALVE selects straight to UDIVrr (see EclipseInstrInfo.td)
+// and is structurally invisible to both of those generic combine rules.
+// See the ISD::BRCOND setTargetDAGCombine registration (above, in the
+// constructor) for the full story on why this exists: DAGCombiner's own
+// generic constant-condition-branch fold produces a BRCOND whose
+// condition is a WRAPPER'd constant-pool reference, a shape this
+// target's Custom lowering never gets a chance to run on and ISel has
+// no pattern for. Rewritten directly here instead: a nonzero constant
+// condition always branches, so replace with a plain unconditional
+// ISD::BR; a zero constant condition never branches, so replace with
+// just the chain (drop the branch, and the whole node along with it,
+// exactly like an ordinary dead conditional branch would be removed).
+static SDValue combineConstantBrcond(SDNode *N, SelectionDAG &DAG) {
+  SDValue Chain = N->getOperand(0);
+  SDValue Cond = N->getOperand(1);
+  SDValue Dest = N->getOperand(2);
+
+  if (Cond.getOpcode() != EclipseISD::WRAPPER)
+    return SDValue();
+  SDValue Inner = Cond.getOperand(0);
+  if (Inner.getOpcode() != ISD::TargetConstantPool)
+    return SDValue();
+  auto *CP = cast<ConstantPoolSDNode>(Inner);
+  if (CP->isMachineConstantPoolEntry())
+    return SDValue();
+  auto *CI = dyn_cast<ConstantInt>(CP->getConstVal());
+  if (!CI)
+    return SDValue();
+
+  SDLoc dl(N);
+  if (CI->isZero())
+    return Chain;
+  return DAG.getNode(ISD::BR, dl, MVT::Other, Chain, Dest);
+}
+
+SDValue EclipseTargetLowering::PerformDAGCombine(SDNode *N,
+                                                  DAGCombinerInfo &DCI) const {
+  if (N->getOpcode() == ISD::BRCOND) {
+    if (SDValue Folded = combineConstantBrcond(N, DCI.DAG))
+      return Folded;
+    // A second, distinct shape reaching this same post-Legalize gap
+    // (see the setTargetDAGCombine(ISD::BRCOND) registration comment
+    // in the constructor and combineConstantBrcond above for the first
+    // one): DAGCombiner's final combine pass can rebuild a BRCOND
+    // whose condition is directly a Select/SelectU *machine* node --
+    // LowerSELECT_CC's own already-custom-lowered output -- rather
+    // than a WRAPPER'd constant. Custom lowering's "gets re-invoked
+    // for any brcond node" guarantee (see that same comment) only
+    // actually holds for nodes created *during* the Legalize() pass
+    // itself; one materializing here, in the combine pass that runs
+    // strictly after Legalize() has already finished, never gets a
+    // second chance and reaches ISel unconverted -- confirmed
+    // empirically ("Cannot select: ... brcond ... Select ..."),
+    // first hit compiling c-testsuite's 00182.c (a 32-bit `unsigned
+    // long x` digit-extraction loop: `x == 0` materializes a
+    // Select/SelectU, and DAGCombiner folds it straight into the
+    // loop's own brcond). isMachineOpcode() is the shape check here
+    // for the same reason combineConstantBrcond checks for a
+    // WRAPPER(TargetConstantPool) Cond instead of gating on DCI's
+    // legalization-stage flags: a Select/SelectU machine node, like a
+    // WRAPPER'd constant, only ever exists *after* Custom lowering has
+    // already run once, so this can't misfire on an ordinary brcond
+    // fresh from SelectionDAGBuilder. Reduced exactly the way
+    // LowerBRCOND itself reduces any other Cond -- 'branch if Cond !=
+    // 0', handed to the already-robust LowerBR_CC -- since that's
+    // precisely the lowering this node missed out on.
+    SDValue Cond = N->getOperand(1);
+    if (Cond.isMachineOpcode() &&
+        (Cond.getMachineOpcode() == Eclipse::Select ||
+         Cond.getMachineOpcode() == Eclipse::SelectU))
+      return LowerBRCOND(SDValue(N, 0), DCI.DAG);
+    return SDValue();
+  }
+
+  if (N->getOpcode() != ISD::ADD || N->getValueType(0) != MVT::i16)
+    return SDValue();
+
+  SDValue N0 = N->getOperand(0);
+  SDValue N1 = N->getOperand(1);
+
+  auto IsWrappedGlobal = [](SDValue V) {
+    return V.getOpcode() == EclipseISD::WRAPPER &&
+           V.getOperand(0).getOpcode() == ISD::TargetGlobalAddress;
+  };
+  // Constants routed through the constant pool (see the ISD::Constant
+  // comment in the constructor) arrive here as WRAPPER(ConstantPool), not
+  // a raw ConstantSDNode — checked separately below alongside the direct
+  // ConstantSDNode case, since it isn't certain at this combine's point
+  // in the pipeline which form a small constant offset like the
+  // multi-word-global "access word N" case actually takes.
+  auto IsWrappedConstant = [](SDValue V) {
+    return V.getOpcode() == EclipseISD::WRAPPER &&
+           V.getOperand(0).getOpcode() == ISD::TargetConstantPool;
+  };
+
+  SDValue Base, Offset;
+  bool BaseIsFrameIndex = false;
+  if (IsWrappedGlobal(N0)) {
+    Base = N0;
+    Offset = N1;
+  } else if (IsWrappedGlobal(N1)) {
+    Base = N1;
+    Offset = N0;
+  } else if (N0.getOpcode() == ISD::FrameIndex) {
+    Base = N0;
+    Offset = N1;
+    BaseIsFrameIndex = true;
+  } else if (N1.getOpcode() == ISD::FrameIndex) {
+    Base = N1;
+    Offset = N0;
+    BaseIsFrameIndex = true;
+  } else if ((N0.getOpcode() == ISD::LOAD) != (N1.getOpcode() == ISD::LOAD)) {
+    // Neither operand is a bare FrameIndex or WRAPPER'd global, but
+    // exactly one is a fresh LOAD -- plausibly a pointer *value* read
+    // back from its own stack slot (e.g. a `const T arr[]` parameter, or
+    // any other local pointer variable: this backend reloads such values
+    // from memory at every use rather than keeping them live in a
+    // register across statement boundaries). Such a loaded pointer is
+    // exactly as word-granular as a global's or a local array's address
+    // — confirmed empirically: a runtime index into an array reached via
+    // a pointer *parameter* (as opposed to a locally-declared array,
+    // already covered by the FrameIndex case above) landed on element
+    // 2*i instead of element i, the identical symptom as the two bugs
+    // documented above this function, just reached through a base
+    // pointer shape neither existing case recognized.
+    //
+    // The one-operand-is-a-LOAD shape alone isn't a safe enough signal by
+    // itself, though: plenty of perfectly ordinary integer arithmetic
+    // adds two loaded values together with no pointer involved at all
+    // (e.g. `a[i] = b[j] + c[k]`), and halving one side of that would
+    // silently corrupt it. What actually distinguishes the runtime-GEP
+    // case is what this ADD's *result* feeds: pointer arithmetic is
+    // consumed directly as a LOAD/STORE's base-pointer operand, while
+    // ordinary arithmetic never is. EclipseISelDAGToDAG.cpp's ISD::LOAD/
+    // ISD::STORE handling confirms this ADD is still exactly that base-
+    // pointer operand at the point this combine runs — a non-FrameIndex
+    // base falls through to the generic LDIND/STIND pattern completely
+    // unchanged, so gating on that usage is both necessary and sufficient
+    // to catch this case without misfiring on unrelated arithmetic that
+    // never becomes an address.
+    bool FeedsMemoryAddress = llvm::any_of(N->users(), [&](SDNode *User) {
+      if (auto *LD = dyn_cast<LoadSDNode>(User))
+        return LD->getBasePtr().getNode() == N;
+      if (auto *ST = dyn_cast<StoreSDNode>(User))
+        return ST->getBasePtr().getNode() == N;
+      return false;
+    });
+    if (!FeedsMemoryAddress)
+      return SDValue();
+    if (N0.getOpcode() == ISD::LOAD) {
+      Base = N0;
+      Offset = N1;
+    } else {
+      Base = N1;
+      Offset = N0;
+    }
+    // A loaded pointer value has no analogous "already halved, embedded
+    // in the node" mechanism the way a global's LEAGA/offset-slot
+    // printing does (see the comment below) — treat it like the
+    // FrameIndex case: a compile-time-constant Offset here (e.g.
+    // `arr[3]` through a pointer parameter) still needs the same /2 fix,
+    // not just the runtime-index case.
+    BaseIsFrameIndex = true;
+  } else {
+    return SDValue();
+  }
+
+  // A compile-time-constant Offset paired with a *global* Base here is
+  // *not* the runtime-GEP case this combine exists for — it's the generic
+  // type legalizer's own "access word N of a value that didn't fit in one
+  // register" address computation (e.g. splitting a 32-bit load/store on
+  // a >16-bit global into two i16 halves reaches the second one via
+  // `base + 1`), which is already word-granular. Confirmed empirically as
+  // a real, previously-undiscovered bug: halving that constant-1 offset
+  // (0 after integer division) silently redirected the "high word" access
+  // onto the same address as the low word, corrupting every 32-bit
+  // arithmetic op whose operand round-tripped through such a global.
+  // Constant offsets that *do* need the byte->word fix (a real GEP into
+  // an array of i16/i32) are already folded directly into
+  // GlobalAddressSDNode's own offset field by LowerGlobalAddress (see
+  // this function's header comment) and never reach here as a separate
+  // ADD operand at all — so excluding constants here only excludes cases
+  // that were never this combine's intended target in the first place.
+  //
+  // A FrameIndex Base is a *different* situation, confirmed via a second,
+  // independent repro (two file-scope `u32` globals added together,
+  // tracked down with `llc -debug-only=isel`/hand-tracing the emitted
+  // assembly): the type legalizer's "access word N" address computation
+  // for a *local* multi-word value (e.g. the second/low word of a 32-bit
+  // stack slot, reached whenever the frame index doesn't reduce to a bare
+  // FrameIndexSDNode base pointer that EclipseISelDAGToDAG's custom
+  // ISD::LOAD/ISD::STORE handling can absorb directly) has no analogous
+  // "already-divided, embedded in the node" mechanism the way
+  // LowerGlobalAddress/LEAGA's offset-slot printing does for globals —
+  // it reaches here as a genuinely still-byte-granular ADD(FrameIndex,
+  // Constant) needing the same /2 fix as the runtime-GEP case. Leaving it
+  // unhalved (as the global-only guard below did) computes the wrong
+  // word address for that second word (e.g. base+2 instead of base+1),
+  // silently reading/writing one word further than intended — this is
+  // exactly the corruption the multi-word-global repro traced back to
+  // once the global-load path itself was ruled out (verified correct by
+  // hand against the emitted LEAGA/offset-slot sequence).
+  if (!BaseIsFrameIndex &&
+      (isa<ConstantSDNode>(Offset) || IsWrappedConstant(Offset)))
+    return SDValue();
+
+  SelectionDAG &DAG = DCI.DAG;
+  SDLoc dl(N);
+
+  // A byte-scaled index of exactly 2 (an i16 element) commonly reaches
+  // here not as a MUL-by-constant but as a *self-add* (`X+X`) — LowerShift
+  // custom-lowers `X << 1` that way (see LowerShift's comment above), and
+  // GEP's own generic lowering will sometimes produce the multiply
+  // pre-strength-reduced into a shift too. Emitting a real runtime HALVE
+  // (an actual DIV instruction, see below) to undo an addend that's
+  // *already* visibly just `X+X` is pure waste — a real division for a
+  // value that's algebraically just X again — and on a program with many
+  // such array accesses the extra instructions are enough to push a
+  // branch target past dgasm's 0-255 page-relative JMP range (confirmed
+  // empirically: this was silently bloating every runtime GEP through a
+  // loaded pointer parameter enough to break an otherwise-fine program).
+  // Recognize the shape directly and skip the round trip.
+  if (Offset.getOpcode() == ISD::ADD &&
+      Offset.getOperand(0) == Offset.getOperand(1)) {
+    SDValue Halved = Offset.getOperand(0);
+    return DAG.getNode(EclipseISD::WORD_ADD, dl, MVT::i16, Base, Halved);
+  }
+
+  // A string-literal-backed global is the one Base shape that must NOT
+  // be halved here, matching EclipseAsmPrinter.cpp's own LEAGA-offset
+  // case (see its isString() check): dgasm emits a string initializer
+  // one full word per character ("var name = ...", no packed suffix),
+  // never two-bytes-to-a-word the way a numeric array is packed, so a
+  // runtime index into one is already word-granular. Only reachable
+  // when Base is the WRAPPER'd-global case above -- BaseIsFrameIndex is
+  // true for both the real-FrameIndex and loaded-pointer cases, neither
+  // of which has an underlying GlobalVariable to inspect (and both
+  // always need the halving regardless: this target's frame allocator
+  // packs every local, char arrays included, two bytes to a word). A
+  // real, confirmed-the-hard-way bug: a plain hex-digit lookup table
+  // ("0123456789abcdef"[val & 15]) silently read back element (val&15)/2
+  // instead of element val&15 -- val=255 printed "77" instead of "ff",
+  // both recursive calls' "val and 15 == 15" landing on element 7 (='7')
+  // instead of element 15 (='f').
+  if (!BaseIsFrameIndex) {
+    if (auto *GA = dyn_cast<GlobalAddressSDNode>(Base.getOperand(0))) {
+      if (const auto *GV = dyn_cast<GlobalVariable>(GA->getGlobal())) {
+        if (GV->hasInitializer()) {
+          if (const auto *CDA =
+                  dyn_cast<ConstantDataArray>(GV->getInitializer())) {
+            if (CDA->isString())
+              return DAG.getNode(EclipseISD::WORD_ADD, dl, MVT::i16, Base,
+                                  Offset);
+          }
+        }
+      }
+    }
+  }
+
+  SDValue TwoCP = DAG.getConstantPool(
+      ConstantInt::get(*DAG.getContext(), APInt(16, 2)), MVT::i16);
+  SDValue Two = LowerConstantPool(TwoCP, DAG);
+  SDValue Halved = DAG.getNode(EclipseISD::HALVE, dl, MVT::i16, Offset, Two);
+  return DAG.getNode(EclipseISD::WORD_ADD, dl, MVT::i16, Base, Halved);
+}
+
+// No *single-bit* shift/rotate-with-writeback hardware is exposed here
+// (see README.md — the base ISA's single-bit rotate-through-carry could
+// build one, but that's real, separate scope; this is a different gap
+// from HXL/HXR/DHXL/DHXR below, which are real but only shift by whole
+// 4-bit hex digits), so sign_extend_inreg from i8 — the ABI's "truncate a
+// char return value to 8 bits, then sign-extend back" step — is done
+// with the classic bit trick using only instructions this backend
+// already has: ((x & 0xFF) ^ 0x80) - 0x80.
+SDValue EclipseTargetLowering::LowerSIGN_EXTEND_INREG(SDValue Op,
+                                                       SelectionDAG &DAG) const {
+  SDLoc dl(Op);
+  EVT ExtVT = cast<VTSDNode>(Op.getOperand(1))->getVT();
+  assert(ExtVT == MVT::i8 && "unexpected sign_extend_inreg source width");
+  SDValue X = Op.getOperand(0);
+  SDValue Masked =
+      DAG.getNode(ISD::AND, dl, MVT::i16, X, DAG.getConstant(0xFF, dl, MVT::i16));
+  SDValue Flipped = DAG.getNode(ISD::XOR, dl, MVT::i16, Masked,
+                                 DAG.getConstant(0x80, dl, MVT::i16));
+  return DAG.getNode(ISD::SUB, dl, MVT::i16, Flipped,
+                      DAG.getConstant(0x80, dl, MVT::i16));
+}
+
+SDValue EclipseTargetLowering::LowerShift(SDValue Op, SelectionDAG &DAG) const {
+  SDLoc dl(Op);
+  SDValue X = Op.getOperand(0);
+  auto *AmtNode = dyn_cast<ConstantSDNode>(Op.getOperand(1));
+  if (!AmtNode)
+    report_fatal_error(
+        "Eclipse backend only supports shifts by a compile-time constant "
+        "amount (no variable-count shift/rotate hardware is exposed yet — "
+        "see README.md)");
+  uint64_t Amt = AmtNode->getZExtValue();
+
+  if (Op.getOpcode() == ISD::SHL) {
+    // Real Eclipse S/140 hardware has HXL ("hex shift left"), a genuine
+    // one-instruction shift by N *hex digits* (4*N bits, N in 1-4) — see
+    // EclipseInstrInfo.td's HXL/HXR/DHXL/DHXR comment for how this was
+    // verified against eclipseemu (every N in 1-4, not just N=1). Handle
+    // the amount's whole multiple-of-4 part with a single HXL call —
+    // capped at 16 bits, matching the old loop's `I < 16` cap: a 16-bit
+    // accumulator shifted left by 16 or more bits is always 0 regardless
+    // of the exact amount, and HXL's own N maxes out at 4 (=16 bits)
+    // anyway — then fall back to the cheap self-add chain (still the only
+    // way to shift by 1-3 bits: this ISA has no finer-grained hardware
+    // shift) for the remaining 0-3 bits. This changes `x << 15` from 15
+    // chained ADDrr instructions to one HXL (the 12-bit part) plus 3
+    // ADDrr (the 3-bit remainder); `x << 15..16`-equivalent amounts (a
+    // whole 16-bit clear) drop from up to 16 ADDrr to a single HXL. Amt <
+    // 4 (no whole hex digit to shift) skips HXL entirely and is
+    // byte-for-byte the old self-add-only behavior — no regression there.
+    //
+    // Self-add, chained: each iteration's two operands are both just the
+    // previous iteration's fresh result — no operand needs to survive
+    // *across* iterations, so this doesn't hit the UDIVrr bug documented
+    // below.
+    uint64_t EffAmt = Amt < 16 ? Amt : 16;
+    uint64_t Quads = EffAmt / 4;
+    uint64_t Rem = EffAmt % 4;
+    SDValue Result = X;
+    if (Quads > 0) {
+      SDValue N = DAG.getTargetConstant(Quads, dl, MVT::i16);
+      Result =
+          SDValue(DAG.getMachineNode(Eclipse::HXL, dl, MVT::i16, Result, N), 0);
+    }
+    for (uint64_t I = 0; I < Rem; ++I)
+      Result = DAG.getNode(ISD::ADD, dl, MVT::i16, Result, Result);
+    return Result;
+  }
+
+  // SRL/SRA used to divide by 2, Amt times, chaining Result through a
+  // *shared* "Two" divisor operand across iterations — mathematically
+  // fine (x >>u N == x / 2^N, and arithmetic right shift is floor
+  // division by 2^N for any N, not just N=1, so the same truncating-
+  // division rounding correction below applies regardless of how big the
+  // divisor is), but it triggered a real, separate backend bug: UDIVrr's
+  // post-RA expansion (EclipseInstrInfo.cpp) always routes the dividend
+  // and quotient through AC1, physically overwriting whatever was there
+  // — including "Two" itself, if the register allocator had (reasonably,
+  // from its own view — UDIVrr's declared operands don't say AC1 gets
+  // clobbered beyond $dst) chosen to keep the shared divisor live in AC1
+  // across the chain for reuse. Confirmed with eclipseemu: a chained
+  // x/8 (three x/2 steps, from 8's power-of-two strength reduction)
+  // computed the *second* step's divisor as the *first* step's quotient
+  // instead of 2, corrupting every value from index 1 of a `for` loop
+  // digit-extraction onward. A single divide by the *full* 2^Amt divisor
+  // sidesteps this rather than fixing UDIVrr's register-allocation
+  // interaction directly — this project already tried marking UDIVrr's
+  // implicit AC0/AC1 clobber explicitly once (see EclipseInstrInfo.td's
+  // MUL/DIV comment) and that broke allocation outright ("ran out of
+  // registers"), so this is the lower-risk fix.
+  if (Amt >= 16) {
+    if (Op.getOpcode() == ISD::SRL)
+      return DAG.getConstant(0, dl, MVT::i16);
+    // SRA of a full-width-or-wider amount: all-sign-bit fill, i.e. 0 or
+    // -1 depending on X's sign — built from SETCC-then-negate rather
+    // than a fresh SELECT_CC, since 0/1 -> 0/-1 is just "0 minus the
+    // boolean".
+    SDValue Zero = DAG.getConstant(0, dl, MVT::i16);
+    SDValue Neg = DAG.getSetCC(dl, MVT::i16, X, Zero, ISD::SETLT);
+    return DAG.getNode(ISD::SUB, dl, MVT::i16, Zero, Neg);
+  }
+
+  SDValue Divisor = DAG.getConstant(uint64_t(1) << Amt, dl, MVT::i16);
+  if (Op.getOpcode() == ISD::SRL) {
+    // UDIVrr's post-RA expansion (EclipseInstrInfo.cpp's
+    // expandPostRAPseudo) is a genuinely expensive ~9-real-instruction
+    // sequence -- save AC2 (the frame pointer) to the hardware stack,
+    // prime AC0/AC1/AC2, the hardware DIV itself, move the result out,
+    // restore AC2 -- and that cost is the *same* regardless of the
+    // divisor's value, since it's one hardware division either way. HXR
+    // ("hex shift right") is a single real instruction, so any Amt that's
+    // an exact multiple of 4 (a common case: `>>8`/`>>4` byte/nibble
+    // extraction) is a strict, large win to special-case -- one HXR in
+    // place of the entire UDIV expansion. A non-multiple-of-4 Amt still
+    // goes through UDIV: this ISA has no finer-than-4-bit hardware right
+    // shift, and splitting into an HXR for the multiple-of-4 part plus a
+    // *separate* UDIV for the 1-3-bit remainder would cost strictly MORE
+    // instructions than today's single UDIV-by-2^Amt, not fewer, since the
+    // expensive part of UDIV (the save/restore/DIV sequence) still has to
+    // run in full for that remainder regardless of how small its divisor
+    // is.
+    if (Amt > 0 && Amt % 4 == 0) {
+      SDValue N = DAG.getTargetConstant(Amt / 4, dl, MVT::i16);
+      return SDValue(DAG.getMachineNode(Eclipse::HXR, dl, MVT::i16, X, N), 0);
+    }
+    return DAG.getNode(ISD::UDIV, dl, MVT::i16, X, Divisor);
+  }
+
+  // SRA (arithmetic right shift) deliberately still goes through the
+  // SDIV/SREM-with-floor-correction path below, not HXR: HXR/DHXR are
+  // logical (zero-fill) shifts, wrong for a negative operand's sign-
+  // preserving shift, and while the classic bit trick
+  // `(x < 0) ? ~(~x >>u n) : (x >>u n)` could let SRA reuse the SRL win
+  // above, that's a materially bigger change to a code path this project
+  // has already found fragile once (the UDIVrr register-corruption bug
+  // documented just above -- a real, previously-fixed bug in this exact
+  // function) for comparatively little payback: SRA is already a single
+  // SELECT_CC-free SDIV+SREM+correction sequence, not obviously hotter in
+  // real programs than SRL, and this backend's own stated discipline is
+  // to verify every hardware-facing change thoroughly rather than stack a
+  // second risky rework on top of a freshly-verified one in the same
+  // change. Left as-is; a future change could revisit this with the same
+  // eclipseemu-verification rigor applied to HXL/HXR above.
+  assert(Op.getOpcode() == ISD::SRA && "not a shift opcode");
+  SDValue Zero = DAG.getConstant(0, dl, MVT::i16);
+  SDValue Q = DAG.getNode(ISD::SDIV, dl, MVT::i16, X, Divisor);
+  SDValue R = DAG.getNode(ISD::SREM, dl, MVT::i16, X, Divisor);
+  SDValue Neg = DAG.getSetCC(dl, MVT::i16, X, Zero, ISD::SETLT);
+  SDValue RNZ = DAG.getSetCC(dl, MVT::i16, R, Zero, ISD::SETNE);
+  SDValue Adj = DAG.getNode(ISD::AND, dl, MVT::i16, Neg, RNZ);
+  return DAG.getNode(ISD::SUB, dl, MVT::i16, Q, Adj);
+}
+
+SDValue EclipseTargetLowering::LowerSDIVREM(SDValue Op, SelectionDAG &DAG) const {
+  bool WantRemainder = Op.getOpcode() == ISD::SREM;
+  SDLoc dl(Op);
+  SDValue LHS = Op.getOperand(0);
+  SDValue RHS = Op.getOperand(1);
+  SDValue Zero = DAG.getConstant(0, dl, MVT::i16);
+
+  auto AbsVal = [&](SDValue X) {
+    SDValue NegX = DAG.getNode(ISD::SUB, dl, MVT::i16, Zero, X);
+    return DAG.getNode(ISD::SELECT_CC, dl, MVT::i16, X, Zero, NegX, X,
+                        DAG.getCondCode(ISD::SETLT));
+  };
+  SDValue AbsLHS = AbsVal(LHS);
+  SDValue AbsRHS = AbsVal(RHS);
+
+  if (WantRemainder) {
+    SDValue URem = DAG.getNode(ISD::UREM, dl, MVT::i16, AbsLHS, AbsRHS);
+    // C's `%` result takes the sign of the dividend.
+    SDValue NegRem = DAG.getNode(ISD::SUB, dl, MVT::i16, Zero, URem);
+    return DAG.getNode(ISD::SELECT_CC, dl, MVT::i16, LHS, Zero, NegRem, URem,
+                        DAG.getCondCode(ISD::SETLT));
+  }
+
+  SDValue UQuot = DAG.getNode(ISD::UDIV, dl, MVT::i16, AbsLHS, AbsRHS);
+  SDValue NegQuot = DAG.getNode(ISD::SUB, dl, MVT::i16, Zero, UQuot);
+  // Quotient is negative iff exactly one of LHS/RHS was negative.
+  SDValue LhsNeg = DAG.getSetCC(dl, MVT::i16, LHS, Zero, ISD::SETLT);
+  SDValue RhsNeg = DAG.getSetCC(dl, MVT::i16, RHS, Zero, ISD::SETLT);
+  SDValue QuotNeg = DAG.getNode(ISD::XOR, dl, MVT::i16, LhsNeg, RhsNeg);
+  return DAG.getNode(ISD::SELECT_CC, dl, MVT::i16, QuotNeg, Zero, NegQuot,
+                      UQuot, DAG.getCondCode(ISD::SETNE));
+}
+
+// See the setOperationAction comment on ISD::UDIVREM in the constructor
+// and EclipseInstrInfo.td's UDIVREMrr comment for the full story. Built
+// directly as a machine node (DAG.getMachineNode), not matched via a
+// TableGen Pat: this codebase has no existing precedent for a plain Pat
+// matching a 2-result generic SDNode straight to a 2-out instruction,
+// whereas building the machine node directly during Custom-lowering
+// already does (LowerSTACKSAVE/LowerDYNAMIC_STACKALLOC's STACKSAVE_
+// PSEUDO/VLAALLOC nodes just below). Unlike those, this needs no chain
+// operand -- udiv/urem are pure arithmetic with no side effects -- so
+// there is no getMergeValues wrapper to build either: result 0 is the
+// quotient and result 1 the remainder (SDTIntBinHiLoOp's convention,
+// matching UDIVREMrr's own $quot/$rem operand order and
+// expandPostRAPseudo's UDIVREMrr case), and LegalizeDAG's Custom-action
+// handling for a multi-result node already walks Res.getValue(i) for
+// every one of the original node's results on its own.
+SDValue EclipseTargetLowering::LowerUDIVREM(SDValue Op, SelectionDAG &DAG) const {
+  SDLoc dl(Op);
+  SDValue LHS = Op.getOperand(0);
+  SDValue RHS = Op.getOperand(1);
+  SDVTList VTs = DAG.getVTList(MVT::i16, MVT::i16);
+  SDValue Ops[] = {LHS, RHS};
+  SDNode *DivRem = DAG.getMachineNode(Eclipse::UDIVREMrr, dl, VTs, Ops);
+  return SDValue(DivRem, 0);
+}
+
+SDValue EclipseTargetLowering::LowerConstantPool(SDValue Op,
+                                                  SelectionDAG &DAG) const {
+  const auto *N = cast<ConstantPoolSDNode>(Op);
+  SDLoc dl(Op);
+  SDValue CP = DAG.getTargetConstantPool(N->getConstVal(), MVT::i16,
+                                          N->getAlign(), N->getOffset());
+  return DAG.getNode(EclipseISD::WRAPPER, dl, MVT::i16, CP);
+}
+
+//===----------------------------------------------------------------------===//
+// Comparisons / branches: everything reduces to a subtraction plus one of
+// the skip-test conditional branches. See docs/CALLING_CONVENTION.md's
+// verified idiom in the sibling eccc project.
+//
+// Unsigned comparisons do NOT reuse the signed sign-test path (BGEZ/BLTZ)
+// — an earlier version did, matching eccc's own documented limitation,
+// but that's a genuine bug here, not just an acceptable simplification:
+// BGEZ/BLTZ test the *sign bit* of a separately-computed SUB result,
+// which disagrees with the true unsigned relation whenever the
+// difference's sign bit doesn't match (e.g. 65535u >= 8u is true, but
+// 65535-8 = 65527 has its sign bit set). Confirmed via eclipseemu:
+// printf("%o", val) for any unsigned val >= 32768 silently printed
+// garbage as a result, since the hand-rolled print_octal's recursive
+// `if (val >= 8)` never took its true branch. BGEU/BLTU (see
+// EclipseISD::BGEU's comment) test the native carry from "SUB#
+// rhs,lhs" directly instead.
+//===----------------------------------------------------------------------===//
+
+static bool isUnsignedCC(ISD::CondCode CC) {
+  switch (CC) {
+  case ISD::SETULT:
+  case ISD::SETUGE:
+  case ISD::SETUGT:
+  case ISD::SETULE:
+    return true;
+  default:
+    return false;
+  }
+}
+
+static EclipseISD::NodeType canonBranchOpcode(ISD::CondCode CC, SDValue &LHS,
+                                               SDValue &RHS) {
+  switch (CC) {
+  case ISD::SETEQ:
+    return EclipseISD::BRZ;
+  case ISD::SETNE:
+    return EclipseISD::BRNZ;
+  case ISD::SETLT:
+    return EclipseISD::BLTZ;
+  case ISD::SETULT:
+    return EclipseISD::BLTU;
+  case ISD::SETGE:
+    return EclipseISD::BGEZ;
+  case ISD::SETUGE:
+    return EclipseISD::BGEU;
+  case ISD::SETGT:
+    std::swap(LHS, RHS);
+    return EclipseISD::BLTZ;
+  case ISD::SETUGT:
+    std::swap(LHS, RHS);
+    return EclipseISD::BLTU;
+  case ISD::SETLE:
+    std::swap(LHS, RHS);
+    return EclipseISD::BGEZ;
+  case ISD::SETULE:
+    std::swap(LHS, RHS);
+    return EclipseISD::BGEU;
+  default:
+    llvm_unreachable("unsupported Eclipse condition code");
+  }
+}
+
+static unsigned canonSelectOpcode(ISD::CondCode CC, SDValue &LHS,
+                                   SDValue &RHS) {
+  switch (CC) {
+  case ISD::SETEQ:
+    return Eclipse::BRZ;
+  case ISD::SETNE:
+    return Eclipse::BRNZ;
+  case ISD::SETLT:
+    return Eclipse::BLTZ;
+  case ISD::SETULT:
+    return Eclipse::BLTU;
+  case ISD::SETGE:
+    return Eclipse::BGEZ;
+  case ISD::SETUGE:
+    return Eclipse::BGEU;
+  case ISD::SETGT:
+    std::swap(LHS, RHS);
+    return Eclipse::BLTZ;
+  case ISD::SETUGT:
+    std::swap(LHS, RHS);
+    return Eclipse::BLTU;
+  case ISD::SETLE:
+    std::swap(LHS, RHS);
+    return Eclipse::BGEZ;
+  case ISD::SETULE:
+    std::swap(LHS, RHS);
+    return Eclipse::BGEU;
+  default:
+    llvm_unreachable("unsupported Eclipse condition code");
+  }
+}
+
+SDValue EclipseTargetLowering::LowerBR_CC(SDValue Op, SelectionDAG &DAG) const {
+  SDLoc dl(Op);
+  SDValue Chain = Op.getOperand(0);
+  ISD::CondCode CC = cast<CondCodeSDNode>(Op.getOperand(1))->get();
+  SDValue LHS = Op.getOperand(2);
+  SDValue RHS = Op.getOperand(3);
+  SDValue Dest = Op.getOperand(4);
+
+  bool Unsigned = isUnsignedCC(CC);
+  EclipseISD::NodeType NodeOpc = canonBranchOpcode(CC, LHS, RHS);
+  if (Unsigned)
+    return DAG.getNode(NodeOpc, dl, MVT::Other, Chain, LHS, RHS, Dest);
+
+  SDValue Cmp = DAG.getNode(ISD::SUB, dl, MVT::i16, LHS, RHS);
+  return DAG.getNode(NodeOpc, dl, MVT::Other, Chain, Cmp, Dest);
+}
+
+// See the ISD::BRCOND setOperationAction comment in the constructor for
+// why this exists as its own Custom lowering rather than relying on
+// generic Expand: reduces `brcond Chain, Cond, Dest` to the equivalent
+// `br_cc Chain, SETNE, Cond, 0, Dest` and hands it to the already-robust
+// LowerBR_CC, rather than duplicating that logic.
+SDValue EclipseTargetLowering::LowerBRCOND(SDValue Op, SelectionDAG &DAG) const {
+  SDLoc dl(Op);
+  SDValue Chain = Op.getOperand(0);
+  SDValue Cond = Op.getOperand(1);
+  SDValue Dest = Op.getOperand(2);
+  SDValue Zero = DAG.getConstant(0, dl, MVT::i16);
+  SDValue BRCC =
+      DAG.getNode(ISD::BR_CC, dl, MVT::Other, Chain,
+                  DAG.getCondCode(ISD::SETNE), Cond, Zero, Dest);
+  return LowerBR_CC(BRCC, DAG);
+}
+
+SDValue EclipseTargetLowering::LowerSELECT_CC(SDValue Op,
+                                               SelectionDAG &DAG) const {
+  SDLoc dl(Op);
+  SDValue LHS = Op.getOperand(0);
+  SDValue RHS = Op.getOperand(1);
+  SDValue True = Op.getOperand(2);
+  SDValue False = Op.getOperand(3);
+  ISD::CondCode CC = cast<CondCodeSDNode>(Op.getOperand(4))->get();
+
+  bool Unsigned = isUnsignedCC(CC);
+  unsigned CondOpc = canonSelectOpcode(CC, LHS, RHS);
+  if (Unsigned) {
+    SDValue Ops[] = {LHS, RHS, DAG.getTargetConstant(CondOpc, dl, MVT::i16),
+                      True, False};
+    return SDValue(DAG.getMachineNode(Eclipse::SelectU, dl, MVT::i16, Ops), 0);
+  }
+  SDValue Cmp = DAG.getNode(ISD::SUB, dl, MVT::i16, LHS, RHS);
+  SDValue Ops[] = {Cmp, DAG.getTargetConstant(CondOpc, dl, MVT::i16), True,
+                    False};
+  return SDValue(DAG.getMachineNode(Eclipse::Select, dl, MVT::i16, Ops), 0);
+}
+
+SDValue EclipseTargetLowering::LowerSETCC(SDValue Op, SelectionDAG &DAG) const {
+  SDLoc dl(Op);
+  SDValue LHS = Op.getOperand(0);
+  SDValue RHS = Op.getOperand(1);
+  ISD::CondCode CC = cast<CondCodeSDNode>(Op.getOperand(2))->get();
+
+  bool Unsigned = isUnsignedCC(CC);
+  unsigned CondOpc = canonSelectOpcode(CC, LHS, RHS);
+  SDValue One = DAG.getConstant(1, dl, MVT::i16);
+  SDValue Zero = DAG.getConstant(0, dl, MVT::i16);
+  if (Unsigned) {
+    SDValue Ops[] = {LHS, RHS, DAG.getTargetConstant(CondOpc, dl, MVT::i16),
+                      One, Zero};
+    return SDValue(DAG.getMachineNode(Eclipse::SelectU, dl, MVT::i16, Ops), 0);
+  }
+  SDValue Cmp = DAG.getNode(ISD::SUB, dl, MVT::i16, LHS, RHS);
+  SDValue Ops[] = {Cmp, DAG.getTargetConstant(CondOpc, dl, MVT::i16), One,
+                    Zero};
+  return SDValue(DAG.getMachineNode(Eclipse::Select, dl, MVT::i16, Ops), 0);
+}
+
+//===----------------------------------------------------------------------===//
+// Calling convention. Every argument is pushed on the software stack,
+// right-to-left, one word each (the common SelectionDAG type legalizer has
+// already split any wider-than-i16 argument into multiple i16 pieces by
+// the time LowerCall/LowerFormalArguments see them — see the file
+// header). No argument or return-value registers, matching eccc's own
+// convention exactly: see docs/CALLING_CONVENTION.md.
+//===----------------------------------------------------------------------===//
+
+SDValue EclipseTargetLowering::LowerFormalArguments(
+    SDValue Chain, CallingConv::ID /*CallConv*/, bool IsVarArg,
+    const SmallVectorImpl<ISD::InputArg> &Ins, const SDLoc &dl,
+    SelectionDAG &DAG, SmallVectorImpl<SDValue> &InVals) const {
+  MachineFunction &MF = DAG.getMachineFunction();
+  MachineFrameInfo &MFI = MF.getFrameInfo();
+
+  // FP-5 = first parameter (pushed last by the caller, so shallowest);
+  // FP-1/FP-2/FP-3/FP+0 are AC0/AC1/AC2/the return address, which real
+  // hardware SAVE pushes onto the *same* stack the caller's argument
+  // pushes already occupy, immediately below the callee's own SAVE (see
+  // EclipseInstrInfo.td's SAVE comment for the exact push order this
+  // offset is derived from, and DEBUGGING_NOTES.md for how this was
+  // found: this used to be a *positive* FP+2 offset under the old
+  // manual-push prologue, whose stack grew the opposite direction from
+  // real SAVE's — reusing that old positive offset unmodified after
+  // switching to SAVE landed on whichever of the callee's own just-
+  // pushed AC0-AC3 words happened to sit at that address instead of the
+  // caller's real arguments).
+  for (unsigned i = 0, e = Ins.size(); i != e; ++i) {
+    int FI = MFI.CreateFixedObject(kWordBytes, /*SPOffset*/ -5 - (int)i,
+                                    /*IsImmutable*/ true);
+    SDValue FIN = DAG.getFrameIndex(FI, MVT::i16);
+    InVals.push_back(DAG.getLoad(MVT::i16, dl, Chain, FIN,
+                                  MachinePointerInfo::getFixedStack(MF, FI)));
+  }
+
+  if (IsVarArg) {
+    // The "..." arguments are pushed right-to-left same as any named
+    // one (LowerCall), so they simply continue immediately below the
+    // last named parameter at FP-5-Ins.size() — no distinct varargs
+    // save area to build. va_start (LowerVASTART) just needs this frame
+    // index's address.
+    int FI = MFI.CreateFixedObject(kWordBytes,
+                                    /*SPOffset*/ -5 - (int)Ins.size(),
+                                    /*IsImmutable*/ true);
+    MF.getInfo<EclipseMachineFunctionInfo>()->setVarArgsFrameIndex(FI);
+  }
+
+  return Chain;
+}
+
+SDValue EclipseTargetLowering::LowerVASTART(SDValue Op,
+                                             SelectionDAG &DAG) const {
+  MachineFunction &MF = DAG.getMachineFunction();
+  auto *FuncInfo = MF.getInfo<EclipseMachineFunctionInfo>();
+  SDLoc dl(Op);
+
+  // Same mechanism as `&local`: a bare FrameIndex value gets custom-
+  // selected to LEAFI (EclipseISelDAGToDAG.cpp), materializing the
+  // varargs area's real address into a register.
+  SDValue FrameIndex =
+      DAG.getFrameIndex(FuncInfo->getVarArgsFrameIndex(), MVT::i16);
+  const Value *SV = cast<SrcValueSDNode>(Op.getOperand(2))->getValue();
+  return DAG.getStore(Op.getOperand(0), dl, FrameIndex, Op.getOperand(1),
+                       MachinePointerInfo(SV));
+}
+
+SDValue EclipseTargetLowering::LowerVAARG(SDValue Op, SelectionDAG &DAG) const {
+  SDNode *Node = Op.getNode();
+  SDValue Chain = Node->getOperand(0);
+  SDValue VAListPtr = Node->getOperand(1);
+  EVT VT = Node->getValueType(0);
+  SDLoc dl(Node);
+
+  // va_list itself is just a plain i16 pointer variable (see
+  // LowerVASTART) — load its current value, ...
+  SDValue VAList =
+      DAG.getLoad(MVT::i16, dl, Chain, VAListPtr, MachinePointerInfo());
+  // ... read the argument from wherever it points (no alignment
+  // adjustment: see the setOperationAction comment above), ...
+  SDValue Result =
+      DAG.getLoad(VT, dl, VAList.getValue(1), VAList, MachinePointerInfo());
+  // ... and advance it by exactly one word for the next va_arg call.
+  // Plain `1`, not kWordBytes(2): ordinary pointer arithmetic elsewhere
+  // in this backend (e.g. `s++` in eclipse_rt.c's puts()) already
+  // resolves an i16 element's GEP scale to 1 real word, not 2 — kWordBytes
+  // is a MachineFrameInfo *byte-size* convention (CreateFixedObject),
+  // unrelated to this runtime-pointer increment. Using kWordBytes here
+  // silently advanced two words per va_arg instead of one.
+  //
+  // SUB, not ADD: real hardware SAVE grows this stack *upward* (see
+  // EclipseInstrInfo.td's SAVE comment), so arguments pushed right-to-
+  // left land at *decreasing* addresses as va_arg walks left-to-right
+  // through them — the last-named parameter (where va_start points) is
+  // the highest address of the group, and each successive vararg sits
+  // one word *below* the last. Confirmed via a real repro: a printf
+  // call with two `%d` arguments printed the first one correctly and
+  // read garbage for the second when this incorrectly added instead —
+  // it was walking away from the pushed arguments instead of through
+  // them, off into whatever else happened to occupy higher addresses.
+  SDValue NextPtr = DAG.getNode(ISD::SUB, dl, MVT::i16, VAList,
+                                 DAG.getConstant(1, dl, MVT::i16));
+  SDValue Chain2 = DAG.getStore(Result.getValue(1), dl, NextPtr, VAListPtr,
+                                 MachinePointerInfo());
+
+  SDValue Ops[2] = {Result, Chain2};
+  return DAG.getMergeValues(Ops, dl);
+}
+
+// Variable-length arrays: EclipseInstrInfo.td's VLAALLOC pseudo (expanded
+// by emitVLAAlloc, above -- see its own comment for the full mechanism
+// and why no explicit deallocation is ever needed) does the actual
+// hardware-stack-pointer reservation and returns the *old* top-of-stack
+// value. That's not yet a safe base pointer on its own -- real SAVE and
+// the software push/pop machinery both grow this stack by incrementing
+// *before* using a location, so the old value is still "in use" by
+// whatever's immediately below the newly reserved range. The +1 to turn
+// it into a real base pointer happens here, as a plain ordinary ADD
+// reaching normal ISel/register allocation, rather than inside
+// emitVLAAlloc's own hand-built expansion -- see that function's
+// comment for why: only two registers (AC0/AC1) are available there,
+// both already spoken for by the reservation logic itself.
+SDValue EclipseTargetLowering::LowerDYNAMIC_STACKALLOC(SDValue Op,
+                                                        SelectionDAG &DAG) const {
+  SDLoc dl(Op);
+  SDValue Chain = Op.getOperand(0);
+  SDValue Size = Op.getOperand(1); // byte count, a runtime i16 value.
+
+  // WordCount = ceil(Size / 2) = (Size + 1) / 2. Deliberately
+  // EclipseISD::HALVE (which selects straight to a real UDIVrr via a
+  // TableGen Pat), not a plain ISD::SRL/UDIV: this function builds its
+  // whole DAG fresh, during Custom-lowering itself, and a freshly-built
+  // SRL's shift-amount operand hasn't necessarily gone through
+  // ISD::Constant's own Custom-lowering (the constant-pool routing
+  // every constant on this target needs -- see the ADD combine's own
+  // comment elsewhere in this file) by the time LowerShift's strict
+  // "is this a plain ConstantSDNode" check runs on it -- confirmed the
+  // hard way: this exact SRL construction hit LowerShift's "only
+  // supports shifts by a compile-time constant amount" report_fatal_error,
+  // even though the amount genuinely was DAG.getConstant(1, ...).
+  // EclipseISD::HALVE has no such check (it isn't ISD::SRL/ISD::UDIV at
+  // all, so LowerShift never sees it), and PerformDAGCombine's own
+  // WORD_ADD offset computation already builds its "2" constant this
+  // same way (DAG.getConstantPool + LowerConstantPool, not
+  // DAG.getConstant) for the identical reason.
+  SDValue One = LowerConstantPool(
+      DAG.getConstantPool(ConstantInt::get(*DAG.getContext(), APInt(16, 1)),
+                           MVT::i16),
+      DAG);
+  SDValue SizePlus1 = DAG.getNode(ISD::ADD, dl, MVT::i16, Size, One);
+  SDValue Two = LowerConstantPool(
+      DAG.getConstantPool(ConstantInt::get(*DAG.getContext(), APInt(16, 2)),
+                           MVT::i16),
+      DAG);
+  SDValue WordCount =
+      DAG.getNode(EclipseISD::HALVE, dl, MVT::i16, SizePlus1, Two);
+
+  SDVTList VTs = DAG.getVTList(MVT::i16, MVT::Other);
+  // Value operand(s) first, chain last -- see LowerCall's PUSH
+  // construction comment for the established convention; got this
+  // backwards on the first attempt (Chain, WordCount), which tripped
+  // InstrEmitter's "#operands for dag node doesn't match .td file!"
+  // assertion.
+  SDValue AllocOps[] = {WordCount, Chain};
+  SDNode *Alloc =
+      DAG.getMachineNode(Eclipse::VLAALLOC, dl, VTs, AllocOps);
+  SDValue OldTop = SDValue(Alloc, 0);
+  SDValue NewChain = SDValue(Alloc, 1);
+
+  // Base = OldTop + 1: the first genuinely-free reserved word (see this
+  // function's own header comment above for why +1 is needed at all).
+  // Reuses the same already-lowered One constant from above rather than
+  // building a second DAG.getConstant(1, ...) -- see this function's
+  // other comment on why a freshly-built plain ISD::Constant isn't
+  // safe to feed into certain custom-lowered nodes here.
+  SDValue Base = DAG.getNode(ISD::ADD, dl, MVT::i16, OldTop, One);
+
+  SDValue Ops[2] = {Base, NewChain};
+  return DAG.getMergeValues(Ops, dl);
+}
+
+// llvm.stacksave: capture the current hardware stack pointer (memory
+// location 040) so a later llvm.stackrestore can discard anything
+// allocated since -- see STACKSAVE_PSEUDO's own comment in
+// EclipseInstrInfo.td for why clang emits this at all.
+SDValue EclipseTargetLowering::LowerSTACKSAVE(SDValue Op,
+                                              SelectionDAG &DAG) const {
+  SDLoc dl(Op);
+  SDValue Chain = Op.getOperand(0);
+  SDVTList VTs = DAG.getVTList(MVT::i16, MVT::Other);
+  SDValue Ops[] = {Chain};
+  SDNode *Save = DAG.getMachineNode(Eclipse::STACKSAVE_PSEUDO, dl, VTs, Ops);
+  SDValue Result[2] = {SDValue(Save, 0), SDValue(Save, 1)};
+  return DAG.getMergeValues(Result, dl);
+}
+
+// llvm.stackrestore: the inverse -- overwrite the hardware stack
+// pointer with a previously-saved value.
+SDValue EclipseTargetLowering::LowerSTACKRESTORE(SDValue Op,
+                                                 SelectionDAG &DAG) const {
+  SDLoc dl(Op);
+  SDValue Chain = Op.getOperand(0);
+  SDValue SavedPtr = Op.getOperand(1);
+  // Value operand(s) first, chain last -- see LowerCall's own PUSH
+  // construction comment ("value operand(s) first, chain last") for the
+  // established convention this matches.
+  SDValue Ops[] = {SavedPtr, Chain};
+  return SDValue(
+      DAG.getMachineNode(Eclipse::STACKRESTORE_PSEUDO, dl, MVT::Other, Ops),
+      0);
+}
+
+SDValue
+EclipseTargetLowering::LowerCall(TargetLowering::CallLoweringInfo &CLI,
+                                  SmallVectorImpl<SDValue> &InVals) const {
+  SelectionDAG &DAG = CLI.DAG;
+  SDLoc &dl = CLI.DL;
+  SmallVectorImpl<ISD::OutputArg> &Outs = CLI.Outs;
+  SmallVectorImpl<SDValue> &OutVals = CLI.OutVals;
+  SmallVectorImpl<ISD::InputArg> &Ins = CLI.Ins;
+  SDValue Chain = CLI.Chain;
+  SDValue Callee = CLI.Callee;
+  CLI.IsTailCall = false; // no tail-call support
+
+  // Calling a variadic function needs no special handling here: every
+  // argument, named or "...", is pushed the same way (right-to-left,
+  // below) — the callee's LowerFormalArguments is what distinguishes
+  // named parameters from the varargs area.
+
+  unsigned NumWords = Outs.size();
+  // 0, not NumWords: PUSH (emitPushPop) already reserves its own word via
+  // its own ISZABS before storing — ADJCALLSTACKDOWN reserving NumWords
+  // *again* here double-reserves the hardware stack pointer per
+  // argument. Only the "up" side needs NumWords, to release what PUSH
+  // actually reserved. A real, empirically-found bug (from before this
+  // targeted the same hardware-recognized stack location SAVE/RTN use —
+  // see emitPushPop's comment): with both sides at NumWords, the stack
+  // pointer leaked one word per pushed argument on every call, invisible
+  // in single-call-depth tests but corrupting AC2/AC3 (frame pointer /
+  // return address) after enough nested/looped calls — e.g. `puts()`
+  // calling `putchar()` in its own loop leaked enough words to return
+  // through a garbage AC3.
+  Chain = DAG.getCALLSEQ_START(Chain, 0, 0, dl);
+
+  // Push right-to-left (last parameter pushed first) — see
+  // docs/CALLING_CONVENTION.md.
+  SDValue InGlue;
+  SmallVector<SDValue, 8> PushChains;
+  for (unsigned i = NumWords; i != 0; --i) {
+    SDValue Arg = OutVals[i - 1];
+    SDValue Ops[] = {Arg, Chain}; // value operand(s) first, chain last
+    Chain = SDValue(DAG.getMachineNode(Eclipse::PUSH, dl, MVT::Other, Ops), 0);
+  }
+
+  // Direct call (a real GlobalValue or an external/libcall symbol): a
+  // direct EJSR straight to the callee's own symbol -- see
+  // EclipseInstrInfo.td's CALL def for why this needs no page-zero slot at
+  // all (real Eclipse extended addressing, unlike base-ISA JSR, reaches
+  // the callee's address directly regardless of distance). Always an
+  // ExternalSymbol operand (even for a real GlobalValue callee): CALL's
+  // Pattern matches texternalsym, and a GlobalValue's own name string is
+  // all EJSR's assembly text needs -- no separate compiler-synthesized
+  // symbol required anymore (the "<name>_SLOT" indirection this replaced
+  // did need one, since dgasm's `var NAME = OTHERSYMBOL` mechanism was
+  // the only way to get a page-zero pointer word; EJSR needs no such
+  // word).
+  //
+  // Indirect call (calling through a function-pointer *value* computed at
+  // runtime -- Callee is neither of the two SDNode kinds above, just an
+  // ordinary i16 SSA value already materialized into a register by the time
+  // it reaches here, e.g. loaded from a struct field or a local variable):
+  // there's no compile-time-known callee symbol for EJSR's assembly-text
+  // operand to reference at all. Real Nova/Eclipse JSR/EJSR have no "jump
+  // to whatever's in a register" addressing mode -- only a compile-time
+  // expression or memory-indirect (confirmed against the DG ISA and
+  // re-confirmed empirically on eclipseemu) -- so this goes through a
+  // distinct EclipseISD::CALL_INDIRECT node instead, which
+  // EclipseInstrInfo.td's CALLIND pseudo expands (via emitCallIndirect) into
+  // storing the pointer value into the shared page-zero `_scratch` word
+  // (the same one LDIND/STIND already use for general pointer dereference)
+  // followed by base-ISA "JSR @_scratch,0" -- unrelated to and untouched by
+  // the direct-call change above.
+  SDVTList NodeTys = DAG.getVTList(MVT::Other, MVT::Glue);
+  SmallVector<SDValue, 4> CallOps{Chain, Callee};
+  if (auto *G = dyn_cast<GlobalAddressSDNode>(Callee)) {
+    const char *PersistentName =
+        DAG.getMachineFunction().createExternalSymbolName(
+            G->getGlobal()->getName());
+    CallOps[1] = DAG.getTargetExternalSymbol(PersistentName, MVT::i16);
+    Chain = DAG.getNode(EclipseISD::CALL, dl, NodeTys, CallOps);
+  } else if (auto *E = dyn_cast<ExternalSymbolSDNode>(Callee)) {
+    const char *PersistentName =
+        DAG.getMachineFunction().createExternalSymbolName(E->getSymbol());
+    CallOps[1] = DAG.getTargetExternalSymbol(PersistentName, MVT::i16);
+    Chain = DAG.getNode(EclipseISD::CALL, dl, NodeTys, CallOps);
+  } else {
+    Chain = DAG.getNode(EclipseISD::CALL_INDIRECT, dl, NodeTys, CallOps);
+  }
+  InGlue = Chain.getValue(1);
+
+  Chain = DAG.getCALLSEQ_END(Chain, NumWords, 0, InGlue, dl);
+  InGlue = Chain.getValue(1);
+
+  // Return value (if any) comes back in AC0 (single word) or AC0:AC1 (a
+  // 2-word/32-bit value, e.g. `long` or soft-float `float` — both
+  // registers are free at this exact point, nothing else can be live
+  // yet, so a register pair needs no spill/reload machinery) — see
+  // docs/CALLING_CONVENTION.md and LowerReturn's matching half of this.
+  if (!Ins.empty()) {
+    SDValue Val0 =
+        DAG.getCopyFromReg(Chain, dl, Eclipse::AC0, MVT::i16, InGlue);
+    Chain = Val0.getValue(1);
+    InVals.push_back(Val0.getValue(0));
+
+    if (Ins.size() == 2) {
+      SDValue Val1 = DAG.getCopyFromReg(Chain, dl, Eclipse::AC1, MVT::i16,
+                                         Val0.getValue(2));
+      Chain = Val1.getValue(1);
+      InVals.push_back(Val1.getValue(0));
+    } else if (Ins.size() > 2) {
+      report_fatal_error("Eclipse backend only supports single- or "
+                          "double-word (i16/32-bit) return values today");
+    }
+  }
+  return Chain;
+}
+
+SDValue EclipseTargetLowering::LowerReturn(
+    SDValue Chain, CallingConv::ID /*CallConv*/, bool /*IsVarArg*/,
+    const SmallVectorImpl<ISD::OutputArg> &Outs,
+    const SmallVectorImpl<SDValue> &OutVals, const SDLoc &dl,
+    SelectionDAG &DAG) const {
+  // Returning from a variadic function is no different from any other —
+  // only the parameter list is variadic, not the return path.
+  //
+  // 2-word (32-bit) returns go out in AC0:AC1 — the register-pair
+  // counterpart to LowerCall's read-back. Confirmed empirically (not
+  // just assumed) that OutVals[0]/OutVals[1] arrive in the same order
+  // the type legalizer's own big-endian ("E" in computeDataLayout) i32
+  // splitting produces, i.e. this file doesn't choose that order itself.
+  if (Outs.size() > 2)
+    report_fatal_error("Eclipse backend only supports single- or "
+                        "double-word (i16/32-bit) return values today");
+
+  if (DAG.getMachineFunction().getFunction().hasFnAttribute("interrupt")) {
+    // Clang's Sema already rejects a non-void __attribute__((interrupt))
+    // function, so Outs is empty here — hardware interrupt entry has no
+    // return-value slot to fill anyway.
+    assert(Outs.empty() && "interrupt handler must be void");
+    return DAG.getNode(EclipseISD::RETI_FLAG, dl, MVT::Other, Chain);
+  }
+
+  SDValue Glue;
+  SmallVector<SDValue, 4> RetOps{Chain};
+  if (!OutVals.empty()) {
+    Chain = DAG.getCopyToReg(Chain, dl, Eclipse::AC0, OutVals[0], Glue);
+    Glue = Chain.getValue(1);
+    RetOps.push_back(DAG.getRegister(Eclipse::AC0, MVT::i16));
+
+    if (OutVals.size() == 2) {
+      Chain = DAG.getCopyToReg(Chain, dl, Eclipse::AC1, OutVals[1], Glue);
+      Glue = Chain.getValue(1);
+      RetOps.push_back(DAG.getRegister(Eclipse::AC1, MVT::i16));
+    }
+    RetOps[0] = Chain;
+  }
+  if (Glue.getNode())
+    RetOps.push_back(Glue);
+
+  return DAG.getNode(EclipseISD::RET_FLAG, dl, MVT::Other, RetOps);
+}
+
+//===----------------------------------------------------------------------===//
+// Custom-inserted pseudo expansion: everything that needs more than one
+// real instruction, or fixed-physical-register plumbing the DAG can't
+// express directly, is a Pseudo (see EclipseInstrInfo.td) expanded here
+// into real MachineInstrs after instruction selection.
+//===----------------------------------------------------------------------===//
+
+MachineBasicBlock *
+EclipseTargetLowering::EmitInstrWithCustomInserter(MachineInstr &MI,
+                                                    MachineBasicBlock *MBB) const {
+  switch (MI.getOpcode()) {
+  case Eclipse::Select:
+    return emitSelectCC(MI, MBB);
+  case Eclipse::SelectU:
+    return emitSelectCCU(MI, MBB);
+  case Eclipse::PUSH:
+    return emitPushPop(MI, MBB, /*IsPush*/ true);
+  case Eclipse::POP:
+    return emitPushPop(MI, MBB, /*IsPush*/ false);
+  case Eclipse::ADJCALLSTACKDOWN:
+    return emitAdjCallStack(MI, MBB, /*IsDown*/ true);
+  case Eclipse::ADJCALLSTACKUP:
+    return emitAdjCallStack(MI, MBB, /*IsDown*/ false);
+  case Eclipse::VLAALLOC:
+    return emitVLAAlloc(MI, MBB);
+  case Eclipse::STACKSAVE_PSEUDO:
+    return emitStackSave(MI, MBB);
+  case Eclipse::STACKRESTORE_PSEUDO:
+    return emitStackRestore(MI, MBB);
+  // MULrr/UDIVrr/UREMrr are handled by EclipseInstrInfo::expandPostRAPseudo
+  // instead, not here — see EclipseInstrInfo.td's comment on why they
+  // need to expand *after* register allocation.
+  case Eclipse::LDIND:
+    return emitIndirectMem(MI, MBB, /*IsLoad*/ true);
+  case Eclipse::STIND:
+    return emitIndirectMem(MI, MBB, /*IsLoad*/ false);
+  case Eclipse::LDINDW:
+    return emitIndirectMemWordAdd(MI, MBB, /*IsLoad*/ true);
+  case Eclipse::STINDW:
+    return emitIndirectMemWordAdd(MI, MBB, /*IsLoad*/ false);
+  case Eclipse::CALLIND:
+    return emitCallIndirect(MI, MBB);
+  default:
+    llvm_unreachable("unexpected custom-inserted Eclipse pseudo");
+  }
+}
+
+// Expands the `Select` pseudo into the classic two-successor diamond: test
+// the comparison value with the chosen skip-branch, copy the false operand
+// straight through on the fallthrough edge, copy the true operand in a new
+// block, and PHI the two together. Standard technique for targets with no
+// predicated/conditional-move instruction — see e.g. how SPARC/Mips
+// implement `Select` pseudos the same way.
+MachineBasicBlock *EclipseTargetLowering::emitSelectCC(MachineInstr &MI,
+                                                        MachineBasicBlock *MBB) const {
+  const auto &TII = *MBB->getParent()->getSubtarget<EclipseSubtarget>().getInstrInfo();
+  DebugLoc DL = MI.getDebugLoc();
+
+  Register Dst = MI.getOperand(0).getReg();
+  Register CmpVal = MI.getOperand(1).getReg();
+  unsigned CondOpc = MI.getOperand(2).getImm();
+  Register TrueV = MI.getOperand(3).getReg();
+  Register FalseV = MI.getOperand(4).getReg();
+
+  MachineFunction *F = MBB->getParent();
+  MachineBasicBlock *TrueMBB = F->CreateMachineBasicBlock(MBB->getBasicBlock());
+  MachineBasicBlock *MergeMBB = F->CreateMachineBasicBlock(MBB->getBasicBlock());
+  MachineFunction::iterator It = ++MBB->getIterator();
+  F->insert(It, TrueMBB);
+  F->insert(It, MergeMBB);
+
+  MergeMBB->splice(MergeMBB->begin(), MBB, std::next(MI.getIterator()), MBB->end());
+  MergeMBB->transferSuccessorsAndUpdatePHIs(MBB);
+
+  MBB->addSuccessor(TrueMBB);
+  MBB->addSuccessor(MergeMBB);
+  BuildMI(MBB, DL, TII.get(CondOpc)).addReg(CmpVal).addMBB(TrueMBB);
+  BuildMI(MBB, DL, TII.get(Eclipse::JMP)).addMBB(MergeMBB);
+
+  TrueMBB->addSuccessor(MergeMBB);
+  BuildMI(TrueMBB, DL, TII.get(Eclipse::JMP)).addMBB(MergeMBB);
+
+  BuildMI(*MergeMBB, MergeMBB->begin(), DL, TII.get(TargetOpcode::PHI), Dst)
+      .addReg(FalseV)
+      .addMBB(MBB)
+      .addReg(TrueV)
+      .addMBB(TrueMBB);
+
+  MI.eraseFromParent();
+  return MergeMBB;
+}
+
+// Same diamond shape as emitSelectCC, but CondOpc is BGEU/BLTU, which take
+// two live operands (lhs, rhs) rather than one pre-computed comparison
+// value — see EclipseISD::BGEU's comment in EclipseISelLowering.h.
+MachineBasicBlock *EclipseTargetLowering::emitSelectCCU(MachineInstr &MI,
+                                                         MachineBasicBlock *MBB) const {
+  const auto &TII = *MBB->getParent()->getSubtarget<EclipseSubtarget>().getInstrInfo();
+  DebugLoc DL = MI.getDebugLoc();
+
+  Register Dst = MI.getOperand(0).getReg();
+  Register Lhs = MI.getOperand(1).getReg();
+  Register Rhs = MI.getOperand(2).getReg();
+  unsigned CondOpc = MI.getOperand(3).getImm();
+  Register TrueV = MI.getOperand(4).getReg();
+  Register FalseV = MI.getOperand(5).getReg();
+
+  MachineFunction *F = MBB->getParent();
+  MachineBasicBlock *TrueMBB = F->CreateMachineBasicBlock(MBB->getBasicBlock());
+  MachineBasicBlock *MergeMBB = F->CreateMachineBasicBlock(MBB->getBasicBlock());
+  MachineFunction::iterator It = ++MBB->getIterator();
+  F->insert(It, TrueMBB);
+  F->insert(It, MergeMBB);
+
+  MergeMBB->splice(MergeMBB->begin(), MBB, std::next(MI.getIterator()), MBB->end());
+  MergeMBB->transferSuccessorsAndUpdatePHIs(MBB);
+
+  MBB->addSuccessor(TrueMBB);
+  MBB->addSuccessor(MergeMBB);
+  BuildMI(MBB, DL, TII.get(CondOpc)).addReg(Lhs).addReg(Rhs).addMBB(TrueMBB);
+  BuildMI(MBB, DL, TII.get(Eclipse::JMP)).addMBB(MergeMBB);
+
+  TrueMBB->addSuccessor(MergeMBB);
+  BuildMI(TrueMBB, DL, TII.get(Eclipse::JMP)).addMBB(MergeMBB);
+
+  BuildMI(*MergeMBB, MergeMBB->begin(), DL, TII.get(TargetOpcode::PHI), Dst)
+      .addReg(FalseV)
+      .addMBB(MBB)
+      .addReg(TrueV)
+      .addMBB(TrueMBB);
+
+  MI.eraseFromParent();
+  return MergeMBB;
+}
+
+// Fixed hardware stack-pointer location (040 octal) — the same one real
+// SAVE/RTN use natively (EclipseInstrInfo.td).
+static constexpr int HWStackAddr = 040;
+
+// Argument push/pop still use a software DSZABS/STABSI/LDABSI/ISZABS
+// sequence rather than real hardware push/pop instructions (this
+// backend has none besides SAVE/RTN, which are frame-management, not
+// general push/pop — see EclipseInstrInfo.td). Critically, this targets
+// the *same* fixed hardware stack-pointer location SAVE/RTN themselves
+// use natively — not a separate `_SP` variable — so argument pushes for
+// a call made from inside a function's own body never drift out of
+// sync with, or overlap, whatever hardware location that function's own
+// SAVE-established frame is using.
+//
+// Direction matters and is easy to get backwards: real SAVE grows the
+// stack *upward* (it increments 040 before storing each pushed word —
+// see EclipseInstrInfo.td's SAVE comment and simh's eclipse_cpu.c, the
+// actual reference this was verified against), the *opposite* direction
+// from the old purely-software `_SP` stack this replaced, which grew
+// downward. Push here must therefore increment-then-store (ISZABS, not
+// DSZABS) and pop must load-then-decrement (then DSZABS, not ISZABS) —
+// getting this wrong doesn't fail loudly, it silently pushes arguments
+// in the wrong direction relative to (and colliding with) whatever the
+// caller's own SAVE-established frame just reserved, confirmed via a
+// real repro: a call's arguments read back as whatever the callee's own
+// prologue happened to leave at that address instead.
+MachineBasicBlock *EclipseTargetLowering::emitPushPop(MachineInstr &MI,
+                                                       MachineBasicBlock *MBB,
+                                                       bool IsPush) const {
+  const auto &TII = *MBB->getParent()->getSubtarget<EclipseSubtarget>().getInstrInfo();
+  DebugLoc DL = MI.getDebugLoc();
+  if (IsPush) {
+    Register Src = MI.getOperand(0).getReg();
+    BuildMI(*MBB, MI, DL, TII.get(Eclipse::ISZABS)).addImm(HWStackAddr);
+    BuildMI(*MBB, MI, DL, TII.get(Eclipse::STABSI))
+        .addReg(Src)
+        .addImm(HWStackAddr);
+  } else {
+    Register Dst = MI.getOperand(0).getReg();
+    BuildMI(*MBB, MI, DL, TII.get(Eclipse::LDABSI), Dst).addImm(HWStackAddr);
+    BuildMI(*MBB, MI, DL, TII.get(Eclipse::DSZABS)).addImm(HWStackAddr);
+  }
+  MI.eraseFromParent();
+  return MBB;
+}
+
+MachineBasicBlock *EclipseTargetLowering::emitAdjCallStack(MachineInstr &MI,
+                                                            MachineBasicBlock *MBB,
+                                                            bool IsDown) const {
+  const auto &TII = *MBB->getParent()->getSubtarget<EclipseSubtarget>().getInstrInfo();
+  DebugLoc DL = MI.getDebugLoc();
+  int64_t Words = MI.getOperand(0).getImm();
+  // Same increment-to-reserve/decrement-to-release direction as
+  // emitPushPop above, for the same reason (matching real SAVE's own
+  // upward growth) — see that function's comment.
+  unsigned Opc = IsDown ? Eclipse::ISZABS : Eclipse::DSZABS;
+  for (int64_t i = 0; i < Words; ++i)
+    BuildMI(*MBB, MI, DL, TII.get(Opc)).addImm(HWStackAddr);
+  MI.eraseFromParent();
+  return MBB;
+}
+
+// MUL/UDIV/UREM are expanded post-register-allocation instead — see
+// EclipseInstrInfo::expandPostRAPseudo and EclipseInstrInfo.td's comment
+// on why (this pseudo temporarily repurposes AC2, our frame pointer, and
+// that's only safe once nothing else can be scheduled or spilled into
+// the middle of it — a real, verified-the-hard-way bug when this used to
+// be a pre-RA custom-insertion here instead).
+
+MachineBasicBlock *EclipseTargetLowering::emitIndirectMem(MachineInstr &MI,
+                                                           MachineBasicBlock *MBB,
+                                                           bool IsLoad) const {
+  const auto &TII = *MBB->getParent()->getSubtarget<EclipseSubtarget>().getInstrInfo();
+  DebugLoc DL = MI.getDebugLoc();
+  if (IsLoad) {
+    Register Dst = MI.getOperand(0).getReg();
+    Register Addr = MI.getOperand(1).getReg();
+    BuildMI(*MBB, MI, DL, TII.get(Eclipse::STABS)).addReg(Addr).addExternalSymbol("_scratch");
+    BuildMI(*MBB, MI, DL, TII.get(Eclipse::LDABSI), Dst).addExternalSymbol("_scratch");
+  } else {
+    Register Src = MI.getOperand(0).getReg();
+    Register Addr = MI.getOperand(1).getReg();
+    BuildMI(*MBB, MI, DL, TII.get(Eclipse::STABS)).addReg(Addr).addExternalSymbol("_scratch");
+    BuildMI(*MBB, MI, DL, TII.get(Eclipse::STABSI)).addReg(Src).addExternalSymbol("_scratch");
+  }
+  MI.eraseFromParent();
+  return MBB;
+}
+
+// LDINDW/STINDW: the EclipseWordAdd-address-specific counterpart to
+// emitIndirectMem above -- see EclipseInstrInfo.td's LDINDW/STINDW
+// comment and DEBUGGING_NOTES.md entry #26 for why this needs its own
+// page-zero word (`_scratch2`) rather than reusing emitIndirectMem's
+// `_scratch` directly. $base/$off arrive as two still-separate operands
+// (PerformDAGCombine deliberately leaves them split -- see
+// EclipseWordAdd's own comment in EclipseInstrInfo.td), so this adds
+// them into a *fresh* virtual register first (an ordinary tied-operand
+// ADDrr, exactly like every other two-address accumulate in this file --
+// see e.g. LEAFI's own expansion in EclipseRegisterInfo.cpp -- never
+// reusing $base's or $off's own register in place, since either one may
+// still have other uses elsewhere in the DAG), then indirects through
+// `_scratch2` exactly like emitIndirectMem does through `_scratch`.
+MachineBasicBlock *
+EclipseTargetLowering::emitIndirectMemWordAdd(MachineInstr &MI,
+                                               MachineBasicBlock *MBB,
+                                               bool IsLoad) const {
+  const auto &TII = *MBB->getParent()->getSubtarget<EclipseSubtarget>().getInstrInfo();
+  MachineRegisterInfo &MRI = MBB->getParent()->getRegInfo();
+  DebugLoc DL = MI.getDebugLoc();
+  if (IsLoad) {
+    Register Dst = MI.getOperand(0).getReg();
+    Register Base = MI.getOperand(1).getReg();
+    Register Off = MI.getOperand(2).getReg();
+    Register Addr = MRI.createVirtualRegister(&Eclipse::GPRRegClass);
+    BuildMI(*MBB, MI, DL, TII.get(Eclipse::ADDrr), Addr).addReg(Off).addReg(Base);
+    BuildMI(*MBB, MI, DL, TII.get(Eclipse::STABS)).addReg(Addr).addExternalSymbol("_scratch2");
+    BuildMI(*MBB, MI, DL, TII.get(Eclipse::LDABSI), Dst).addExternalSymbol("_scratch2");
+  } else {
+    Register Src = MI.getOperand(0).getReg();
+    Register Base = MI.getOperand(1).getReg();
+    Register Off = MI.getOperand(2).getReg();
+    Register Addr = MRI.createVirtualRegister(&Eclipse::GPRRegClass);
+    BuildMI(*MBB, MI, DL, TII.get(Eclipse::ADDrr), Addr).addReg(Off).addReg(Base);
+    BuildMI(*MBB, MI, DL, TII.get(Eclipse::STABS)).addReg(Addr).addExternalSymbol("_scratch2");
+    BuildMI(*MBB, MI, DL, TII.get(Eclipse::STABSI)).addReg(Src).addExternalSymbol("_scratch2");
+  }
+  MI.eraseFromParent();
+  return MBB;
+}
+
+// Indirect call through a runtime function-pointer value -- see
+// EclipseInstrInfo.td's CALLIND/CALLIND_JSR comments for the full ISA
+// research (JSR has no register-target addressing mode on real Nova/
+// Eclipse hardware, only direct/indexed/memory-indirect, confirmed against
+// eclipseemu below). Same store-into-`_scratch`-then-indirect shape as
+// emitIndirectMem above, just for control flow (JSR) instead of data
+// (LDA/STA): $func's value gets stashed in the shared page-zero `_scratch`
+// word, then CALLIND_JSR ("JSR @_scratch,0") reads it back as the jump
+// target. CALLIND_JSR itself (not this pseudo) carries the real
+// isCall/Defs/Uses flags the register allocator needs to see.
+MachineBasicBlock *
+EclipseTargetLowering::emitCallIndirect(MachineInstr &MI,
+                                         MachineBasicBlock *MBB) const {
+  const auto &TII = *MBB->getParent()->getSubtarget<EclipseSubtarget>().getInstrInfo();
+  DebugLoc DL = MI.getDebugLoc();
+  Register Func = MI.getOperand(0).getReg();
+  BuildMI(*MBB, MI, DL, TII.get(Eclipse::STABS)).addReg(Func).addExternalSymbol("_scratch");
+  BuildMI(*MBB, MI, DL, TII.get(Eclipse::CALLIND_JSR));
+  MI.eraseFromParent();
+  return MBB;
+}
+
+// Variable-length array support (EclipseInstrInfo.td's VLAALLOC pseudo).
+// Reserves $wordcount more words on the same hardware stack pointer
+// (memory location 040) SAVE/RTN and the push/pop machinery above all
+// share -- no explicit deallocation is ever needed at scope exit or
+// function return, for the same reason ordinary locals need none: real
+// RTN resets 040 straight from the frame pointer (memory location 041)
+// unconditionally, discarding *everything* above it -- the VLA's words
+// included -- in the same single step that already discards ordinary
+// locals and temps (see EclipseFrameLowering.cpp's emitEpilogue).
+//
+// $dst comes back holding mem[040]'s value from *before* this
+// reservation (the old top-of-stack) -- not yet a safe pointer into the
+// newly reserved range on its own, since real SAVE/the push mechanism
+// above both grow this stack by incrementing *before* using a location,
+// meaning the old value is still "in use" by whatever's immediately
+// below it. LowerDYNAMIC_STACKALLOC (below) adds 1 to it afterward, as
+// a plain ordinary ADD reaching normal ISel and register allocation,
+// deliberately *outside* this hand-built expansion: doing the +1 in
+// here too would need a third scratch register/constant, and only
+// GPR:$dst/$wordcount (AC0/AC1, the only two allocatable registers) are
+// available -- both already spoken for by the reservation logic below.
+//
+// $wordcount is consumed, not preserved: ADDrr's "$dst = $dstin" tied-
+// operand constraint means this instruction destructively overwrites
+// whichever physical register $wordcount was allocated to.
+MachineBasicBlock *EclipseTargetLowering::emitVLAAlloc(MachineInstr &MI,
+                                                        MachineBasicBlock *MBB) const {
+  MachineFunction &MF = *MBB->getParent();
+  const auto &TII = *MF.getSubtarget<EclipseSubtarget>().getInstrInfo();
+  MachineRegisterInfo &MRI = MF.getRegInfo();
+  DebugLoc DL = MI.getDebugLoc();
+  Register Dst = MI.getOperand(0).getReg();
+  Register WordCount = MI.getOperand(1).getReg();
+
+  // Dst := mem[040]'s own value (the current stack-pointer address
+  // itself, to use as a base pointer) -- LDABS (direct: "LDA $dst,$addr"
+  // = mem[$addr]), *not* LDABSI (indirect: "LDA $dst,@$addr" =
+  // mem[mem[$addr]], the "dereference through the pointer to retrieve
+  // whatever data was pushed there" semantics emitPushPop's own POP
+  // path correctly wants, but wrong here -- caught via code review
+  // before this ever ran against real data (the first attempt at
+  // this function crashed earlier, on an unrelated STACKSAVE/
+  // STACKRESTORE gap, before reaching a point where the wrong
+  // address would have shown up as corrupted data).
+  BuildMI(*MBB, MI, DL, TII.get(Eclipse::LDABS), Dst).addImm(HWStackAddr);
+  // NewTop := WordCount + Dst (== old-top + word-count == the new
+  // top-of-stack value once this reservation is committed). A *fresh*
+  // virtual register, not WordCount itself reused as its own tied
+  // output: ADDrr's "$dst = $dstin" constraint only means the
+  // *register allocator* should try to coalesce them onto the same
+  // physical register later -- at this pre-RA stage every virtual
+  // register still needs exactly one definition, and WordCount already
+  // has one (whatever computed it before this pseudo). Reusing it here
+  // gave it a second, hitting MachineRegisterInfo::getVRegDef's "at
+  // most one definition" assertion -- confirmed the hard way, this
+  // exact mistake crashed here first.
+  Register NewTop = MRI.createVirtualRegister(&Eclipse::GPRRegClass);
+  BuildMI(*MBB, MI, DL, TII.get(Eclipse::ADDrr), NewTop)
+      .addReg(Dst)
+      .addReg(WordCount);
+  // Commit: mem[040] := NewTop (the new top-of-stack).
+  BuildMI(*MBB, MI, DL, TII.get(Eclipse::STABS))
+      .addReg(NewTop)
+      .addImm(HWStackAddr);
+
+  MI.eraseFromParent();
+  return MBB;
+}
+
+// llvm.stacksave: Dst := mem[040]'s own value (direct LDABS, matching
+// emitVLAAlloc's own comment on LDABS-vs-LDABSI just above -- this is
+// the address value itself, not something to dereference through).
+MachineBasicBlock *EclipseTargetLowering::emitStackSave(MachineInstr &MI,
+                                                         MachineBasicBlock *MBB) const {
+  const auto &TII = *MBB->getParent()->getSubtarget<EclipseSubtarget>().getInstrInfo();
+  DebugLoc DL = MI.getDebugLoc();
+  Register Dst = MI.getOperand(0).getReg();
+  BuildMI(*MBB, MI, DL, TII.get(Eclipse::LDABS), Dst).addImm(HWStackAddr);
+  MI.eraseFromParent();
+  return MBB;
+}
+
+// llvm.stackrestore: mem[040] := Src (direct STABS -- overwrite the
+// hardware stack pointer outright with a previously-saved value,
+// discarding everything allocated since, VLA words included, exactly
+// like RTN's own unconditional SP := FP reset does at function return
+// -- see EclipseFrameLowering.cpp's emitEpilogue).
+MachineBasicBlock *EclipseTargetLowering::emitStackRestore(MachineInstr &MI,
+                                                            MachineBasicBlock *MBB) const {
+  const auto &TII = *MBB->getParent()->getSubtarget<EclipseSubtarget>().getInstrInfo();
+  DebugLoc DL = MI.getDebugLoc();
+  Register Src = MI.getOperand(0).getReg();
+  BuildMI(*MBB, MI, DL, TII.get(Eclipse::STABS)).addReg(Src).addImm(HWStackAddr);
+  MI.eraseFromParent();
+  return MBB;
+}
