diff --git a/clang/lib/CodeGen/Targets/Eclipse.cpp b/clang/lib/CodeGen/Targets/Eclipse.cpp
new file mode 100644
index 000000000..3c79c9498
--- /dev/null
+++ b/clang/lib/CodeGen/Targets/Eclipse.cpp
@@ -0,0 +1,50 @@
+//===- Eclipse.cpp --------------------------------------------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM
+// Exceptions. See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// ABI lowering for the Data General Nova/Eclipse target. There's no
+// per-target struct/complex-type classification here — every C-level
+// argument and return value is just whatever DefaultABIInfo's generic
+// size-based classification decides (direct for small scalars, indirect
+// for large aggregates), matching how lib/Target/Eclipse's own calling
+// convention has no argument registers to allocate specially in the
+// first place (every argument is pushed on the software stack — see
+// docs/CALLING_CONVENTION.md in the sibling eccc project).
+//
+//===----------------------------------------------------------------------===//
+
+#include "ABIInfoImpl.h"
+#include "TargetInfo.h"
+
+using namespace clang;
+using namespace clang::CodeGen;
+
+namespace {
+class EclipseTargetCodeGenInfo : public TargetCodeGenInfo {
+public:
+  EclipseTargetCodeGenInfo(CodeGenTypes &CGT)
+      : TargetCodeGenInfo(std::make_unique<DefaultABIInfo>(CGT)) {}
+
+  void setTargetAttributes(const Decl *D, llvm::GlobalValue *GV,
+                            CodeGen::CodeGenModule &CGM) const override {
+    if (GV->isDeclaration())
+      return;
+    const auto *FD = dyn_cast_or_null<FunctionDecl>(D);
+    if (!FD)
+      return;
+    auto *Fn = cast<llvm::Function>(GV);
+
+    if (FD->getAttr<EclipseInterruptAttr>())
+      Fn->addFnAttr("interrupt");
+  }
+};
+} // namespace
+
+std::unique_ptr<TargetCodeGenInfo>
+CodeGen::createEclipseTargetCodeGenInfo(CodeGenModule &CGM) {
+  return std::make_unique<EclipseTargetCodeGenInfo>(CGM.getTypes());
+}
