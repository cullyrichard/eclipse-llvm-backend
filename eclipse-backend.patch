+#include "llvm/MC/TargetRegistry.h"
+#include "llvm/Support/Compiler.h"
+
+using namespace llvm;
+
+Target &llvm::getTheEclipseTarget() {
+  static Target TheEclipseTarget;
+  return TheEclipseTarget;
