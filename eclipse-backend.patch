diff --git a/llvm/lib/Target/Eclipse/Eclipse.td b/llvm/lib/Target/Eclipse/Eclipse.td
new file mode 100644
index 000000000..a0154fe9c
--- /dev/null
+++ b/llvm/lib/Target/Eclipse/Eclipse.td
@@ -0,0 +1,105 @@
+//===- Eclipse.td - Describe the Eclipse Target Machine ---*- tablegen -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM
+// Exceptions. See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+include "llvm/Target/Target.td"
+
+include "EclipseRegisterInfo.td"
+include "EclipseInstrInfo.td"
+
+defm : RemapAllTargetPseudoPointerOperands<GPR>;
+
+def EclipseInstrInfo : InstrInfo;
+
+// Real Eclipse S/140 hardware FPU (FAS/FSS -- add and subtract on the
+// CPU-native IBM-360-style hex-float FPAC registers) instead of this
+// target's original, always-available software float implementation
+// (__addsf3/__subsf3 etc. in eclipse_rt.c). See
+// EclipseSubtarget.cpp's initLibcallLoweringInfo and
+// EclipseISelLowering.cpp's constructor for where this actually changes
+// which libcall implementation gets selected, and DEBUGGING_NOTES.md in
+// the eclipse-package repo for the reverse-engineered hardware format
+// and the eclipseemu verification this feature is based on.
+//
+// As of DEBUGGING_NOTES.md entry #30, hardware add/subtract is this
+// target's DEFAULT (see FeatureIEEEFloat below for the opt-out) --
+// FeatureHWFloat itself is unchanged (still just "select the hardware
+// FAS/FSS-based ADD_F32/SUB_F32 impl instead of the software one") and
+// stays available as a direct `-mattr=+hwfloat` lever, but the only
+// caller that still needs to pass it explicitly is eclipse-cc's
+// `--hwfloat` flag preserving *its* own pre-entry-#30 meaning exactly
+// (see FeatureIEEEFloat) -- see EclipseSubtarget.cpp for the exact
+// UseHW = !HasIEEEFloat || HasHWFloat selection logic this feeds.
+//
+// Multiply/divide (FMS/FDS) were re-probed fresh for entry #30 with a
+// clean, assumption-free harness and reconfirmed genuinely broken on
+// eclipseemu: both operand orderings, several operand-register
+// combinations, always leave the destination FPAC at exactly zero --
+// not covered by this feature; software libcalls remain the only path
+// for MUL_F32/DIV_F32 regardless of this feature's setting.
+//
+// int<->float conversion (FLAS/FFAS), by contrast, turned out to be
+// reliable on eclipseemu once probed with the right operand-order
+// hypothesis (FLAS srcAC,dstFPAC; FFAS dstAC,srcFPAC -- confirmed
+// across every AC/FPAC register combination tried) -- entry #27's
+// original "operand-encoding-dependent, inconsistent" verdict was a
+// probing mistake (loading the wrong AC register), not a real hardware
+// limitation; see entry #30 for the full re-derivation. Left unused
+// here anyway: FLAS/FFAS only convert a single 16-bit AC, and this
+// target's SINTTOFP_I32_F32/FPTOSINT_F32_I32 libcalls need a genuine
+// 32-bit `long`, which would need extra (unverified, and multiply/
+// divide-adjacent, given FMS/FDS's own state) logic to combine two
+// 16-bit halves -- flagged as a real, well-scoped follow-up opportunity
+// rather than forced into this entry.
+def FeatureHWFloat : SubtargetFeature<"hwfloat", "HasHWFloat", "true",
+  "Use real Eclipse S/140 hardware FPU instructions (FAS/FSS) for "
+  "float add/subtract instead of software libcalls">;
+
+// Opt OUT of this target's default (DEBUGGING_NOTES.md entry #30) DG
+// hardware-float behavior and get this target's *original* behavior
+// back instead: pure IEEE-754 float everywhere (software arithmetic
+// unless FeatureHWFloat is *also* set, in which case it's exactly
+// today's pre-entry-#30 `--hwfloat`: IEEE-754 ABI/storage with only
+// add/subtract hardware-accelerated), including the pre-existing,
+// unrelated bug where a file-scope/`static` `float`/`double` global
+// initializer silently materializes as 0 (EclipseAsmPrinter.cpp's
+// emitGlobalVariable has no ConstantFP case at all -- see entry #27
+// point 9 and entry #30's own fix, gated to apply only when this
+// feature is OFF, specifically so `+ieee` stays byte-for-byte identical
+// to every pre-entry-#30 build). `eclipse-cc --hwfloat` sets both
+// `+hwfloat` and `+ieee` together for exactly this reason -- see that
+// script's own comment. OFF by default, i.e. the DEFAULT behavior with
+// NO flags at all is now hardware-accelerated add/subtract (see
+// FeatureHWFloat above) plus the global-initializer fix; passing
+// `-mattr=+ieee` (llc) / `--ieee` (eclipse-cc) restores this target's
+// entire original, pre-entry-#30 default exactly -- see
+// EclipseSubtarget.cpp's initLibcallLoweringInfo and
+// EclipseAsmPrinter.cpp's emitGlobalVariable for where this is actually
+// read, and DEBUGGING_NOTES.md entry #30 for the full design rationale
+// (in particular: why a truly native, end-to-end DG hex-float *ABI* --
+// the original ask this entry set out to build -- turned out to be
+// infeasible without patching common, target-agnostic LLVM
+// infrastructure, LegalizeFloatTypes.cpp's SoftenFloatRes_ConstantFP
+// specifically, and why this feature's actual scope is narrower than
+// that as a result).
+def FeatureIEEEFloat : SubtargetFeature<"ieee", "HasIEEEFloat", "true",
+  "Opt out of this target's default DG-hardware-accelerated float "
+  "behavior and restore its original pure-IEEE-754 behavior (software "
+  "arithmetic, or FeatureHWFloat's narrower hardware add/subtract if "
+  "also set)">;
+
+def : ProcessorModel<"generic", NoSchedModel, []>;
+
+def EclipseInstPrinter : AsmWriter {
+  string AsmWriterClassName = "InstPrinter";
+  bit isMCAsmWriter = 1;
+}
+
+def Eclipse : Target {
+  let InstructionSet = EclipseInstrInfo;
+  let AssemblyWriters = [EclipseInstPrinter];
+}
