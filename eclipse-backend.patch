+
+#include "llvm/CodeGen/TargetRegisterInfo.h"
+
+#define GET_REGINFO_HEADER
+#include "EclipseGenRegisterInfo.inc"
+
+namespace llvm {
+
+struct EclipseRegisterInfo : public EclipseGenRegisterInfo {
+  EclipseRegisterInfo();
+
+  const MCPhysReg *
+  getCalleeSavedRegs(const MachineFunction *MF) const override;
+  BitVector getReservedRegs(const MachineFunction &MF) const override;
+
+  bool eliminateFrameIndex(MachineBasicBlock::iterator MI, int SPAdj,
+                            unsigned FIOperandNum,
+                            RegScavenger *RS = nullptr) const override;
+
+  Register getFrameRegister(const MachineFunction &MF) const override;
+
+  // LEAFI's post-regalloc expansion (see eliminateFrameIndex) needs a
+  // genuine scratch physical register it can't just conjure. Both flags
+  // are required together: requiresRegisterScavenging is what actually
+  // gets PEI to construct a RegScavenger at all; requiresFrameIndexScavenging
+  // is what tells it to run that scavenger over the virtual registers
+  // eliminateFrameIndex leaves behind (see PrologEpilogInserter.cpp).
+  bool requiresRegisterScavenging(const MachineFunction &MF) const override {
+    return true;
+  }
+  bool requiresFrameIndexScavenging(const MachineFunction &MF) const override {
+    return true;
+  }
+};
+
+} // namespace llvm
