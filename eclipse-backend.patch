diff --git a/llvm/lib/Target/Eclipse/EclipseRegisterInfo.td b/llvm/lib/Target/Eclipse/EclipseRegisterInfo.td
new file mode 100644
index 000000000..fb7731dbb
--- /dev/null
+++ b/llvm/lib/Target/Eclipse/EclipseRegisterInfo.td
@@ -0,0 +1,42 @@
+//===- EclipseRegisterInfo.td - Eclipse Register defs -----*- tablegen -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM
+// Exceptions. See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// The Nova/Eclipse has exactly four 16-bit accumulators, AC0-AC3, encoded in
+// a 2-bit field in every instruction that names one. There is no separate
+// general-purpose register file distinct from the accumulators, and no
+// condition-code register: comparisons are synthesized from a subtraction
+// plus a "skip next word if AC is zero/non-negative" test on an accumulator
+// (see docs/CALLING_CONVENTION.md in the eccc project this backend's ISA
+// knowledge comes from).
+//
+// AC2 and AC3 are permanently reserved by this backend's calling convention
+// (mirroring the sibling `eccc` Rust compiler's own proven convention,
+// verified against a real simulator):
+//   AC2 = frame pointer (FP) for the currently executing function.
+//   AC3 = clobbered by JSR (holds the return address); saved/restored by
+//         every non-leaf function's prologue/epilogue.
+// so only AC0/AC1 are available to the register allocator as scratch.
+//===----------------------------------------------------------------------===//
+
+class EclipseReg<bits<2> num, string n> : Register<n> {
+  field bits<2> Num;
+  let Num = num;
+  let Namespace = "Eclipse";
+}
+
+def AC0 : EclipseReg<0, "0">, DwarfRegNum<[0]>;
+def AC1 : EclipseReg<1, "1">, DwarfRegNum<[1]>;
+def AC2 : EclipseReg<2, "2">, DwarfRegNum<[2]>;
+def AC3 : EclipseReg<3, "3">, DwarfRegNum<[3]>;
+
+// Every Nova/Eclipse word (and hence every accumulator) is 16 bits.
+// AC0/AC1 listed first: the register allocator tries registers in list
+// order, and AC2/AC3 are marked reserved in EclipseRegisterInfo.cpp anyway,
+// but listing the actually-allocatable pair first keeps allocation output
+// readable.
+def GPR : RegisterClass<"Eclipse", [i16], 16, (add AC0, AC1, AC2, AC3)>;
