+  let Heading = "interrupt (Eclipse)";
+  let Content = [{
+Clang supports the GNU style ``__attribute__((interrupt))`` attribute on
+Eclipse S/140 targets. This attribute may be attached to a function
+definition and instructs the backend to generate entry/exit code matching
+the real hardware interrupt convention (saving every register the handler
+body touches, and returning via the interrupt-specific return sequence
+rather than an ordinary function return) so it can be used directly as the
+target of the interrupt vector at memory location 1.
+
+A function with this attribute must return ``void`` and take no parameters,
+matching the fact that hardware interrupt entry passes no arguments and
+uses no return value.
+  }];
