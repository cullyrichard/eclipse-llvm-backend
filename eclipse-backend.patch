@@ -0,0 +1,308 @@
+//===-- EclipseInstrInfo.cpp - Eclipse Instruction Information ----------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM
+// Exceptions. See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "EclipseInstrInfo.h"
+#include "EclipseSubtarget.h"
+#include "llvm/CodeGen/MachineFrameInfo.h"
+#include "llvm/CodeGen/MachineInstrBuilder.h"
+#include "llvm/CodeGen/MachineRegisterInfo.h"
+
+#define GET_INSTRINFO_CTOR_DTOR
+#include "EclipseGenInstrInfo.inc"
+
+using namespace llvm;
+
+EclipseInstrInfo::EclipseInstrInfo(const EclipseSubtarget &STI)
+    : EclipseGenInstrInfo(STI, RegisterInfo, Eclipse::ADJCALLSTACKDOWN,
+                           Eclipse::ADJCALLSTACKUP),
+      RegisterInfo() {}
+
+void EclipseInstrInfo::copyPhysReg(MachineBasicBlock &MBB,
+                                    MachineBasicBlock::iterator I,
+                                    const DebugLoc &DL, Register DestReg,
+                                    Register SrcReg, bool KillSrc,
+                                    bool /*RenamableDest*/,
+                                    bool /*RenamableSrc*/) const {
+  BuildMI(MBB, I, DL, get(Eclipse::MOVrr), DestReg)
+      .addReg(SrcReg, getKillRegState(KillSrc));
+}
+
+void EclipseInstrInfo::storeRegToStackSlot(
+    MachineBasicBlock &MBB, MachineBasicBlock::iterator I, Register SrcReg,
+    bool IsKill, int FrameIndex, const TargetRegisterClass * /*RC*/,
+    Register /*VReg*/, MachineInstr::MIFlag Flags) const {
+  DebugLoc DL = I != MBB.end() ? I->getDebugLoc() : DebugLoc();
+  BuildMI(MBB, I, DL, get(Eclipse::STFI))
+      .addReg(SrcReg, getKillRegState(IsKill))
+      .addFrameIndex(FrameIndex)
+      .setMIFlags(Flags);
+}
+
+void EclipseInstrInfo::loadRegFromStackSlot(
+    MachineBasicBlock &MBB, MachineBasicBlock::iterator I, Register DestReg,
+    int FrameIndex, const TargetRegisterClass * /*RC*/, Register /*VReg*/,
+    unsigned /*SubReg*/, MachineInstr::MIFlag Flags) const {
+  DebugLoc DL = I != MBB.end() ? I->getDebugLoc() : DebugLoc();
+  BuildMI(MBB, I, DL, get(Eclipse::LDFI), DestReg)
+      .addFrameIndex(FrameIndex)
+      .setMIFlags(Flags);
+}
+
+static bool isCondBranchOpcode(unsigned Opc) {
+  switch (Opc) {
+  case Eclipse::BRZ:
+  case Eclipse::BRNZ:
+  case Eclipse::BGEZ:
+  case Eclipse::BLTZ:
+    return true;
+  default:
+    return false;
+  }
+}
+
+bool EclipseInstrInfo::analyzeBranch(MachineBasicBlock &MBB,
+                                      MachineBasicBlock *&TBB,
+                                      MachineBasicBlock *&FBB,
+                                      SmallVectorImpl<MachineOperand> &Cond,
+                                      bool /*AllowModify*/) const {
+  MachineBasicBlock::iterator I = MBB.end();
+  if (I == MBB.begin())
+    return false;
+  --I;
+  while (I->isDebugInstr()) {
+    if (I == MBB.begin())
+      return false;
+    --I;
+  }
+  if (!I->isTerminator())
+    return false;
+
+  MachineInstr *LastInst = &*I;
+  if (I == MBB.begin() || !std::prev(I)->isTerminator()) {
+    if (LastInst->getOpcode() == Eclipse::JMP) {
+      TBB = LastInst->getOperand(0).getMBB();
+      return false;
+    }
+    if (isCondBranchOpcode(LastInst->getOpcode())) {
+      TBB = LastInst->getOperand(1).getMBB();
+      Cond.push_back(MachineOperand::CreateImm(LastInst->getOpcode()));
+      Cond.push_back(LastInst->getOperand(0));
+      return false;
+    }
+    return true; // Unanalyzable (e.g. RET).
+  }
+
+  MachineInstr *SecondLastInst = &*std::prev(I);
+  if (isCondBranchOpcode(SecondLastInst->getOpcode()) &&
+      LastInst->getOpcode() == Eclipse::JMP) {
+    TBB = SecondLastInst->getOperand(1).getMBB();
+    Cond.push_back(MachineOperand::CreateImm(SecondLastInst->getOpcode()));
+    Cond.push_back(SecondLastInst->getOperand(0));
+    FBB = LastInst->getOperand(0).getMBB();
+    return false;
+  }
+
+  return true; // Unanalyzable pair.
+}
+
+unsigned EclipseInstrInfo::removeBranch(MachineBasicBlock &MBB,
+                                         int *BytesRemoved) const {
+  assert(!BytesRemoved && "code size not tracked");
+  MachineBasicBlock::iterator I = MBB.end();
+  unsigned Count = 0;
+  while (I != MBB.begin()) {
+    --I;
+    if (I->isDebugInstr())
+      continue;
+    if (I->getOpcode() != Eclipse::JMP && !isCondBranchOpcode(I->getOpcode()))
+      break;
+    I->eraseFromParent();
+    I = MBB.end();
+    ++Count;
+  }
+  return Count;
+}
+
+unsigned EclipseInstrInfo::insertBranch(MachineBasicBlock &MBB,
+                                         MachineBasicBlock *TBB,
+                                         MachineBasicBlock *FBB,
+                                         ArrayRef<MachineOperand> Cond,
+                                         const DebugLoc &DL,
+                                         int *BytesAdded) const {
+  assert(!BytesAdded && "code size not tracked");
+  assert(Cond.size() == 2 || Cond.empty());
+
+  if (Cond.empty()) {
+    assert(!FBB && "unconditional branch with multiple successors");
+    BuildMI(&MBB, DL, get(Eclipse::JMP)).addMBB(TBB);
+    return 1;
+  }
+
+  unsigned CondOpc = Cond[0].getImm();
+  BuildMI(&MBB, DL, get(CondOpc)).add(Cond[1]).addMBB(TBB);
+  if (!FBB)
+    return 1;
+  BuildMI(&MBB, DL, get(Eclipse::JMP)).addMBB(FBB);
+  return 2;
+}
+
+bool EclipseInstrInfo::reverseBranchCondition(
+    SmallVectorImpl<MachineOperand> &Cond) const {
+  assert(Cond.size() == 2);
+  switch (Cond[0].getImm()) {
+  case Eclipse::BRZ:
+    Cond[0].setImm(Eclipse::BRNZ);
+    return false;
+  case Eclipse::BRNZ:
+    Cond[0].setImm(Eclipse::BRZ);
+    return false;
+  case Eclipse::BGEZ:
+    Cond[0].setImm(Eclipse::BLTZ);
+    return false;
+  case Eclipse::BLTZ:
+    Cond[0].setImm(Eclipse::BGEZ);
+    return false;
+  default:
+    llvm_unreachable("unknown Eclipse conditional branch opcode");
+  }
+}
+
+// MUL/DIV are zero-operand hardware instructions operating implicitly on
+// AC0:AC1:AC2 (see docs/ECLIPSE_ISA_NOTES.md — "MUL is a
+// multiply-*accumulate*" — in the sibling eccc project, and
+// EclipseInstrInfo.td's MUL/DIV comment). AC2 is our frame pointer, so it
+// has to be saved and restored around this — via the software stack
+// (`_SP`), exactly like eccc's func.rs, *not* a spare register, since
+// that's what stays valid (absolute/indirect addressing, not
+// frame-relative) throughout the window where AC2 doesn't mean "FP".
+//
+// This expansion deliberately runs post-RA (see the .td comment): MI's
+// operands are already physical registers by this point, and — the
+// entire reason this is a post-RA expansion rather than
+// EmitInstrWithCustomInserter — nothing else can be scheduled or
+// spilled into the middle of it anymore.
+// Fixed hardware stack-pointer location (040 octal) — the same one real
+// SAVE/RTN use natively (see EclipseInstrInfo.td's SAVE/RET comments and
+// EclipseAsmPrinter.cpp's _start initialization), not a separate `_SP`
+// software variable: AC2 has to come off the frame pointer here (MUL/DIV
+// clobber AC0:AC1:AC2), and using the same hardware-recognized location
+// for that save/restore keeps it from ever drifting out of sync with
+// whatever SAVE/RTN or argument push/pop are doing to the real stack
+// pointer at the same time.
+static const int HWStackAddr = 040;
+
+bool EclipseInstrInfo::expandPostRAPseudo(MachineInstr &MI) const {
+  unsigned Opc = MI.getOpcode();
+
+  if (Opc == Eclipse::RETI) {
+    // Interrupt return: NIOS 077 (re-enable interrupts) immediately
+    // followed by JMP @0 (resume via the PC hardware saved at memory
+    // location 0). Expanded here, post-RA, so nothing can be scheduled or
+    // spilled between the two — see this pseudo's .td comment.
+    MachineBasicBlock &MBB = *MI.getParent();
+    DebugLoc DL = MI.getDebugLoc();
+    BuildMI(MBB, MI, DL, get(Eclipse::INTEN));
+    BuildMI(MBB, MI, DL, get(Eclipse::JMPABSI)).addImm(0);
+    MI.eraseFromParent();
+    return true;
+  }
+
+  if (Opc != Eclipse::MULrr && Opc != Eclipse::UDIVrr &&
+      Opc != Eclipse::UREMrr && Opc != Eclipse::UDIVREMrr)
+    return false;
+
+  MachineBasicBlock &MBB = *MI.getParent();
+  DebugLoc DL = MI.getDebugLoc();
+
+  // UDIVREMrr has a different operand shape (two outputs, no single
+  // $dst) from MULrr/UDIVrr/UREMrr's one -- see EclipseInstrInfo.td's
+  // UDIVREMrr comment for why this exists at all (the real fix for the
+  // "quotient and remainder of the same operands, needed live
+  // simultaneously, corrupt one of the two results" bug).
+  bool IsDivRem = Opc == Eclipse::UDIVREMrr;
+  Register Dst, Quot, Rem;
+  Register LHS, RHS;
+  if (IsDivRem) {
+    Quot = MI.getOperand(0).getReg();
+    Rem = MI.getOperand(1).getReg();
+    LHS = MI.getOperand(2).getReg();
+    RHS = MI.getOperand(3).getReg();
+  } else {
+    Dst = MI.getOperand(0).getReg();
+    LHS = MI.getOperand(1).getReg();
+    RHS = MI.getOperand(2).getReg();
+  }
+
+  // Real SAVE grows this stack *upward* (increment-then-store) — see
+  // EclipseInstrInfo.td's SAVE comment — so push here is ISZ-then-store
+  // and the matching pop below is load-then-DSZ, the opposite of what
+  // the old, purely-software `_SP` stack this replaced used.
+  BuildMI(MBB, MI, DL, get(Eclipse::ISZABS)).addImm(HWStackAddr);
+  BuildMI(MBB, MI, DL, get(Eclipse::STABSI))
+      .addReg(Eclipse::AC2)
+      .addImm(HWStackAddr);
+
+  // NB: must be real MOVrr, not TargetOpcode::COPY — these are inserted
+  // *before* the loop's current position in ExpandPostRAPseudos, so a
+  // generic COPY placed here would never get revisited for lowering and
+  // would reach the asm printer as a bare, encoding-less pseudo.
+  //
+  // NB: RHS must be copied to AC2 *before* LHS is copied to AC1. Only
+  // AC0/AC1 are allocatable GPRs, so {LHS, RHS} both live in {AC0, AC1} —
+  // copying LHS into AC1 first can clobber RHS's source register before
+  // it's been read, if RHS happened to be allocated to AC1. AC2 is never
+  // LHS or RHS's register (it's the reserved frame pointer, not
+  // GPR-allocatable), so writing it first is always safe.
+  BuildMI(MBB, MI, DL, get(Eclipse::MOVrr), Eclipse::AC2).addReg(RHS);
+  BuildMI(MBB, MI, DL, get(Eclipse::MOVrr), Eclipse::AC1).addReg(LHS);
+  // Zero AC0 unconditionally (self-subtract: correct regardless of AC0's
+  // prior value) — primes MUL's accumulator and DIV's dividend high word.
+  BuildMI(MBB, MI, DL, get(Eclipse::SUBrr), Eclipse::AC0)
+      .addReg(Eclipse::AC0)
+      .addReg(Eclipse::AC0);
+
+  if (Opc == Eclipse::MULrr) {
+    BuildMI(MBB, MI, DL, get(Eclipse::MUL));
+    BuildMI(MBB, MI, DL, get(Eclipse::MOVrr), Dst).addReg(Eclipse::AC1);
+  } else if (IsDivRem) {
+    BuildMI(MBB, MI, DL, get(Eclipse::DIV));
+    // DIV: AC0 := remainder, AC1 := quotient (docs/ECLIPSE_ISA_NOTES.md).
+    // Quot/Rem are two distinct physical registers the allocator drew
+    // from the same 2-register GPR pool as everything else here (see
+    // EclipseInstrInfo.td's Defs comment), so they are necessarily some
+    // permutation of exactly {AC0, AC1}.
+    if (Quot == Eclipse::AC1 && Rem == Eclipse::AC0) {
+      // Already exactly where DIV leaves them -- nothing to move.
+    } else {
+      assert(Quot == Eclipse::AC0 && Rem == Eclipse::AC1 &&
+             "UDIVREMrr's outputs must be {AC0, AC1} in some order");
+      // Swap via AC2 as scratch: AC2 is dead at this point (the RHS
+      // value saved into it above was already consumed by DIV) and
+      // is not restored to the caller's frame pointer until below, so
+      // it is safe to clobber here.
+      BuildMI(MBB, MI, DL, get(Eclipse::MOVrr), Eclipse::AC2)
+          .addReg(Eclipse::AC0);
+      BuildMI(MBB, MI, DL, get(Eclipse::MOVrr), Eclipse::AC0)
+          .addReg(Eclipse::AC1);
+      BuildMI(MBB, MI, DL, get(Eclipse::MOVrr), Eclipse::AC1)
+          .addReg(Eclipse::AC2);
+    }
+  } else {
+    BuildMI(MBB, MI, DL, get(Eclipse::DIV));
+    // DIV: AC0 := remainder, AC1 := quotient (docs/ECLIPSE_ISA_NOTES.md).
+    Register Result = (Opc == Eclipse::UDIVrr) ? Eclipse::AC1 : Eclipse::AC0;
+    BuildMI(MBB, MI, DL, get(Eclipse::MOVrr), Dst).addReg(Result);
+  }
+
+  BuildMI(MBB, MI, DL, get(Eclipse::LDABSI), Eclipse::AC2)
+      .addImm(HWStackAddr);
+  BuildMI(MBB, MI, DL, get(Eclipse::DSZABS)).addImm(HWStackAddr);
+
+  MI.eraseFromParent();
+  return true;
+}
