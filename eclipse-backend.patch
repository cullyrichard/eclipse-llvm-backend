+
+#ifndef LLVM_LIB_TARGET_ECLIPSE_MCTARGETDESC_ECLIPSEMCASMINFO_H
+#define LLVM_LIB_TARGET_ECLIPSE_MCTARGETDESC_ECLIPSEMCASMINFO_H
+
+#include "llvm/MC/MCAsmInfo.h"
+
+namespace llvm {
+class Triple;
+
+// Not ELF: this backend emits plain Nova/Eclipse-S140-style assembly text
+// (see README.md), the same textual target the sibling `eccc` project's
+// SymbolicBackend produces for Connor Wood's `dgasm` cross-assembler, not
+// an object-file format. Directives below match what a human-written
+// dgasm source file looks like, not a Unix assembler.
+class EclipseMCAsmInfo : public MCAsmInfo {
+public:
+  explicit EclipseMCAsmInfo(const Triple &TT, const MCTargetOptions &Options);
+};
+
+} // namespace llvm
