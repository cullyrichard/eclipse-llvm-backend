+#ifndef LLVM_LIB_TARGET_ECLIPSE_ECLIPSEINSTRINFO_H
+#define LLVM_LIB_TARGET_ECLIPSE_ECLIPSEINSTRINFO_H
+
+#include "EclipseRegisterInfo.h"
+#include "MCTargetDesc/EclipseMCTargetDesc.h"
+#include "llvm/CodeGen/TargetInstrInfo.h"
+
+#define GET_INSTRINFO_HEADER
+#include "EclipseGenInstrInfo.inc"
+
+namespace llvm {
+
+class EclipseSubtarget;
+
+class EclipseInstrInfo : public EclipseGenInstrInfo {
+  const EclipseRegisterInfo RegisterInfo;
+
+public:
+  explicit EclipseInstrInfo(const EclipseSubtarget &STI);
+
+  const EclipseRegisterInfo &getRegisterInfo() const { return RegisterInfo; }
+
+  void copyPhysReg(MachineBasicBlock &MBB, MachineBasicBlock::iterator I,
+                    const DebugLoc &DL, Register DestReg, Register SrcReg,
+                    bool KillSrc, bool RenamableDest = false,
+                    bool RenamableSrc = false) const override;
+
+  void storeRegToStackSlot(
+      MachineBasicBlock &MBB, MachineBasicBlock::iterator I, Register SrcReg,
+      bool IsKill, int FrameIndex, const TargetRegisterClass *RC,
+      Register VReg,
+      MachineInstr::MIFlag Flags = MachineInstr::NoFlags) const override;
+
+  void loadRegFromStackSlot(
+      MachineBasicBlock &MBB, MachineBasicBlock::iterator I, Register DestReg,
+      int FrameIndex, const TargetRegisterClass *RC, Register VReg,
+      unsigned SubReg = 0,
+      MachineInstr::MIFlag Flags = MachineInstr::NoFlags) const override;
+
+  bool analyzeBranch(MachineBasicBlock &MBB, MachineBasicBlock *&TBB,
+                      MachineBasicBlock *&FBB,
+                      SmallVectorImpl<MachineOperand> &Cond,
+                      bool AllowModify) const override;
+
+  unsigned removeBranch(MachineBasicBlock &MBB,
+                         int *BytesRemoved = nullptr) const override;
+
+  unsigned insertBranch(MachineBasicBlock &MBB, MachineBasicBlock *TBB,
+                         MachineBasicBlock *FBB,
+                         ArrayRef<MachineOperand> Cond, const DebugLoc &DL,
+                         int *BytesAdded = nullptr) const override;
+
+  bool reverseBranchCondition(
+      SmallVectorImpl<MachineOperand> &Cond) const override;
+
+  // Expands MULrr/UDIVrr/UREMrr/UDIVREMrr — see EclipseInstrInfo.td's
+  // comment on why this has to happen post-RA rather than via
+  // EmitInstrWithCustomInserter.
+  bool expandPostRAPseudo(MachineInstr &MI) const override;
+};
+
+} // namespace llvm
+
+#endif // LLVM_LIB_TARGET_ECLIPSE_ECLIPSEINSTRINFO_H
diff --git a/llvm/lib/Target/Eclipse/EclipseInstrInfo.td b/llvm/lib/Target/Eclipse/EclipseInstrInfo.td
new file mode 100644
index 000000000..0eb936b5a
--- /dev/null
+++ b/llvm/lib/Target/Eclipse/EclipseInstrInfo.td
@@ -0,0 +1,796 @@
+//===- EclipseInstrInfo.td - Eclipse Instruction defs ------*- tablegen -*-=//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM
+// Exceptions. See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// Deliberately small instruction set: only what's needed to lower i16
+// scalar/pointer C-like code, matching exactly what the sibling `eccc`
+// project's hand-written codegen already proved correct against a real
+// `eclipseemu` simulator (see docs/ECLIPSE_ISA_NOTES.md and
+// docs/CALLING_CONVENTION.md there). i32 and float arithmetic are lowered
+// to runtime library calls (see EclipseISelLowering.cpp) rather than
+// inline multi-word instruction sequences, specifically because this
+// backend won't fabricate unverified carry/FPU opcode encodings the way
+// eccc refused to (see README.md).
+//
+//===----------------------------------------------------------------------===//
+
+include "EclipseInstrFormats.td"
+
+//===----------------------------------------------------------------------===//
+// Target-specific SDNodes
+//===----------------------------------------------------------------------===//
+
+def SDT_EclipseWrapper : SDTypeProfile<1, 1, [SDTCisSameAs<0, 1>,
+                                               SDTCisPtrTy<0>]>;
+def EclipseWrapper : SDNode<"EclipseISD::WRAPPER", SDT_EclipseWrapper>;
+
+// Emitted only by EclipseTargetLowering::PerformDAGCombine, in place of a
+// plain `add`, once it has already halved a runtime GEP byte-offset to
+// match a WRAPPER'd (LEAGA-materialized) base pointer's word granularity
+// — see that function's comment. Semantically just a register add, hence
+// the identical Pat below reusing ADDrr; the distinct SDNode only exists
+// so PerformDAGCombine's own `ISD::ADD`-keyed check can never match its
+// own output again.
+def SDT_EclipseWordAdd : SDTypeProfile<1, 2, [SDTCisSameAs<0, 1>,
+                                               SDTCisSameAs<0, 2>,
+                                               SDTCisVT<0, i16>]>;
+def EclipseWordAdd : SDNode<"EclipseISD::WORD_ADD", SDT_EclipseWordAdd>;
+
+// Also emitted only by PerformDAGCombine, to unsigned-divide-by-2 the
+// runtime offset WORD_ADD above consumes. Deliberately *not* expressed as
+// plain `srl`/`udiv` — see PerformDAGCombine's comment for the infinite
+// DAGCombine loop that produced empirically (LowerShift's Custom SRL-by-1
+// lowering and DAGCombiner's own udiv-by-power-of-2-to-shift fold
+// re-triggering each other forever). Selects straight to the existing,
+// already-proven UDIVrr pseudo.
+def SDT_EclipseHalve : SDTypeProfile<1, 2, [SDTCisSameAs<0, 1>,
+                                             SDTCisSameAs<0, 2>,
+                                             SDTCisVT<0, i16>]>;
+def EclipseHalve : SDNode<"EclipseISD::HALVE", SDT_EclipseHalve>;
+
+def SDT_EclipseCall : SDTypeProfile<0, -1, [SDTCisVT<0, i16>]>;
+def EclipseCall : SDNode<"EclipseISD::CALL", SDT_EclipseCall,
+                          [SDNPHasChain, SDNPOutGlue, SDNPOptInGlue,
+                           SDNPVariadic]>;
+
+// Indirect call through a runtime function-pointer *value* (a register),
+// as opposed to EclipseCall's compile-time-known symbol — see CALLIND
+// below and EclipseISelLowering.cpp's LowerCall for the full story. Same
+// type profile as EclipseCall (single variadic i16 operand plus implicit
+// chain/glue): deliberately a distinct SDNode, not a reuse of EclipseCall
+// with a register operand, so ISel pattern matching can tell the two
+// apart (CALL always wants a texternalsym operand, CALLIND always wants a
+// GPR).
+def EclipseCallIndirect : SDNode<"EclipseISD::CALL_INDIRECT", SDT_EclipseCall,
+                                  [SDNPHasChain, SDNPOutGlue, SDNPOptInGlue,
+                                   SDNPVariadic]>;
+
+def EclipseRet : SDNode<"EclipseISD::RET_FLAG", SDTNone,
+                         [SDNPHasChain, SDNPOptInGlue, SDNPVariadic]>;
+
+// Return from an `__attribute__((interrupt))` handler — always void, so
+// unlike EclipseRet there's no variadic return-value operand to carry.
+def EclipseRetI : SDNode<"EclipseISD::RETI_FLAG", SDTNone, [SDNPHasChain]>;
+
+def SDT_EclipseCallSeqStart : SDCallSeqStart<[SDTCisVT<0, i16>,
+                                               SDTCisVT<1, i16>]>;
+def SDT_EclipseCallSeqEnd : SDCallSeqEnd<[SDTCisVT<0, i16>, SDTCisVT<1, i16>]>;
+def EclipseCallSeqStart : SDNode<"ISD::CALLSEQ_START", SDT_EclipseCallSeqStart,
+                                  [SDNPHasChain, SDNPOutGlue]>;
+def EclipseCallSeqEnd : SDNode<"ISD::CALLSEQ_END", SDT_EclipseCallSeqEnd,
+                                [SDNPHasChain, SDNPOptInGlue, SDNPOutGlue]>;
+
+def SDT_EclipseBrcond : SDTypeProfile<0, 2, [SDTCisVT<0, i16>,
+                                              SDTCisVT<1, OtherVT>]>;
+def EclipseBrz  : SDNode<"EclipseISD::BRZ",  SDT_EclipseBrcond, [SDNPHasChain]>;
+def EclipseBrnz : SDNode<"EclipseISD::BRNZ", SDT_EclipseBrcond, [SDNPHasChain]>;
+def EclipseBgez : SDNode<"EclipseISD::BGEZ", SDT_EclipseBrcond, [SDNPHasChain]>;
+def EclipseBltz : SDNode<"EclipseISD::BLTZ", SDT_EclipseBrcond, [SDNPHasChain]>;
+
+// Unsigned branch variants: unlike BRZ/BRNZ/BGEZ/BLTZ, these take *two*
+// live GPR operands (not one pre-computed comparison value) because the
+// carry they test has to come directly off "SUB# rhs,lhs" at the moment
+// of subtraction — see EclipseISD::BGEU's comment in EclipseISelLowering.h.
+def SDT_EclipseBrcondU : SDTypeProfile<0, 3, [SDTCisVT<0, i16>,
+                                               SDTCisVT<1, i16>,
+                                               SDTCisVT<2, OtherVT>]>;
+def EclipseBgeu : SDNode<"EclipseISD::BGEU", SDT_EclipseBrcondU, [SDNPHasChain]>;
+def EclipseBltu : SDNode<"EclipseISD::BLTU", SDT_EclipseBrcondU, [SDNPHasChain]>;
+
+//===----------------------------------------------------------------------===//
+// Operands
+//===----------------------------------------------------------------------===//
+
+def brtarget : Operand<OtherVT>;
+def calltarget : Operand<i16>;
+
+// `i16imm` (a plain 16-bit immediate operand) is already defined by
+// target-independent Target.td — reused as-is here. There are no
+// immediate-operand instructions on the base Nova/Eclipse ISA at all (the
+// reason eccc built a deduplicated constant pool instead) — every
+// "constant" this backend needs is really the *address* of a page-zero
+// data word, but the operand class itself is just a plain 16-bit value.
+
+//===----------------------------------------------------------------------===//
+// Instruction Pattern Stuff
+//===----------------------------------------------------------------------===//
+
+def imm16 : ImmLeaf<i16, [{ return true; }]>;
+
+//===----------------------------------------------------------------------===//
+// Data movement / ALC (accumulator-accumulator) instructions
+//
+// Nova/Eclipse ALC instructions are printed "OP src,dst" and (except MOV,
+// NEG, COM, which just overwrite dst) accumulate into dst: dst := dst OP
+// src. Confirmed empirically in docs/CALLING_CONVENTION.md ("ADD 0,1 means
+// AC1 += AC0").
+//===----------------------------------------------------------------------===//
+
+let isAsCheapAsAMove = 1 in
+def MOVrr : EclipseInst<(outs GPR:$dst), (ins GPR:$src), "MOV $src,$dst", []>;
+
+class ALCrr<string mnem, SDNode op>
+    : EclipseInst<(outs GPR:$dst), (ins GPR:$src, GPR:$dstin), mnem#" $src,$dst",
+                  [(set GPR:$dst, (op GPR:$dstin, GPR:$src))]> {
+  let Constraints = "$dst = $dstin";
+}
+
+def ADDrr : ALCrr<"ADD", add>;
+def : Pat<(EclipseWordAdd GPR:$dstin, GPR:$src), (ADDrr GPR:$src, GPR:$dstin)>;
+def SUBrr : ALCrr<"SUB", sub>;
+def ANDrr : ALCrr<"AND", and>;
+def IORrr : ALCrr<"IOR", or>;
+def XORrr : ALCrr<"XOR", xor>;
+
+def NEGrr : EclipseInst<(outs GPR:$dst), (ins GPR:$src), "NEG $src,$dst",
+                         [(set GPR:$dst, (ineg GPR:$src))]>;
+def COMrr : EclipseInst<(outs GPR:$dst), (ins GPR:$src), "COM $src,$dst",
+                         [(set GPR:$dst, (not GPR:$src))]>;
+
+//===----------------------------------------------------------------------===//
+// Real Eclipse S/140 hardware multi-bit shifts: HXL/HXR ("hex shift left/
+// right") shift a single accumulator by N *hex digits* (i.e. 4*N bits, N in
+// 1-4) in one instruction; DHXL/DHXR do the same to the 32-bit pair
+// AC(ac):AC(ac+1) (ac = high word, ac+1 = low word). All four are logical
+// (zero-fill) — verified against the S/140 Programmer's Reference, and then
+// directly on eclipseemu (not just the manual — see DEBUGGING_NOTES.md):
+// hand-assembled probes for every N in 1-4 confirmed the exact bit count
+// (HXL/HXR: N=1 -> 4 bits ... N=4 -> 16 bits, i.e. shifts the entire
+// 16-bit accumulator out; DHXL/DHXR: same per N, crossing correctly between
+// the pair's two words at N=4 — e.g. DHXL with the pair holding 1 and N=4
+// moved the bit from the low word into the high word). N=0 is REJECTED by
+// dgasm outright ("Immediate out of range. Must be 1-4, got 0") — never
+// emit N=0; callers must instead skip the instruction entirely when there's
+// no multiple-of-4 amount to shift.
+//
+// These replace the O(Amt) self-add chain LowerShift previously used for
+// every `<<` with a single real instruction for the amount's whole
+// multiple-of-4 part (see LowerShift's SHL case) — e.g. `x << 15` used to
+// cost 15 ADDrr instructions; it now costs one HXL (12 of the 15 bits) plus
+// 3 ADDrr for the remainder.
+//
+// HXL/HXR are printed exactly like the ALCrr family above (accumulate/
+// overwrite in place: "OP ac,n" reads and writes the same accumulator) —
+// $dst and $src are tied to the same physical register, matching real
+// hardware's single implicit operand.
+class HexShift<string mnem>
+    : EclipseInst<(outs GPR:$dst), (ins GPR:$src, i16imm:$n), mnem#" $dst,$n",
+                  []> {
+  let Constraints = "$dst = $src";
+}
+
+def HXL : HexShift<"HXL">;
+def HXR : HexShift<"HXR">;
+
+// DHXL/DHXR operate on the pair AC(ac):AC(ac+1), not a single independently
+// allocatable GPR — this backend has no register-pair class (no other
+// paired/32-bit machine-level operation exists here at all; every i32 op
+// goes through a runtime libcall instead, see eclipse_rt.c), and with only
+// AC0/AC1 ever handed to the register allocator (AC2/AC3 are permanently
+// reserved — see EclipseRegisterInfo.td), a real pair operation would need
+// the allocator to guarantee $dst/$src land in two *specific, adjacent*
+// physical registers, which an ordinary tied GPR operand does not express
+// or enforce. So: defined here (real, verified instructions, all four
+// covered by this same DEBUGGING_NOTES.md entry) for future use, but
+// deliberately NOT wired into any Pat or into LowerShift/i32 codegen yet —
+// doing that safely needs either a dedicated paired-register class or
+// hand-emitted code against hardcoded physical registers outside the
+// normal allocator (the same kind of bigger, riskier change this backend's
+// own history warns against rushing — see LowerShift's UDIVrr comment).
+// $dst/$src name only the pair's high register (ac); the low register
+// (ac+1) is real hardware's implicit second operand, not modeled as a
+// separate MachineOperand.
+class DHexShift<string mnem>
+    : EclipseInst<(outs GPR:$dst), (ins GPR:$src, i16imm:$n), mnem#" $dst,$n",
+                  []> {
+  let Constraints = "$dst = $src";
+}
+
+def DHXL : DHexShift<"DHXL">;
+def DHXR : DHexShift<"DHXR">;
+
+//===----------------------------------------------------------------------===//
+// Memory: frame-relative (AC2/FP-relative) and absolute (page-zero)
+//===----------------------------------------------------------------------===//
+
+// No declarative Pattern here: a bare `frameindex` operand needs custom
+// selection (EclipseISelDAGToDAG.cpp's Select()), not table-driven
+// pattern matching — matching real-target practice (neither MSP430 nor
+// AVR bind `frameindex` directly in a .td Pattern either).
+let mayLoad = 1 in
+def LDFI : EclipseInst<(outs GPR:$dst), (ins i16imm:$off), "LDA $dst,$off,2",
+                        []>;
+let mayStore = 1 in
+def STFI : EclipseInst<(outs), (ins GPR:$src, i16imm:$off), "STA $src,$off,2",
+                        []>;
+
+// Materializes the *address* FP+off as a value (not a load) — needed for
+// `&local`, arrays, and any pointer arithmetic rooted at a local/param.
+// There's no load-effective-address instruction on this ISA (no immediate
+// operands at all — see the file header), so this is a pseudo, expanded in
+// EclipseRegisterInfo::eliminateFrameIndex (the one place the frame index's
+// resolved word offset is actually known) into: copy FP, materialize the
+// offset via a fresh constant-pool entry, add it in.
+def LEAFI : EclipsePseudo<(outs GPR:$dst), (ins i16imm:$fi), "# LEAFI", []>;
+
+// LDABS/STABS have NO Pattern for a *global* (tglobaladdr) load/store,
+// deliberately: see the "global data addressing" comment below LEAGA's
+// definition — a global goes through real extended addressing
+// (ELDAGA/ESTAGA, i.e. ELDA/ESTA) instead, which reaches the entire
+// address space directly rather than LDA/STA's page-zero-only 8-bit
+// displacement (only tconstpool — genuinely single-word values, always
+// page-zero-resident by design — still uses these two directly, just
+// below). A bare LDABS/STABS definition still exists because LEAFI's
+// frame-index materialization and other internal uses reference the
+// opcodes directly.
+def LDABS : EclipseInst<(outs GPR:$dst), (ins i16imm:$addr), "LDA $dst,$addr", []>;
+def STABS : EclipseInst<(outs), (ins GPR:$src, i16imm:$addr), "STA $src,$addr", []>;
+
+// A constant-pool wrapper used *as a value* (not explicitly `load`-wrapped)
+// is exactly what materializing an integer constant looks like — a
+// constant-pool entry only ever exists to be loaded as a value in the
+// first place (see the ISD::Constant handling in EclipseISelLowering.cpp),
+// unlike a global's address, so this is the same LDABS instruction.
+def : Pat<(i16 (EclipseWrapper tconstpool:$cp)), (LDABS tconstpool:$cp)>;
+
+// Global data addressing via real Eclipse S/140 extended addressing
+// (ELEF/ELDA/ESTA — a 2-word encoding whose second word holds a genuine
+// absolute address reaching the entire 32K-word address space directly,
+// confirmed against the real S/140 Programmer's Reference and
+// empirically on eclipseemu/dgasm; see DEBUGGING_NOTES.md). `LDA/STA
+// ac,addr` (the *base*-ISA instructions used everywhere else in this
+// file) only has an 8-bit displacement (0-255) — this backend originally
+// put every global's/string's *actual content* directly in page-zero
+// under that limit, meaning a single 256-word budget was shared by the
+// entire program's data, not just its pointers (confirmed empirically to
+// fail outright on nothing fancier than printf + string.h + ctype.h +
+// stdlib.h together). That was fixed once already by *indirecting*
+// through a page-zero pointer word (LEAGA materializing an address, then
+// LDIND/STIND's `_scratch`-based dereference) — real, but still not
+// free: still one page-zero word per distinct global, plus two runtime
+// instructions per access. ELEF/ELDA/ESTA remove that page-zero cost
+// entirely: since their own address operand already reaches the full
+// address space with no page-zero involvement at all, a global's address
+// or content is materialized/accessed with a *single* instruction and
+// *zero* page-zero words, not through an indirect pointer.
+//
+// Three instructions cover the three shapes global access takes here:
+//   - LEAGA (real mnemonic ELEF, "extended load effective address"):
+//     materializes a global's *address* as a value — `&global`, a string
+//     literal or array decaying to a pointer, a function value. Confirmed
+//     empirically that ELEF loads the operand's own resolved address,
+//     not the word stored there (unlike ELDA) — see DEBUGGING_NOTES.md.
+//   - ELDAGA/ESTAGA (real mnemonics ELDA/ESTA): a *direct* load/store of
+//     a global's content with no runtime-computed offset involved — the
+//     common case, one real instruction in place of LEAGA+LDIND/STIND's
+//     three. Only fires when the load/store's pointer operand is
+//     *exactly* a bare global address (see the Pats below) — deeper
+//     matches win under SelectionDAG's normal pattern-complexity
+//     preference, so this doesn't disturb any other composition.
+// Every other case — a *runtime*-computed offset added to a global base
+// (indexing an array with a non-constant, `PerformDAGCombine`'s
+// WORD_ADD), or an 8-bit truncating/extending load or store
+// (extloadi8/sextloadi8/zextloadi8/truncstorei8) — still composes LEAGA
+// (now ELEF-backed, still just materializing an address into a register)
+// with LDIND/STIND exactly as before; nothing about those paths changes.
+//
+// A compile-time-constant offset (a literal array index, a struct field
+// — already folded into the GlobalAddress operand's own Offset field by
+// `isOffsetFoldingLegal`, see EclipseISelLowering.h) is folded directly
+// into the emitted address *expression text* ("target+N") rather than
+// materialized as a separate constant word and added at runtime: dgasm's
+// expression evaluator resolves "symbol+integer" to the symbol's own
+// assigned address plus that integer at assemble time (confirmed
+// empirically — see DEBUGGING_NOTES.md), so this needs no extra
+// instruction or page-zero word at all, unlike the old LEAGA scheme's
+// AC2-based runtime ADD for the same case. See EclipseAsmPrinter.cpp's
+// emitInstruction (the LEAGA/ELDAGA/ESTAGA cases) for the actual text
+// construction, including the same byte-vs-word-offset divisor rule
+// emitGlobalVariable already established (word-granular for a numeric
+// global, unscaled for a string literal).
+//
+// tconstpool is deliberately NOT changed to this scheme (see the Pat
+// above LDABS's def): a constant-pool entry is already exactly one word,
+// so indirecting — or extended-addressing — it would only add overhead
+// with no page-zero savings.
+def LEAGA : EclipseInst<(outs GPR:$dst), (ins i16imm:$addr), "# LEAGA", []>;
+def : Pat<(i16 (EclipseWrapper tglobaladdr:$addr)), (LEAGA tglobaladdr:$addr)>;
+
+let mayLoad = 1 in
+def ELDAGA : EclipseInst<(outs GPR:$dst), (ins i16imm:$addr), "# ELDAGA", []>;
+def : Pat<(i16 (load (EclipseWrapper tglobaladdr:$addr))), (ELDAGA tglobaladdr:$addr)>;
+
+let mayStore = 1 in
+def ESTAGA : EclipseInst<(outs), (ins GPR:$src, i16imm:$addr), "# ESTAGA", []>;
+def : Pat<(store GPR:$src, (EclipseWrapper tglobaladdr:$addr)), (ESTAGA GPR:$src, tglobaladdr:$addr)>;
+
+// Page-zero *indirect* load/store: "LDA/STA ac,@addr" — one extra level of
+// indirection through whatever address is stored at the (page-zero) word
+// `addr`. Used for the software-stack push/pop (indirect through `_SP`)
+// and, with a shared fixed scratch word, for general pointer dereference —
+// see docs/ECLIPSE_ISA_NOTES.md's verified push/pop sequence and
+// DESIGN.md's "pointer-dereference scratch word".
+def LDABSI : EclipseInst<(outs GPR:$dst), (ins i16imm:$addr), "LDA $dst,@$addr", []>;
+def STABSI : EclipseInst<(outs), (ins GPR:$src, i16imm:$addr), "STA $src,@$addr", []>;
+
+// Jump indirect through a fixed absolute address — same "@" indirect
+// addressing LDABSI/STABSI use, just for control flow. Used with $addr=0
+// for the interrupt-return sequence below: hardware saves the interrupted
+// PC into memory location 0 on interrupt entry, so "return" means jumping
+// indirect through that fixed cell (see docs/ECLIPSE_ISA_NOTES.md and the
+// Eclipse S/140 Programmer's Reference's Program Flow Interruption
+// section — empirically verified end-to-end in hand-written assembly
+// before this pseudo existed).
+let isBranch = 1, isTerminator = 1, isBarrier = 1, isIndirectBranch = 1 in
+def JMPABSI : EclipseInst<(outs), (ins i16imm:$addr), "JMP @$addr", []>;
+
+// ISZ/DSZ are flow-class in dgasm's real grammar and so, unlike LDA/STA,
+// do *not* default to page-zero addressing when no index is given — they
+// need the index made explicit (confirmed against a real `dgasm` binary,
+// see eccc's crates/eccc-codegen/src/symbolic.rs module doc).
+def ISZABS : EclipseInst<(outs), (ins i16imm:$addr), "ISZ $addr,0", []>;
+def DSZABS : EclipseInst<(outs), (ins i16imm:$addr), "DSZ $addr,0", []>;
+
+// General pointer dereference, through the shared page-zero scratch word
+// (see README.md / docs/ECLIPSE_ISA_NOTES.md "dereference scratch word"):
+// expands (EclipseISelLowering.cpp's custom inserter) to STABS the address
+// into SCRATCH, then LDABSI/STABSI indirect through it.
+let usesCustomInserter = 1 in {
+def LDIND : EclipsePseudo<(outs GPR:$dst), (ins GPR:$addr), "# LDIND",
+                           [(set GPR:$dst, (load GPR:$addr))]>;
+def STIND : EclipsePseudo<(outs), (ins GPR:$src, GPR:$addr), "# STIND",
+                           [(store GPR:$src, GPR:$addr)]>;
+}
+def : Pat<(i16 (extloadi8  GPR:$addr)), (LDIND GPR:$addr)>;
+def : Pat<(i16 (sextloadi8 GPR:$addr)), (LDIND GPR:$addr)>;
+def : Pat<(i16 (zextloadi8 GPR:$addr)), (LDIND GPR:$addr)>;
+def : Pat<(truncstorei8 GPR:$src, GPR:$addr), (STIND GPR:$src, GPR:$addr)>;
+
+// A second, independent page-zero scratch word (`_scratch2`), used ONLY
+// for a load/store whose address is exactly an EclipseWordAdd node --
+// i.e. PerformDAGCombine's own low-word/runtime-GEP address
+// materialization (EclipseISelLowering.cpp's big ISD::ADD comment),
+// never LDIND/STIND's *general* dereference above (an ordinary loaded
+// pointer *value*, or any other GPR-typed address that didn't come from
+// that combine). See DEBUGGING_NOTES.md entry #26 (a continuation of
+// #25): a real corruption was traced to `_scratch` being shared,
+// unsynchronized, between this address-materialization path and
+// EclipseRegisterInfo::eliminateFrameIndex's own out-of-range fallback,
+// which *also* uses `_scratch` as a general-purpose value-stash during
+// its own address decomposition -- a large enough frame needs both
+// mechanisms densely interleaved within the same few statements, with
+// nothing keeping one mechanism's brief "value stashed in `_scratch`,
+// about to be reloaded" window safe from the other's use of the same
+// word in between. Splitting this path onto its own word removes that
+// specific collision, at the cost of one more page-zero word.
+//
+// $base/$off are added together first (the combine leaves that split,
+// rather than folding it, so DAGCombiner's own re-visiting of a plain
+// ADD here can never re-match and loop -- see EclipseWordAdd's own
+// comment above), then handled exactly like LDIND/STIND's own
+// STABS-then-indirect expansion, just against `_scratch2`.
+//
+// Only fires when the address is *exactly* this shape -- a strictly
+// deeper match than LDIND/STIND's plain `GPR:$addr` above, so
+// SelectionDAG's normal complexity-based preference always picks this
+// one first when it applies (the same mechanism ELDAGA/ESTAGA rely on;
+// see the "Global data addressing" comment above).
+let usesCustomInserter = 1 in {
+def LDINDW : EclipsePseudo<(outs GPR:$dst), (ins GPR:$base, GPR:$off), "# LDINDW",
+                            [(set GPR:$dst, (load (EclipseWordAdd GPR:$base, GPR:$off)))]>;
+def STINDW : EclipsePseudo<(outs), (ins GPR:$src, GPR:$base, GPR:$off), "# STINDW",
+                            [(store GPR:$src, (EclipseWordAdd GPR:$base, GPR:$off))]>;
+}
+def : Pat<(i16 (extloadi8  (EclipseWordAdd GPR:$base, GPR:$off))), (LDINDW GPR:$base, GPR:$off)>;
+def : Pat<(i16 (sextloadi8 (EclipseWordAdd GPR:$base, GPR:$off))), (LDINDW GPR:$base, GPR:$off)>;
+def : Pat<(i16 (zextloadi8 (EclipseWordAdd GPR:$base, GPR:$off))), (LDINDW GPR:$base, GPR:$off)>;
+def : Pat<(truncstorei8 GPR:$src, (EclipseWordAdd GPR:$base, GPR:$off)), (STINDW GPR:$src, GPR:$base, GPR:$off)>;
+
+//===----------------------------------------------------------------------===//
+// Software stack (a plain page-zero memory word, `_SP`, manipulated with
+// ISZ/DSZ + single-level indirect addressing — see ECLIPSE_ISA_NOTES.md;
+// the hardware PSH/POP/SAVE/RTN stack instructions were tried by eccc and
+// rejected as needing an OS-managed environment this bare-metal target
+// doesn't have)
+//===----------------------------------------------------------------------===//
+
+let usesCustomInserter = 1 in {
+def PUSH : EclipsePseudo<(outs), (ins GPR:$src), "# PUSH", []>;
+def POP  : EclipsePseudo<(outs GPR:$dst), (ins), "# POP", []>;
+}
+
+// Variable-length array support: reserves a *runtime*-computed word count
+// on the same hardware stack pointer (memory location 040) SAVE/RTN and
+// the software push/pop machinery above all already share. $wordcount is
+// consumed (its register is read, not preserved) and $dst comes back
+// holding the *old* top-of-stack value, not yet a safe base pointer on
+// its own -- LowerDYNAMIC_STACKALLOC (EclipseISelLowering.cpp) adds 1 to
+// it afterward, as an ordinary ADD reaching normal ISel/regalloc, rather
+// than inside this pseudo's own hand-built expansion, specifically to
+// avoid needing a third scratch register here: only GPR:$dst/$wordcount
+// (i.e. AC0/AC1, the only two allocatable registers) are available, and
+// this expansion already uses both for the actual reservation logic.
+let usesCustomInserter = 1 in
+def VLAALLOC : EclipsePseudo<(outs GPR:$dst), (ins GPR:$wordcount),
+                              "# VLAALLOC", []>;
+
+// clang emits llvm.stacksave/llvm.stackrestore around any lexical block
+// containing a VLA (unconditionally, even when the block can only ever
+// run once and nothing about it strictly needs explicit save/restore) --
+// both are trivial direct reads/writes of the same hardware stack
+// pointer (memory location 040) everything above shares: stacksave
+// captures its current value, stackrestore later overwrites it with a
+// previously-captured one, discarding anything allocated (VLA words
+// included) since the save. No new scratch-register concerns here,
+// unlike VLAALLOC above -- each is a single real instruction once
+// expanded, not a short sequence.
+let usesCustomInserter = 1 in {
+def STACKSAVE_PSEUDO : EclipsePseudo<(outs GPR:$dst), (ins), "# STACKSAVE", []>;
+def STACKRESTORE_PSEUDO : EclipsePseudo<(outs), (ins GPR:$src), "# STACKRESTORE", []>;
+}
+
+let usesCustomInserter = 1 in {
+def ADJCALLSTACKDOWN : EclipsePseudo<(outs), (ins i16imm:$amt1, i16imm:$amt2),
+                                      "# ADJCALLSTACKDOWN $amt1",
+                                      [(EclipseCallSeqStart timm:$amt1, timm:$amt2)]>;
+def ADJCALLSTACKUP   : EclipsePseudo<(outs), (ins i16imm:$amt1, i16imm:$amt2),
+                                      "# ADJCALLSTACKUP $amt1",
+                                      [(EclipseCallSeqEnd timm:$amt1, timm:$amt2)]>;
+}
+
+//===----------------------------------------------------------------------===//
+// Control flow
+//===----------------------------------------------------------------------===//
+
+let isBranch = 1, isTerminator = 1, isBarrier = 1 in
+def JMP : EclipseInst<(outs), (ins brtarget:$dst), "JMP $dst", [(br bb:$dst)]>;
+
+// Skip-then-jump conditional branches: printed as two lines by
+// EclipseAsmPrinter (see docs/CALLING_CONVENTION.md's verified idiom):
+//   MOV# $val,$val,SZR / SNR      (zero test, no write-back)
+//   MOVL# $val,$val,SZC / SNC     (sign test via rotate-through-carry, no write-back)
+//   JMP $dst
+// Falls through to the next layout block otherwise (standard conditional
+// branch, unlike eccc's own always-both-arms form — eccc doesn't do block
+// layout, this backend does, so the tighter skip+single-jump form is both
+// valid on real hardware and more efficient).
+let isBranch = 1, isTerminator = 1 in {
+def BRZ  : EclipseInst<(outs), (ins GPR:$val, brtarget:$dst), "# BRZ",
+                        [(EclipseBrz  GPR:$val, bb:$dst)]>;
+def BRNZ : EclipseInst<(outs), (ins GPR:$val, brtarget:$dst), "# BRNZ",
+                        [(EclipseBrnz GPR:$val, bb:$dst)]>;
+def BGEZ : EclipseInst<(outs), (ins GPR:$val, brtarget:$dst), "# BGEZ",
+                        [(EclipseBgez GPR:$val, bb:$dst)]>;
+def BLTZ : EclipseInst<(outs), (ins GPR:$val, brtarget:$dst), "# BLTZ",
+                        [(EclipseBltz GPR:$val, bb:$dst)]>;
+
+// Unsigned variants: bare "SUB# rhs,lhs" turned out to have a carry
+// output that's independent of lhs/rhs on real Nova/Eclipse hardware (see
+// EclipseAsmPrinter.cpp's BGEU/BLTU case for the full empirical story),
+// so these can't stay a single non-clobbering instruction like
+// BGEZ/BLTZ. Printed by EclipseAsmPrinter as a save-AC2 / copy-lhs /
+// SUBZ-rhs / restore-AC2 / carry-test sequence, borrowing AC2 as scratch
+// exactly like the MUL/DIV pseudo-expansion below — hence `Defs = [AC2]`,
+// even though AC2 is fully restored by the end of the printed sequence
+// (matches MULrr/UDIVrr/UREMrr's own Defs, which declare the same
+// transient clobber for the same save-restore-around-AC2 pattern). $lhs
+// and $rhs themselves are never written — only read — so they need no
+// Defs/tied-outs of their own, avoiding the double-counted-register-
+// demand regression documented on MULrr/UDIVrr/UREMrr above.
+let Defs = [AC2] in {
+def BGEU : EclipseInst<(outs), (ins GPR:$lhs, GPR:$rhs, brtarget:$dst), "# BGEU",
+                        [(EclipseBgeu GPR:$lhs, GPR:$rhs, bb:$dst)]>;
+def BLTU : EclipseInst<(outs), (ins GPR:$lhs, GPR:$rhs, brtarget:$dst), "# BLTU",
+                        [(EclipseBltu GPR:$lhs, GPR:$rhs, bb:$dst)]>;
+}
+}
+
+// Direct calls go through EJSR, real Eclipse S/140 extended addressing:
+// a 2-word instruction whose second word holds a genuine absolute address
+// reaching the entire 32K-word address space directly (confirmed against
+// the real S/140 Programmer's Reference and empirically on eclipseemu —
+// see DEBUGGING_NOTES.md's entry on this change). This replaced an
+// earlier page-zero jump-table scheme (`var <callee>_SLOT = <callee>`,
+// `JSR @<callee>_SLOT,0`) that existed only because base-ISA JSR's direct
+// displacement can't reach an arbitrarily distant target — EJSR has no
+// such limit, so no page-zero slot is needed at all: `$func` is the
+// callee's own symbol name (a real GlobalValue's name or an external/
+// libcall symbol), not a synthesized slot name.
+//
+// The explicit ",0" forces *absolute* addressing rather than dgasm's
+// default (bare "EJSR $func", one operand) — which auto-selects
+// *PC-relative* addressing instead, a real ±16383-word range limit dgasm
+// enforces at assemble time ("Address out of range") unlike absolute
+// mode's full unsigned 0-32767 coverage of this target's entire address
+// space. Confirmed against dgasm's own opcode.c: EJSR's one-operand form
+// defaults index to 1 (PC-relative), while an explicit "0" third field
+// forces index 0 (absolute) — see get_addressing_mode/
+// encode_extendedflow_instruction there. No generated program has come
+// remotely close to that relative range either way, but absolute mode
+// removes the question entirely rather than relying on every call site
+// happening to stay under 16384 words from its callee.
+let isCall = 1, Defs = [AC0, AC1, AC3], Uses = [AC2] in
+def CALL : EclipseInst<(outs), (ins calltarget:$func), "EJSR $func,0",
+                        [(EclipseCall texternalsym:$func)]>;
+
+// Indirect call through a runtime-computed function-pointer value: unlike
+// CALL, there's no compile-time-known callee symbol at all here (a value
+// computed at runtime, held in a register, has no name an assembler
+// expression like EJSR's could reference), so CALL's direct-EJSR scheme
+// doesn't apply — this still needs to go through *some* indirection. Real
+// Nova/Eclipse JSR/EJSR only ever address a compile-time-resolvable
+// expression or an indirect-through-*memory* pointer word; there's no
+// "jump to whatever's in a register" hardware mode on this ISA at all
+// (confirmed against the DG Nova/Eclipse instruction set -- and
+// empirically re-confirmed on eclipseemu below).
+//
+// So the function-pointer value (already an ordinary i16 SSA value by the
+// time it reaches here, wherever it came from -- a load, a parameter, a
+// PHI) first gets stored into the shared page-zero `_scratch` word (the
+// same fixed word LDIND/STIND's emitIndirectMem already uses for general
+// pointer dereference -- see EclipseInstrInfo.td's LDIND/STIND comment and
+// EclipseAsmPrinter.cpp's "var _scratch = 0", always emitted unconditionally
+// so it's guaranteed to exist regardless of whether this feature is used),
+// then JSR indirects through *that* fixed, always-known page-zero address.
+// This costs one extra STA over a direct call's JSR, and reuses the same
+// `_scratch` word LDIND/STIND already use -- safe because this custom
+// inserter emits the store and the JSR back-to-back with nothing else
+// scheduled in between, exactly like emitIndirectMem's own store-then-load-
+// through-`_scratch` pair.
+//
+// Expands (EclipseISelLowering.cpp's custom inserter, emitCallIndirect) to
+// a real STABS "$func -> _scratch" followed by CALLIND_JSR, rather than
+// matching a single real instruction directly here -- CALLIND_JSR's own
+// isCall/Defs/Uses flags (identical to CALL's, deliberately) are what
+// actually inform the register allocator this clobbers AC0/AC1/AC3, not
+// this pseudo (which is erased before regalloc ever runs, exactly like
+// LDIND/STIND/PUSH/POP above).
+let usesCustomInserter = 1 in
+def CALLIND : EclipsePseudo<(outs), (ins GPR:$func), "# CALLIND",
+                             [(EclipseCallIndirect GPR:$func)]>;
+
+// The real "JSR @_scratch,0" CALLIND expands to. A fixed, operand-less
+// instruction (unlike CALL, whose target symbol varies per call site) --
+// every indirect call site reads the same freshly-stored `_scratch` word
+// right before this runs, so there's nothing to parameterize.
+let isCall = 1, Defs = [AC0, AC1, AC3], Uses = [AC2] in
+def CALLIND_JSR : EclipseInst<(outs), (ins), "JSR @_scratch,0", []>;
+
+// AC0 is *not* statically declared here: it's only actually read when the
+// function returns a value, which EclipseISelLowering.cpp's LowerReturn
+// already expresses as a genuine (conditional) extra operand on the
+// EclipseRet node (matched here via SDNPVariadic) — declaring it
+// unconditionally would make void-returning functions falsely claim to
+// read an AC0 nothing ever wrote, tripping the MachineVerifier.
+//
+// Prints "RTN" (the real hardware instruction — see SAVE below and
+// EclipseFrameLowering.cpp's prologue/epilogue), not a plain "JMP 0,3":
+// once EclipseFrameLowering's prologue uses SAVE to build the frame, the
+// matching epilogue must use hardware RTN to unwind it — RTN restores
+// AC0-AC3 and the stack/frame pointer from exactly what SAVE pushed, and
+// a plain JMP wouldn't undo any of that. Confirmed genuinely usable on
+// eclipseemu, contrary to this file's own history: previously documented
+// here as needing "an OS-managed frame environment this bare-metal
+// target doesn't have" (a claim inherited from the sibling eccc
+// project, never independently verified) — direct testing found that
+// claim doesn't hold once the three hardware-register locations SAVE/
+// RTN actually use (040 = stack pointer, 041 = frame pointer, 042 =
+// stack limit) are initialized once at program start (see
+// EclipseAsmPrinter.cpp's _start emission) — no trap ever fires, no OS
+// involved. The AC3 "Uses" below is unchanged from the old plain-JMP
+// version (still true: RTN, like the old JMP 0,3, ultimately needs the
+// return address the caller's JSR left there, though RTN reaches it
+// indirectly through the frame rather than jumping through AC3
+// directly).
+let isReturn = 1, isTerminator = 1, isBarrier = 1, Uses = [AC3] in
+def RET : EclipseInst<(outs), (ins), "RTN", [(EclipseRet)]>;
+
+// The hardware frame-setup instruction EclipseFrameLowering's prologue
+// uses in place of the old manual DSZABS/STABSI push sequence — see
+// RET's comment just above for why this is safe here (verified, not
+// just assumed) despite this file's older comments elsewhere still
+// describing PSH/POP/SAVE/RTN as unusable.
+//
+// $n is a genuine numeric immediate (not a var/symbol reference, unlike
+// every other operand in this backend) — dgasm parses "SAVE <N>" as a
+// real two-word instruction (opcode word + a following literal operand
+// word), confirmed directly. EclipseInstPrinter::printOperand already
+// prints plain immediates as decimal, which is what dgasm expects here.
+//
+// Real hardware semantics (from simh's eclipse_cpu.c, the actual
+// reference this was verified against): pushes AC0, AC1, AC2, the old
+// frame pointer (from location 041), and AC3 (the return address JSR
+// left there) — five words — then reserves $n more, and sets AC3 and
+// location 041 to the new frame pointer (the address of the just-pushed
+// return-address word). AC0/AC1/AC2 are only *read* here (pushed
+// verbatim), never altered — SAVE always runs before this function's
+// own body has assigned anything meaningful to AC0/AC1 anyway (it's the
+// very first thing the prologue does), so their pushed values are
+// whatever the caller happened to leave behind and are never consulted
+// again until RTN pops them back for the *caller's* use.
+let Uses = [AC0, AC1, AC2, AC3], Defs = [AC3] in
+def SAVE : EclipseInst<(outs), (ins i16imm:$n), "SAVE $n", []>;
+
+//===----------------------------------------------------------------------===//
+// Interrupt return. The real hardware sequence is exactly two instructions,
+// back to back with nothing in between: `NIOS 077` (INTEN — re-enables
+// interrupts, and the manual's Program Flow Interruption section documents
+// that the processor executes exactly one more instruction before the next
+// interrupt can be taken) immediately followed by `JMP @0` (JMPABSI 0 —
+// resumes the interrupted program via the PC hardware saved into memory
+// location 0 on entry). Modeled as a single post-RA-expanded pseudo, not
+// two independent real instructions, for the same reason MUL/DIV are above:
+// once expanded, nothing (scheduler, spill code) may be inserted between
+// them, and this one is safety-critical, not just a hardware quirk — a
+// stray instruction between INTEN and the jump would run with interrupts
+// already re-enabled but the interrupted program not yet resumed.
+//===----------------------------------------------------------------------===//
+
+// NIOS with the CPU pseudo-device's fixed code (077 octal) baked into the
+// AsmString, exactly like RET bakes AC3's index into "JMP 0,3" above.
+def INTEN : EclipseInst<(outs), (ins), "NIOS 077", []>;
+
+let isPseudo = 1, isReturn = 1, isTerminator = 1, isBarrier = 1 in
+def RETI : EclipseInst<(outs), (ins), "# RETI", [(EclipseRetI)]>;
+
+//===----------------------------------------------------------------------===//
+// MUL / DIV: zero-operand hardware instructions operating implicitly on
+// AC0:AC1:AC2 (multiply-*accumulate*, not plain multiply — see
+// ECLIPSE_ISA_NOTES.md, confirmed the hard way in eccc's own development).
+// Modeled as pseudos with a custom inserter that primes AC0=0, moves
+// operands into AC1/AC2, saves/restores AC2 (our reserved FP) around the
+// call exactly like eccc's func.rs does, and copies the single-word result
+// back out.
+//===----------------------------------------------------------------------===//
+
+// The real zero-operand hardware instructions, operating implicitly on
+// AC0:AC1:AC2 (see the pseudos below for the operand-marshalling sequence
+// around them).
+let Uses = [AC0, AC1, AC2], Defs = [AC0, AC1] in
+def MUL : EclipseInst<(outs), (ins), "MUL", []>;
+let Uses = [AC0, AC1, AC2], Defs = [AC0, AC1] in
+def DIV : EclipseInst<(outs), (ins), "DIV", []>;
+
+// Only unsigned div/rem are real pattern-matched pseudos: signed
+// division is decomposed at the DAG level (EclipseISelLowering.cpp's
+// LowerSDIVREM, Custom-lowering sdiv/srem) into absolute values, one of
+// these, and a conditional negate — see this file's MUL/DIV section
+// header comment for why.
+//
+// Expanded via expandPostRAPseudo (EclipseInstrInfo.cpp), not
+// EmitInstrWithCustomInserter: these pseudos need to temporarily
+// repurpose AC2 (the frame pointer) for the hardware operand convention,
+// and that's only safe to do *after* register allocation has finished —
+// pre-RA expansion would leave ordinary-looking MachineInstrs for the
+// register allocator to freely insert spill/reload code into, and any
+// such code landing inside the AC2-repurposed window would silently
+// compute frame-relative addresses against the wrong base. This was a
+// real, verified-the-hard-way bug (`(a/b)+(a%b)` in one function
+// produced a wrong result until this was fixed to expand post-RA,
+// matching how eccc's own func.rs treats FP save/restore around
+// MUL/DIV as a single uninterruptible unit).
+//
+// Defs lists only AC2: AC0/AC1 are *not* also listed here even though
+// the real expansion clobbers them too, because $dst/$lhs/$rhs (the
+// pseudo's own explicit outs/ins) already exhaust the entire
+// allocatable GPR pool (just AC0/AC1 — see EclipseRegisterInfo.cpp).
+// Redundantly listing them again as implicit Defs made the allocator
+// double-count register demand for this instruction and made it
+// impossible to allocate at all ("ran out of registers") — a second
+// real, verified-the-hard-way bug found immediately after fixing the
+// first one above.
+//
+// UDIVrr/UREMrr no longer carry `(set GPR:$dst, (udiv/urem ...))`
+// patterns: ISD::UDIV/UREM are now Expand (EclipseISelLowering.cpp's
+// constructor), not Legal, so no plain udiv/urem node ever survives to
+// reach these patterns — every udiv/urem, whether or not a matching
+// sibling is present, is legalized into ISD::UDIVREM and Custom-lowered
+// (LowerUDIVREM) straight to UDIVREMrr below instead. This is the real
+// fix for the DEBUGGING_NOTES.md-documented "quotient and remainder of
+// the same operands, needed live simultaneously, silently corrupt one
+// of the two results" bug: UDIVrr's and UREMrr's post-RA expansions each
+// unconditionally destroy AC0 *and* AC1 (priming/consuming the hardware
+// DIV operands) but only ever declared AC2 as clobbered — undeclared
+// because, per the comment above, declaring AC0/AC1 too made allocation
+// impossible outright. Two *separate* pseudo calls computing div and
+// rem of the same LHS/RHS each independently ran that full undeclared-
+// clobber sequence, so whichever ran second silently destroyed the
+// first's already-computed result sitting in AC0/AC1 with no way for
+// the register allocator to know to protect it. The real hardware DIV
+// instruction already produces *both* quotient (AC1) and remainder
+// (AC0) from a single execution regardless of which one the IR actually
+// asked for — UDIVrr/UREMrr individually ran that same full sequence
+// and simply discarded whichever half wasn't needed. UDIVREMrr below
+// runs it exactly once and declares *both* real outputs, so there's no
+// longer any undeclared clobber to hide: the register allocator sees
+// the true, complete register demand of a DIV up front. UDIVrr is kept
+// only for EclipseHalve's own dedicated Pat just below (an internal
+// GEP-offset-scaling divide-by-2 that never needs a remainder); UREMrr
+// is kept defined (still handled by expandPostRAPseudo) but is now
+// unreferenced by any pattern — left in place rather than deleted, in
+// case anything else ever needs a remainder-only pseudo again.
+let Defs = [AC2] in {
+def MULrr : EclipsePseudo<(outs GPR:$dst), (ins GPR:$lhs, GPR:$rhs), "# MUL",
+                           [(set GPR:$dst, (mul GPR:$lhs, GPR:$rhs))]>;
+def UDIVrr : EclipsePseudo<(outs GPR:$dst), (ins GPR:$lhs, GPR:$rhs), "# UDIV", []>;
+def UREMrr : EclipsePseudo<(outs GPR:$dst), (ins GPR:$lhs, GPR:$rhs), "# UREM", []>;
+
+// Combined quotient+remainder pseudo: see the long comment above. Built
+// directly as a machine node by EclipseISelLowering.cpp's LowerUDIVREM
+// (Custom-lowering ISD::UDIVREM), not matched here via a `(set ..., ...,
+// (udivrem ...))` Pat — this codebase has no existing precedent for
+// TableGen matching a 2-result generic SDNode straight to a 2-out
+// instruction, whereas the direct-DAG.getMachineNode approach already
+// has one (LowerSTACKSAVE/LowerDYNAMIC_STACKALLOC's VLAALLOC/
+// STACKSAVE_PSEUDO nodes). $quot/$rem's operand order matters: it must
+// match SDTIntBinHiLoOp's (and hence ISD::UDIVREM's) result order —
+// result 0 is the quotient, result 1 the remainder — which
+// expandPostRAPseudo's UDIVREMrr case (EclipseInstrInfo.cpp) also
+// assumes.
+def UDIVREMrr : EclipsePseudo<(outs GPR:$quot, GPR:$rem),
+                               (ins GPR:$lhs, GPR:$rhs), "# UDIVREM", []>;
+}
+// Pat (not itself an instruction) has no `Defs` field, so this must live
+// outside the `let Defs = [AC2] in { ... }` block above.
+def : Pat<(EclipseHalve GPR:$lhs, GPR:$rhs), (UDIVrr GPR:$lhs, GPR:$rhs)>;
+
+// Materializes one of two values based on a comparison, for plain boolean
+// results (`int b = a < c;`) and any `select`/ternary-shaped IR — there's
+// no hardware predicate-select instruction, so this always expands (via
+// EclipseISelLowering.cpp's custom inserter) into an actual two-way branch
+// diamond plus a PHI, using the same skip-test idiom as the real
+// conditional branches above. $condOpc names which of BRZ/BRNZ/BGEZ/BLTZ
+// tests $cmpval.
+let usesCustomInserter = 1 in
+def Select : EclipsePseudo<(outs GPR:$dst),
+                            (ins GPR:$cmpval, i16imm:$condOpc, GPR:$truev,
+                                 GPR:$falsev),
+                            "# SELECT", []>;
+
+// Unsigned counterpart to Select: branches on BGEU/BLTU (two live
+// operands) instead of a single pre-computed $cmpval — see
+// EclipseISD::BGEU's comment. $condOpc names which of BGEU/BLTU tests
+// $lhs/$rhs.
+let usesCustomInserter = 1 in
+def SelectU : EclipsePseudo<(outs GPR:$dst),
+                             (ins GPR:$lhs, GPR:$rhs, i16imm:$condOpc,
+                                  GPR:$truev, GPR:$falsev),
+                             "# SELECTU", []>;
+
+//===----------------------------------------------------------------------===//
+// Misc patterns
+//===----------------------------------------------------------------------===//
+
+// (No zext/sext/anyext patterns needed: i16 is the only integer type this
+// target legalizes to, so there's never a narrower legal type to extend
+// *from* — see EclipseISelLowering.cpp / README.md.)
+
+// (udiv/urem are Expand, not Legal, and reach a real instruction only
+// via ISD::UDIVREM's Custom lowering to UDIVREMrr above — see that
+// pseudo's comment for why, and the AC0-priming comment there for why
+// signed and unsigned division can't share one pseudo the way an
+// earlier version of this file did.)
diff --git a/llvm/lib/Target/Eclipse/EclipseMCInstLower.cpp b/llvm/lib/Target/Eclipse/EclipseMCInstLower.cpp
new file mode 100644
index 000000000..db157adc9
--- /dev/null
+++ b/llvm/lib/Target/Eclipse/EclipseMCInstLower.cpp
@@ -0,0 +1,66 @@
+//===-- EclipseMCInstLower.cpp - Convert MachineInstr to an MCInst ------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM
+// Exceptions. See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "EclipseMCInstLower.h"
+#include "llvm/CodeGen/AsmPrinter.h"
+#include "llvm/CodeGen/MachineBasicBlock.h"
+#include "llvm/CodeGen/MachineInstr.h"
+#include "llvm/MC/MCContext.h"
+#include "llvm/MC/MCExpr.h"
+#include "llvm/MC/MCInst.h"
+#include "llvm/Support/ErrorHandling.h"
+#include "llvm/Support/raw_ostream.h"
+
+using namespace llvm;
+
+MCOperand EclipseMCInstLower::lowerSymbolOperand(const MachineOperand &MO,
+                                                  MCSymbol *Sym) const {
+  const MCExpr *Expr = MCSymbolRefExpr::create(Sym, Ctx);
+  if (MO.getOffset())
+    Expr = MCBinaryExpr::createAdd(
+        Expr, MCConstantExpr::create(MO.getOffset(), Ctx), Ctx);
+  return MCOperand::createExpr(Expr);
+}
+
+void EclipseMCInstLower::Lower(const MachineInstr *MI, MCInst &OutMI) const {
+  OutMI.setOpcode(MI->getOpcode());
+
+  for (const MachineOperand &MO : MI->operands()) {
+    MCOperand MCOp;
+    switch (MO.getType()) {
+    case MachineOperand::MO_Register:
+      if (MO.isImplicit())
+        continue;
+      MCOp = MCOperand::createReg(MO.getReg());
+      break;
+    case MachineOperand::MO_Immediate:
+      MCOp = MCOperand::createImm(MO.getImm());
+      break;
+    case MachineOperand::MO_MachineBasicBlock:
+      MCOp = MCOperand::createExpr(
+          MCSymbolRefExpr::create(MO.getMBB()->getSymbol(), Ctx));
+      break;
+    case MachineOperand::MO_RegisterMask:
+      continue;
+    case MachineOperand::MO_GlobalAddress:
+      MCOp = lowerSymbolOperand(MO, Printer.getSymbol(MO.getGlobal()));
+      break;
+    case MachineOperand::MO_ExternalSymbol:
+      MCOp = lowerSymbolOperand(
+          MO, Printer.GetExternalSymbolSymbol(MO.getSymbolName()));
+      break;
+    case MachineOperand::MO_ConstantPoolIndex:
+      MCOp = lowerSymbolOperand(MO, Printer.GetCPISymbol(MO.getIndex()));
+      break;
+    default:
+      MI->print(errs());
+      llvm_unreachable("unknown Eclipse MachineOperand type");
+    }
+    OutMI.addOperand(MCOp);
+  }
+}
