diff --git a/clang/lib/Basic/Targets/Eclipse.h b/clang/lib/Basic/Targets/Eclipse.h
new file mode 100644
index 000000000..0307994e6
--- /dev/null
+++ b/clang/lib/Basic/Targets/Eclipse.h
@@ -0,0 +1,135 @@
+//===--- Eclipse.h - Declare Eclipse target feature support -----*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM
+// Exceptions. See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// TargetInfo for the Data General Nova/Eclipse (16-bit) target. Frontend
+// type sizes here must stay in lockstep with llvm/lib/Target/Eclipse's own
+// choices. `char` is the usual 8 bits (Clang doesn't allow a target to
+// customize that), even though the real machine has no byte-addressing
+// instructions — the backend handles this the ordinary way any
+// wider-than-8-bit-native target does: i8 values are promoted to i16 (see
+// EclipseISelLowering.cpp's Promote actions), so `char` physically occupies
+// a full word in a register or stack slot, matching the sibling `eccc`
+// project's own "char is stored one per 16-bit word" convention at the
+// storage-layout level even though the IR type is still formally i8.
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_CLANG_LIB_BASIC_TARGETS_ECLIPSE_H
+#define LLVM_CLANG_LIB_BASIC_TARGETS_ECLIPSE_H
+
+#include "clang/Basic/TargetInfo.h"
+#include "clang/Basic/TargetOptions.h"
+#include "llvm/ADT/APFloat.h"
+#include "llvm/Support/Compiler.h"
+#include "llvm/TargetParser/Triple.h"
+
+namespace clang {
+namespace targets {
+
+class LLVM_LIBRARY_VISIBILITY EclipseTargetInfo : public TargetInfo {
+  static const char *const GCCRegNames[];
+
+public:
+  EclipseTargetInfo(const llvm::Triple &Triple, const TargetOptions &)
+      : TargetInfo(Triple) {
+    TLSSupported = false;
+    NoAsmVariants = true;
+
+    // `char` is not a customizable width in this Clang version — it's
+    // always 8 bits, so this target's LLVM backend has to actually
+    // support i8 (promoted to i16), not lean on a nonstandard char size
+    // the way the earlier design comment here assumed. See
+    // EclipseISelLowering.cpp's i8/i1 Promote actions.
+    BoolWidth = BoolAlign = 16;
+    ShortWidth = ShortAlign = 16;
+    IntWidth = IntAlign = 16;
+    // No genuine 64-bit integer type is supported by the backend yet
+    // (see lib/Target/Eclipse/README.md "Known limitations") — `long
+    // long` is given the same width as `long` rather than silently
+    // producing i64 IR the backend can't legalize into anything correct.
+    LongWidth = LongLongWidth = 32;
+    LongAlign = LongLongAlign = 16;
+
+    // No hand-verified Eclipse FPU opcodes exist yet either (same
+    // README section) — float relies on the backend's soft-float
+    // (libcall) runtime rather than real hardware FP instructions.
+    FloatWidth = 32;
+    FloatAlign = 16;
+
+    // `double` is a 32-bit IEEE-754 *single*-precision alias for `float`
+    // on this target — the same choice AVR-GCC/AVR-Clang made (see
+    // clang/lib/Basic/Targets/AVR.h) for the same underlying reason: a
+    // real 64-bit `double` needs genuine 64-bit integer arithmetic to
+    // implement (mantissa shifts/adds/etc.), which this backend doesn't
+    // have (see README.md "Known limitations"), while the existing f32
+    // soft-float runtime (eclipse_rt.c) is already verified working.
+    // Setting DoubleFormat to IEEEsingle (not just DoubleWidth=32) is
+    // what actually makes Clang emit LLVM IR type `float` for C `double`
+    // (ASTContext::getFloatTypeSemantics drives CodeGenTypes::ConvertType)
+    // — without it, `double` would still be legalized as a 64-bit value
+    // this backend can't lower. `long double` is aliased the same way,
+    // matching AVR's precedent again.
+    DoubleWidth = LongDoubleWidth = 32;
+    DoubleAlign = LongDoubleAlign = 16;
+    DoubleFormat = LongDoubleFormat = &llvm::APFloat::IEEEsingle();
+
+    PointerWidth = PointerAlign = 16;
+    SuitableAlign = 16;
+
+    SizeType = UnsignedInt;
+    IntPtrType = SignedInt;
+    PtrDiffType = SignedInt;
+    IntMaxType = SignedLong;
+    SigAtomicType = SignedInt;
+
+    // Must match EclipseTargetMachine.cpp's computeDataLayout() exactly.
+    resetDataLayout("E-p:16:16-i16:16-i32:16-f32:16-f64:16-n16");
+  }
+
+  void getTargetDefines(const LangOptions &Opts,
+                         MacroBuilder &Builder) const override;
+
+  llvm::SmallVector<Builtin::InfosShard> getTargetBuiltins() const override {
+    return {};
+  }
+
+  bool allowsLargerPreferedTypeAlignment() const override { return false; }
+
+  bool hasFeature(StringRef Feature) const override {
+    return Feature == "eclipse";
+  }
+
+  ArrayRef<const char *> getGCCRegNames() const override;
+
+  ArrayRef<TargetInfo::GCCRegAlias> getGCCRegAliases() const override {
+    static const TargetInfo::GCCRegAlias GCCRegAliases[] = {
+        {{"ac0"}, "0"}, {{"ac1"}, "1"}, {{"ac2", "fp"}, "2"},
+        {{"ac3", "lr"}, "3"},
+    };
+    return llvm::ArrayRef(GCCRegAliases);
+  }
+
+  bool validateAsmConstraint(const char *&Name,
+                              TargetInfo::ConstraintInfo &) const override {
+    // No target-specific inline-asm constraints yet.
+    return false;
+  }
+
+  std::string_view getClobbers() const override { return ""; }
+
+  // `va_list` is just a plain pointer into the flat software stack (see
+  // EclipseISelLowering.cpp's LowerVASTART/LowerVAARG) — verified working
+  // end to end via eclipse_rt.c's printf/scanf.
+  BuiltinVaListKind getBuiltinVaListKind() const override {
+    return TargetInfo::CharPtrBuiltinVaList;
+  }
+};
+
+} // namespace targets
+} // namespace clang
+#endif // LLVM_CLANG_LIB_BASIC_TARGETS_ECLIPSE_H
