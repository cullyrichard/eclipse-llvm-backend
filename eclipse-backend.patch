@@ -0,0 +1,56 @@
+//===-- EclipseSubtarget.cpp - Eclipse Subtarget Information -------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM
+// Exceptions. See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "EclipseSubtarget.h"
+
+#define DEBUG_TYPE "eclipse-subtarget"
+
+#define GET_SUBTARGETINFO_TARGET_DESC
+#define GET_SUBTARGETINFO_CTOR
+#include "EclipseGenSubtargetInfo.inc"
+
+using namespace llvm;
+
+// ParseSubtargetFeatures itself is generated by GET_SUBTARGETINFO_CTOR
+// above (this target has no subtarget features to parse beyond the
+// generic default).
+
+EclipseSubtarget::EclipseSubtarget(const Triple &TT, StringRef CPU,
+                                    StringRef FS, const TargetMachine &TM)
+    : EclipseGenSubtargetInfo(TT, CPU, /*TuneCPU*/ CPU, FS),
+      InstrInfo(*this), FrameLowering(*this), TLInfo(TM, *this) {
+  ParseSubtargetFeatures(CPU.empty() ? "generic" : CPU,
+                          CPU.empty() ? "generic" : CPU, FS);
+}
+
+// See this method's declaration in EclipseSubtarget.h for why this exists
+// separately from EclipseTargetLowering's constructor's own
+// setLibcallImpl calls — both are needed, each reaching a different
+// LibcallLoweringInfo copy consulted by a different part of float
+// softening. Only f32 (`float`) is wired; `double` stays unimplemented
+// (see eclipse_rt.c's soft-float section).
+void EclipseSubtarget::initLibcallLoweringInfo(LibcallLoweringInfo &Info) const {
+  Info.setLibcallImpl(RTLIB::ADD_F32, RTLIB::impl___addsf3);
+  Info.setLibcallImpl(RTLIB::SUB_F32, RTLIB::impl___subsf3);
+  Info.setLibcallImpl(RTLIB::MUL_F32, RTLIB::impl___mulsf3);
+  Info.setLibcallImpl(RTLIB::DIV_F32, RTLIB::impl___divsf3);
+  // See the matching setLibcallImpl block in EclipseISelLowering.cpp's
+  // constructor for why these use the FCMP3_PRED_* (three-way -1/0/1)
+  // family rather than the plain OEQ_F32/UNE_F32/... boolean family.
+  Info.setLibcallImpl(RTLIB::FCMP3_PRED_OEQ_F32, RTLIB::impl___eqsf2);
+  Info.setLibcallImpl(RTLIB::FCMP3_PRED_UNE_F32, RTLIB::impl___nesf2);
+  Info.setLibcallImpl(RTLIB::FCMP3_PRED_OLT_F32, RTLIB::impl___ltsf2);
+  Info.setLibcallImpl(RTLIB::FCMP3_PRED_OLE_F32, RTLIB::impl___lesf2);
+  Info.setLibcallImpl(RTLIB::FCMP3_PRED_OGT_F32, RTLIB::impl___gtsf2);
+  Info.setLibcallImpl(RTLIB::FCMP3_PRED_OGE_F32, RTLIB::impl___gesf2);
+  Info.setLibcallImpl(RTLIB::UO_F32, RTLIB::impl___unordsf2);
+  Info.setLibcallImpl(RTLIB::SINTTOFP_I32_F32, RTLIB::impl___floatsisf);
+  Info.setLibcallImpl(RTLIB::UINTTOFP_I32_F32, RTLIB::impl___floatunsisf);
+  Info.setLibcallImpl(RTLIB::FPTOSINT_F32_I32, RTLIB::impl___fixsfsi);
+  Info.setLibcallImpl(RTLIB::FPTOUINT_F32_I32, RTLIB::impl___fixunssfsi);
+}
