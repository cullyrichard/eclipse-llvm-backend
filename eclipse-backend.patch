+namespace llvm {
+
+// Tracks the frame index marking where a variadic function's "..."
+// arguments begin, for LowerVASTART (EclipseISelLowering.cpp). Arguments
+// are pushed right-to-left on the flat software stack (see
+// LowerFormalArguments's comment), so the varargs simply start
+// immediately after the last named parameter — no register-save area to
+// model, unlike e.g. x86-64's varargs ABI.
+class EclipseMachineFunctionInfo : public MachineFunctionInfo {
+  int VarArgsFrameIndex = 0;
+
+public:
+  EclipseMachineFunctionInfo(const Function &, const TargetSubtargetInfo *) {}
+
+  int getVarArgsFrameIndex() const { return VarArgsFrameIndex; }
+  void setVarArgsFrameIndex(int FI) { VarArgsFrameIndex = FI; }
+};
