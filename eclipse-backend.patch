@@ -0,0 +1,95 @@
+//===-- EclipseSubtarget.cpp - Eclipse Subtarget Information -------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM
+// Exceptions. See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "EclipseSubtarget.h"
+
+#define DEBUG_TYPE "eclipse-subtarget"
+
+#define GET_SUBTARGETINFO_TARGET_DESC
+#define GET_SUBTARGETINFO_CTOR
+#include "EclipseGenSubtargetInfo.inc"
+
+using namespace llvm;
+
+// ParseSubtargetFeatures itself is generated by GET_SUBTARGETINFO_CTOR
+// above -- it sets HasHWFloat (see Eclipse.td's FeatureHWFloat and this
+// file's initLibcallLoweringInfo below) plus whatever else a future
+// SubtargetFeature adds; nothing else beyond that and the generic
+// default.
+
+const EclipseSubtarget &
+EclipseSubtarget::initializeSubtargetDependencies(StringRef CPU,
+                                                    StringRef FS) {
+  // Must run before TLInfo (EclipseTargetLowering) is constructed below
+  // -- see this method's declaration in EclipseSubtarget.h for why.
+  ParseSubtargetFeatures(CPU.empty() ? "generic" : CPU,
+                          CPU.empty() ? "generic" : CPU, FS);
+  return *this;
+}
+
+EclipseSubtarget::EclipseSubtarget(const Triple &TT, StringRef CPU,
+                                    StringRef FS, const TargetMachine &TM)
+    : EclipseGenSubtargetInfo(TT, CPU, /*TuneCPU*/ CPU, FS),
+      InstrInfo(initializeSubtargetDependencies(CPU, FS)),
+      FrameLowering(*this), TLInfo(TM, *this) {}
+
+// See this method's declaration in EclipseSubtarget.h for why this exists
+// separately from EclipseTargetLowering's constructor's own
+// setLibcallImpl calls — both are needed, each reaching a different
+// LibcallLoweringInfo copy consulted by a different part of float
+// softening. Only f32 (`float`) is wired; `double` stays unimplemented
+// (see eclipse_rt.c's soft-float section).
+void EclipseSubtarget::initLibcallLoweringInfo(LibcallLoweringInfo &Info) const {
+  // useHardwareFloat() (see EclipseSubtarget.h) swaps ADD_F32/SUB_F32 to
+  // the real-hardware-FPU implementations instead of the default
+  // software ones -- true unless `+ieee` opts back out to this target's
+  // original pure-IEEE-754 behavior (DEBUGGING_NOTES.md entry #30;
+  // `+hwfloat` alone, without `+ieee`, is equivalent to the new default
+  // -- see Eclipse.td's FeatureIEEEFloat). Everything else here is
+  // unconditional and identical regardless, matching
+  // EclipseISelLowering.cpp's own copy of this same choice (see this
+  // class's declaration for why both copies need it). MUL_F32/DIV_F32
+  // and int<->float conversion have no hardware path wired up on this
+  // target (FMS/FDS reconfirmed genuinely broken on eclipseemu at
+  // entry #30; FLAS/FFAS turned out reliable but only convert a single
+  // 16-bit AC, not this target's 32-bit `long` -- see Eclipse.td's
+  // FeatureHWFloat comment), so they stay on the software libcalls
+  // unconditionally, regardless of this setting.
+  bool UseHW = useHardwareFloat();
+  Info.setLibcallImpl(RTLIB::ADD_F32, UseHW ? RTLIB::impl___addsf3_hw
+                                             : RTLIB::impl___addsf3);
+  Info.setLibcallImpl(RTLIB::SUB_F32, UseHW ? RTLIB::impl___subsf3_hw
+                                             : RTLIB::impl___subsf3);
+  Info.setLibcallImpl(RTLIB::MUL_F32, RTLIB::impl___mulsf3);
+  Info.setLibcallImpl(RTLIB::DIV_F32, RTLIB::impl___divsf3);
+  // See the matching setLibcallImpl block in EclipseISelLowering.cpp's
+  // constructor for why these use the FCMP3_PRED_* (three-way -1/0/1)
+  // family rather than the plain OEQ_F32/UNE_F32/... boolean family.
+  Info.setLibcallImpl(RTLIB::FCMP3_PRED_OEQ_F32, RTLIB::impl___eqsf2);
+  Info.setLibcallImpl(RTLIB::FCMP3_PRED_UNE_F32, RTLIB::impl___nesf2);
+  Info.setLibcallImpl(RTLIB::FCMP3_PRED_OLT_F32, RTLIB::impl___ltsf2);
+  Info.setLibcallImpl(RTLIB::FCMP3_PRED_OLE_F32, RTLIB::impl___lesf2);
+  Info.setLibcallImpl(RTLIB::FCMP3_PRED_OGT_F32, RTLIB::impl___gtsf2);
+  Info.setLibcallImpl(RTLIB::FCMP3_PRED_OGE_F32, RTLIB::impl___gesf2);
+  Info.setLibcallImpl(RTLIB::UO_F32, RTLIB::impl___unordsf2);
+  Info.setLibcallImpl(RTLIB::SINTTOFP_I32_F32, RTLIB::impl___floatsisf);
+  Info.setLibcallImpl(RTLIB::UINTTOFP_I32_F32, RTLIB::impl___floatunsisf);
+  Info.setLibcallImpl(RTLIB::FPTOSINT_F32_I32, RTLIB::impl___fixsfsi);
+  Info.setLibcallImpl(RTLIB::FPTOUINT_F32_I32, RTLIB::impl___fixunssfsi);
+
+  // See the matching setLibcallImpl block in EclipseISelLowering.cpp's
+  // constructor for the full story: an initialized local aggregate
+  // (e.g. `int Array[10] = {...};`) can lower to an llvm.memcpy
+  // intrinsic needing the RTLIB::MEMCPY libcall, which otherwise
+  // defaults to Unsupported and SEGFAULTs (not a graceful error) deep
+  // in LowerCall. eclipse_rt.c already implements all four directly.
+  Info.setLibcallImpl(RTLIB::MEMCPY, RTLIB::impl_memcpy);
+  Info.setLibcallImpl(RTLIB::MEMMOVE, RTLIB::impl_memmove);
+  Info.setLibcallImpl(RTLIB::MEMSET, RTLIB::impl_memset);
+  Info.setLibcallImpl(RTLIB::MEMCMP, RTLIB::impl_memcmp);
+}
diff --git a/llvm/lib/Target/Eclipse/EclipseSubtarget.h b/llvm/lib/Target/Eclipse/EclipseSubtarget.h
