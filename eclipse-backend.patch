index 000000000..801225763
--- /dev/null
+++ b/llvm/lib/Target/Eclipse/MCTargetDesc/EclipseMCTargetDesc.h
@@ -0,0 +1,39 @@
+//===-- EclipseMCTargetDesc.h - Eclipse Target Descriptions ----*- C++ -*-===//
