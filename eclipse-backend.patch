+
+#include "EclipseMCTargetDesc.h"
+#include "EclipseInstPrinter.h"
+#include "EclipseMCAsmInfo.h"
+#include "TargetInfo/EclipseTargetInfo.h"
+#include "llvm/MC/MCInstrInfo.h"
+#include "llvm/MC/MCRegisterInfo.h"
+#include "llvm/MC/MCSubtargetInfo.h"
+#include "llvm/MC/TargetRegistry.h"
+#include "llvm/Support/Compiler.h"
+#include "llvm/TargetParser/Triple.h"
+
+#define GET_INSTRINFO_MC_DESC
+#include "EclipseGenInstrInfo.inc"
+
+#define GET_SUBTARGETINFO_MC_DESC
+#include "EclipseGenSubtargetInfo.inc"
+
+#define GET_REGINFO_MC_DESC
+#include "EclipseGenRegisterInfo.inc"
+
+using namespace llvm;
+
+static MCInstrInfo *createEclipseMCInstrInfo() {
+  MCInstrInfo *X = new MCInstrInfo();
+  InitEclipseMCInstrInfo(X);
+  return X;
+}
+
+static MCRegisterInfo *createEclipseMCRegisterInfo(const Triple & /*TT*/) {
+  MCRegisterInfo *X = new MCRegisterInfo();
+  // AC3 doubles as the return-address register (JSR clobbers it).
+  InitEclipseMCRegisterInfo(X, Eclipse::AC3, 0, 0, 0);
+  return X;
+}
+
+static MCSubtargetInfo *
+createEclipseMCSubtargetInfo(const Triple &TT, StringRef CPU, StringRef FS) {
+  return createEclipseMCSubtargetInfoImpl(TT, CPU.empty() ? "generic" : CPU,
+                                           /*TuneCPU*/ CPU.empty() ? "generic"
+                                                                    : CPU,
+                                           FS);
+}
+
+static MCInstPrinter *createEclipseMCInstPrinter(const Triple & /*T*/,
+                                                  unsigned SyntaxVariant,
+                                                  const MCAsmInfo &MAI,
+                                                  const MCInstrInfo &MII,
+                                                  const MCRegisterInfo &MRI) {
+  if (SyntaxVariant == 0)
+    return new EclipseInstPrinter(MAI, MII, MRI);
+  return nullptr;
+}
+
+extern "C" LLVM_ABI LLVM_EXTERNAL_VISIBILITY void
+LLVMInitializeEclipseTargetMC() {
+  Target &T = getTheEclipseTarget();
+  RegisterMCAsmInfo<EclipseMCAsmInfo> X(T);
+  TargetRegistry::RegisterMCInstrInfo(T, createEclipseMCInstrInfo);
+  TargetRegistry::RegisterMCRegInfo(T, createEclipseMCRegisterInfo);
+  TargetRegistry::RegisterMCSubtargetInfo(T, createEclipseMCSubtargetInfo);
+  TargetRegistry::RegisterMCInstPrinter(T, createEclipseMCInstPrinter);
+}
