@@ -0,0 +1,33 @@
+//===-- EclipseMCAsmInfo.cpp - Eclipse asm properties --------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM
+// Exceptions. See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "EclipseMCAsmInfo.h"
+#include "llvm/TargetParser/Triple.h"
+
+using namespace llvm;
+
+EclipseMCAsmInfo::EclipseMCAsmInfo(const Triple & /*TT*/,
+                                    const MCTargetOptions &Options)
+    : MCAsmInfo(Options) {
+  // Matches Connor Wood's `dgasm` (github.com/CWood1/dgasm) Eclipse-S140
+  // grammar, confirmed against its real lexer/parser by the sibling `eccc`
+  // project (crates/eccc-codegen/src/symbolic.rs) rather than assumed.
+  IsLittleEndian = false;
+  CodePointerSize = CalleeSaveStackSlotSize = 2;
+  CommentString = "//";
+  LabelSuffix = ":";
+  ZeroDirective = nullptr;
+  Data8bitsDirective = nullptr; // no sub-word data directive is used
+  Data16bitsDirective = "\tvar\t";
+  Data32bitsDirective = nullptr;
+  HasDotTypeDotSizeDirective = false;
+  HasFunctionAlignment = false;
+  HasSingleParameterDotFile = false; // no GNU-assembler ".file" in dgasm's grammar
+  SupportsDebugInformation = false; // no DWARF story for this target yet
+  UseIntegratedAssembler = false; // real output goes through dgasm, not us
+}
