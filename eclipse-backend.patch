new file mode 100644
index 000000000..54b84ad76
--- /dev/null
+++ b/llvm/lib/Target/Eclipse/EclipseISelLowering.h
@@ -0,0 +1,374 @@
+//===-- EclipseISelLowering.h - Eclipse DAG Lowering Interface -*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM
+// Exceptions. See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// i16 is the only legal scalar type (see EclipseRegisterInfo.td / README.md
+// — this deliberately mirrors the sibling `eccc` project's own "char is
+// stored one per 16-bit word" simplification). i32 and float ops are never
+// given a register class, so LLVM's generic type legalizer handles them on
+// its own: i32 add/sub/and/or/xor/shift/compare decompose automatically
+// into pairs of legal i16 ops (its default "expand" behavior for an
+// oversized integer type), and i32 multiply/divide plus all float
+// arithmetic fall back to its default runtime-libcall behavior. This
+// backend does not hand-encode i32 carry propagation or Eclipse FPU
+// opcodes at the SelectionDAG level — see README.md "Known limitations"
+// for why (nothing here would be empirically verified against real
+// hardware the way eccc's ISA facts are, and a wrong hand-rolled encoding
+// is worse than an honest libcall).
+//
+// Update: real Eclipse S/140 hardware FPU instructions (FAS/FSS) *were*
+// eventually empirically verified against eclipseemu (see
+// DEBUGGING_NOTES.md) — but they're used via an optional, opt-in
+// `+hwfloat` SubtargetFeature (Eclipse.td's FeatureHWFloat) that swaps
+// which *libcall implementation* ADD_F32/SUB_F32 resolve to (a
+// hand-written assembly wrapper, not SelectionDAG-level codegen — see
+// this constructor's own comment on that setLibcallImpl call), not a
+// new f32 register class or Custom op lowering. f32 still has no
+// register class here, and the reasoning above for why still holds for
+// everything this feature doesn't cover (multiply/divide, int<->float
+// conversion, and the entire default/software path, which remains
+// unconditionally what every existing invocation of this toolchain
+// gets).
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_LIB_TARGET_ECLIPSE_ECLIPSEISELLOWERING_H
+#define LLVM_LIB_TARGET_ECLIPSE_ECLIPSEISELLOWERING_H
+
+#include "llvm/CodeGen/TargetLowering.h"
+
+namespace llvm {
+
+class EclipseSubtarget;
+
+namespace EclipseISD {
+enum NodeType {
+  FIRST_NUMBER = ISD::BUILTIN_OP_END,
+  WRAPPER,  // Wraps a GlobalAddress/ExternalSymbol/ConstantPool address so
+            // it can be used as an LDABS/STABS/CALL operand (the base
+            // Nova/Eclipse ISA has no immediate-operand instructions at
+            // all, hence always going through an addressed data word).
+  WORD_ADD, // Emitted only by PerformDAGCombine, in place of a plain
+            // ISD::ADD, for "WRAPPER'd base pointer + already word-scaled
+            // runtime offset". Deliberately a distinct opcode rather than
+            // a plain ADD: selects to the exact same ADDrr instruction
+            // (see EclipseInstrInfo.td), but being structurally unable to
+            // match PerformDAGCombine's own `N->getOpcode() == ISD::ADD`
+            // check guarantees the combine can never re-fire on its own
+            // output — an earlier version used a plain ADD with a
+            // heuristic "already halved" check instead, which produced an
+            // infinite DAGCombine loop.
+  HALVE,    // Unsigned divide-by-2 (dividend, pre-materialized constant 2),
+            // used only by PerformDAGCombine's WORD_ADD offset. A generic
+            // ISD::SRL/ISD::UDIV was tried first and produced its own
+            // infinite loop: LowerShift Custom-lowers SRL-by-1 into
+            // UDIV(x,2), and DAGCombiner's own standard "udiv by power of
+            // two -> shift" fold immediately turns that back into an
+            // SRL-by-1 — forever, since SRL is only Custom (never
+            // strictly Legal) so each generated SRL re-enters LowerShift.
+            // HALVE selects straight to UDIVrr (see EclipseInstrInfo.td)
+            // and is invisible to both of those generic rules.
+  CALL,
+  CALL_INDIRECT, // Same shape as CALL, but the operand is a plain i16 GPR
+                 // value (a runtime-computed function pointer) rather than
+                 // a texternalsym -- see EclipseInstrInfo.td's CALLIND for
+                 // why this needs to be a distinct node/opcode rather than
+                 // just feeding a register operand into EclipseCall.
+  RET_FLAG,
+  RETI_FLAG,
+  BRZ,
+  BRNZ,
+  BGEZ,
+  BLTZ,
+  BGEU,     // Unsigned >=. Deliberately *not* the same lowering path as
+            // BGEZ: BGEZ tests the *sign bit* of a separately-computed
+            // SUB result (rotated into carry via MOVL#), which is a
+            // signed ">=0" test — correct for signed comparisons, but
+            // wrong for unsigned ones whenever the true (unsigned)
+            // relation disagrees with the sign of the difference (e.g.
+            // 65535u >= 8u is true, but 65535-8 = 65527 has its sign bit
+            // set, so a sign-bit test says "false"). This was a real,
+            // confirmed bug — canonBranchOpcode used to route SETUGE to
+            // BGEZ, and print_octal("%o", val) for any val >= 32768
+            // silently produced garbage as a result (traced with
+            // eclipseemu: the recursive digit-extraction branch simply
+            // never taken). BGEU/BLTU instead test the *native* carry
+            // produced by "SUB# rhs,lhs" directly (no separate rotate) —
+            // see EclipseAsmPrinter.cpp's emission and dgnsdk's
+            // dgnasm/language.md ("Subtract... if this operation
+            // produces a carry value of 1, then invert the Carry bit" —
+            // the standard two's-complement subtract-via-add identity,
+            // confirmed against eclipseemu). Needs both LHS and RHS as
+            // live operands (unlike BGEZ/BLTZ's single pre-computed
+            // value), since the carry has to be tested at the moment of
+            // subtraction, not recovered later from a stored result.
+  BLTU,     // Unsigned <. See BGEU.
+};
+} // namespace EclipseISD
+
+class EclipseTargetLowering : public TargetLowering {
+public:
+  EclipseTargetLowering(const TargetMachine &TM, const EclipseSubtarget &STI);
+
+  SDValue LowerOperation(SDValue Op, SelectionDAG &DAG) const override;
+
+  // Fixes up runtime (non-compile-time-constant) array/pointer offsets
+  // added to a WRAPPER'd GlobalAddress base — see the .cpp for why this
+  // can't be handled in LowerGlobalAddress itself (the offset doesn't
+  // exist yet at that point) nor in LDIND's expansion (which can't tell a
+  // global-array-index address apart from an already-word-granular
+  // frame-index address).
+  SDValue PerformDAGCombine(SDNode *N, DAGCombinerInfo &DCI) const override;
+
+  MachineBasicBlock *
+  EmitInstrWithCustomInserter(MachineInstr &MI,
+                               MachineBasicBlock *MBB) const override;
+
+  const char *getTargetNodeName(unsigned Opcode) const override;
+
+  // memcpy/memmove/memset lowering must never coalesce two *unaligned*
+  // bytes into one wider (i16) load/store: unlike a real byte-addressed
+  // machine, this target never actually packs two bytes into one word —
+  // every i8 gets its own full word (see this file's header comment and
+  // dgasm's VARIABLE_STRING format) *unless* the data is genuinely
+  // 2-byte-aligned i16 content (a numeric array/struct field, where 2
+  // DataLayout bytes really do mean 1 word — see EclipseAsmPrinter.cpp's
+  // emitGlobalVariable, one `var` line per numeric element). The generic
+  // default (EVT::Other) picks i16 chunks for anything long enough to
+  // look profitable regardless of alignment, then — for a 1-byte-aligned
+  // source (e.g. a `char arr[N] = {...}` initializer copied from a
+  // string constant) — expands each into two i8 sub-accesses combined
+  // via shift+or, as if reading from a genuinely packed 2-bytes-per-word
+  // source. It isn't, so the combined value is meaningless, and storing
+  // it back out corrupts whichever byte doesn't survive the round trip.
+  // Only fall back to i8 (one access per byte, matching what this target
+  // can actually do) when the *generic* logic couldn't safely assume
+  // 2-byte alignment either — an earlier version forced i8
+  // unconditionally, which broke ordinary aligned array copies (e.g.
+  // `int arr[] = {1,2,3,4,5};`) by pushing them over
+  // getMaxStoresPerMemcpy's chunk-count limit into a `memcpy` libcall
+  // this freestanding target has no way to lower (confirmed via a real
+  // `LowerCall` crash tracing straight back to SelectionDAG::getMemcpy).
+  EVT getOptimalMemOpType(LLVMContext &Context, const MemOp &Op,
+                           const AttributeList &FuncAttributes) const override {
+    return Op.isAligned(Align(2)) ? MVT::Other : MVT::i8;
+  }
+
+  // Same word-vs-byte confusion as getOptimalMemOpType above, hitting a
+  // different generic transform: TargetLowering::SimplifySetCC's "shorten
+  // the load feeding `(and load, const) == 0`" combine (TargetLowering.cpp,
+  // the `(LHS is '(and load, const)' ...` block) and DAGCombiner's sibling
+  // ReduceLoadWidth/ReduceLoadOpStoreWidth combines. Given `if (b & (1L <<
+  // 27))` on a 32-bit local `b`, this generic combine sees that only bit 27
+  // is ever demanded, notices all of the mask's set bits fall inside a
+  // single *byte* of the 32-bit value, and rewrites the whole `and load,
+  // const` into a narrower i8 load at that byte's offset plus a
+  // correspondingly right-shifted 8-bit mask (here: an i8 load at byte
+  // offset 0 ANDed with 0x08, standing in for the original `and (i32 load),
+  // 0x08000000`). That rewrite is only sound on hardware where an i8 load
+  // at a nonzero/interior byte offset actually extracts *that specific
+  // byte*, right-justified — true on essentially every byte-addressable
+  // target, but not this one: Eclipse has no LDB/STB (see this file's
+  // header comment on `char` storage), so EclipseISelDAGToDAG's i8-extload
+  // selection just loads the *containing 16-bit word verbatim*, unshifted.
+  // Declaring i8 EXTLOAD-from-i16 "Legal" above is correct only for loads
+  // that were already i8 in the IR (a real `char`, stored one-per-word, top
+  // byte always zero — no actual narrowing happens); it does not hold for
+  // an i8 load *synthesized* by narrowing a wider (e.g. i32) load down to
+  // one byte of a multi-word value, which is exactly what these combines
+  // do. Left unguarded, the synthesized load returns the whole word
+  // (e.g. 2048 = 0x0800) while the combine's precomputed mask (0x08)
+  // targets the low 8 bits it *assumed* the load would land in — so
+  // `AND(2048, 8)` is always 0 regardless of the true value of `b`,
+  // silently mis-evaluating the branch condition. Confirmed directly via
+  // `llc -debug-only=isel` on `if (b & (1L << 27)) b -= 1L << 28;`: the
+  // pre-legalization combine rewrote `and i32 %load, 134217728` into `and
+  // i8 %narrowload, 8`, and the emitted LDFI loaded the unshifted high word
+  // — the branch was silently never taken for *any* value of `b`, which
+  // from the C level looked like "the if-branch's store to `b` gets
+  // discarded" (see EclipseFrameLowering.cpp / PerformDAGCombine's WORD_ADD
+  // for the two sibling wide-value-addressing bugs this was first suspected
+  // to be a third instance of — it isn't; nothing downstream of the branch
+  // is wrong, the branch condition itself is computed wrong). Vetoing only
+  // i8 here leaves every width Eclipse actually supports untouched: i16
+  // reductions, and reducing a >16-bit load down to one of its already
+  // word-aligned i16 halves (handled correctly elsewhere by the type
+  // legalizer's own multi-word splitting), both still fire normally.
+  bool shouldReduceLoadWidth(
+      SDNode *Load, ISD::LoadExtType ExtTy, EVT NewVT,
+      std::optional<unsigned> ByteOffset = std::nullopt) const override {
+    if (NewVT == MVT::i8)
+      return false;
+    return TargetLowering::shouldReduceLoadWidth(Load, ExtTy, NewVT,
+                                                  ByteOffset);
+  }
+
+  // A compile-time-constant `getelementptr(i8, @global, N)` (a struct
+  // field access on a global reached directly, not through a loaded
+  // pointer) is supposed to be constant-folded by generic SelectionDAG
+  // machinery straight into GlobalAddressSDNode's own Offset field
+  // (SelectionDAG::FoldSymbolOffset, called from SelectionDAG::getNode
+  // whenever an ADD has a GlobalAddressSDNode operand) — and
+  // EclipseAsmPrinter.cpp's LEAGA case already correctly turns that
+  // embedded offset into a word-granular address (dividing by 2, exactly
+  // like every other "byte offset -> word offset" fix elsewhere in this
+  // backend). But that fold is gated behind
+  // TargetLowering::isOffsetFoldingLegal's *default* implementation,
+  // which asks TargetMachine::shouldAssumeDSOLocal — and that, in turn,
+  // falls through to `return false` for any GlobalValue that isn't
+  // already marked `dso_local` in the IR *and* whose object format isn't
+  // one of ELF/COFF/MachO/Wasm/XCOFF/GOFF (asserted, but the assert is
+  // compiled out in a release build). This target's triple
+  // (`eclipse-dg-none`) has none of those object formats — dgasm has no
+  // linker, no relocations, no shared libraries, no position-independent
+  // anything — so every global here fell through that default to "not
+  // foldable," and clang -cc1 never emits `dso_local` on this triple
+  // either (confirmed: `@bolshevic = global %struct.ziggy
+  // zeroinitializer` in the generated IR, no `dso_local` keyword).
+  //
+  // The practical effect, confirmed via `llc -debug-only=isel`: a
+  // constant struct-field GEP into a global (`bolshevic.b = 34`) reached
+  // PerformDAGCombine as a genuine, un-folded `ADD(GlobalAddress(bolshevic,
+  // offset=0), Constant(2))` instead of a pre-folded
+  // `GlobalAddress(bolshevic, offset=2)`. PerformDAGCombine's own
+  // "constant offset into a global" guard (see the .cpp, just above the
+  // HALVE emission) *deliberately* leaves such an ADD un-halved — that
+  // guard exists for a different, already-fixed bug (the type legalizer's
+  // own already-word-granular "access word N of an oversized global"
+  // address computation, which must NOT be halved again) — so this ADD
+  // fell through ISel as a plain, unhalved runtime add: `bolshevic + 2`
+  // computed as a raw word-address sum instead of `bolshevic + (2/2)`.
+  // That's off by a factor of 2 in the offset, landing on the *next*
+  // field's word instead of the intended one. It went unnoticed by any
+  // write-then-read-back-the-same-way test (both the errant write and a
+  // subsequent direct-global read compute the identical wrong address,
+  // so they agree with each other) — it only surfaces as a mismatch
+  // against a *different*, correctly-halving access path to the same
+  // field (e.g. reading the same field back through a separate pointer
+  // variable, which reaches PerformDAGCombine's loaded-pointer HALVE case
+  // instead and computes the right address) — exactly the "write and
+  // read of the identical field compute different physical addresses"
+  // symptom this target's DEBUGGING_NOTES.md documents (c-testsuite
+  // 00163/00205).
+  //
+  // Fix: override this rather than touch shouldAssumeDSOLocal or the
+  // triple's object-format classification (both are much bigger-blast-
+  // radius, target-independent-code changes, and this target's own
+  // relocation model is already forced to Reloc::Static
+  // unconditionally — see EclipseTargetMachine.cpp's
+  // getEffectiveRelocModel). On this freestanding, single-binary,
+  // linker-less target every global's address really is known and fixed
+  // at assemble time, with no notion of shared libraries or preemption at
+  // all — the whole DSO-locality question this hook exists to answer
+  // doesn't apply here, so unconditionally reporting every global
+  // foldable is correct, not just expedient.
+  bool
+  isOffsetFoldingLegal(const GlobalAddressSDNode *GA) const override {
+    return true;
+  }
+
+  // Inline asm: the escape hatch for device I/O instructions (SKPDN,
+  // SKPBN, DIAC, DOAS, NIO/NIOS/NIOC/NIOP), which have no ordinary-C
+  // mapping — see README.md. Only the generic "r" (any GPR) constraint is
+  // supported; there's no target-specific constraint letter yet.
+  std::pair<unsigned, const TargetRegisterClass *>
+  getRegForInlineAsmConstraint(const TargetRegisterInfo *TRI,
+                                StringRef Constraint, MVT VT) const override;
+
+private:
+  SDValue LowerGlobalAddress(SDValue Op, SelectionDAG &DAG) const;
+  SDValue LowerExternalSymbol(SDValue Op, SelectionDAG &DAG) const;
+  SDValue LowerConstantPool(SDValue Op, SelectionDAG &DAG) const;
+  SDValue LowerBR_CC(SDValue Op, SelectionDAG &DAG) const;
+  SDValue LowerBRCOND(SDValue Op, SelectionDAG &DAG) const;
+  SDValue LowerSELECT_CC(SDValue Op, SelectionDAG &DAG) const;
+  SDValue LowerSETCC(SDValue Op, SelectionDAG &DAG) const;
+  SDValue LowerVASTART(SDValue Op, SelectionDAG &DAG) const;
+  SDValue LowerVAARG(SDValue Op, SelectionDAG &DAG) const;
+  SDValue LowerDYNAMIC_STACKALLOC(SDValue Op, SelectionDAG &DAG) const;
+  SDValue LowerSTACKSAVE(SDValue Op, SelectionDAG &DAG) const;
+  SDValue LowerSTACKRESTORE(SDValue Op, SelectionDAG &DAG) const;
+  SDValue LowerSIGN_EXTEND_INREG(SDValue Op, SelectionDAG &DAG) const;
+
+  // No shift/rotate-with-writeback hardware is exposed yet (see
+  // EclipseInstrInfo.td's file header) — constant-count shifts are built
+  // from primitives already verified elsewhere in this backend: `x << 1`
+  // is `x + x`; `x >>u 1` is unsigned-divide-by-2; `x >>s 1` is
+  // signed-divide-by-2 with a floor-rounding correction (truncating
+  // division rounds toward zero, arithmetic shift must round toward
+  // -infinity — they differ for negative odd values). Variable-count
+  // shifts aren't supported yet (see README.md).
+  SDValue LowerShift(SDValue Op, SelectionDAG &DAG) const;
+
+  // The hardware DIV instruction's dividend is unsigned (see
+  // EclipseInstrInfo.td's MUL/DIV comment): a genuinely negative,
+  // sign-primed dividend was tried and is real backend-level complexity
+  // for no benefit, since it decomposes cleanly here instead — signed
+  // sdiv/srem reduce to unsigned division on abs(LHS)/abs(RHS) plus a
+  // conditional negate, built from SELECT_CC (already implemented and
+  // proven via comparisons/branches).
+  SDValue LowerSDIVREM(SDValue Op, SelectionDAG &DAG) const;
+
+  // Custom-lowers ISD::UDIVREM, produced by legalizing every plain
+  // udiv/urem (Expand, not Legal — see the setOperationAction comment in
+  // the constructor) and/or by DAGCombiner's own useDivRem() fusing an
+  // explicit matching udiv+urem pair, straight to a single UDIVREMrr
+  // machine node with both real outputs declared — see
+  // EclipseInstrInfo.td's UDIVREMrr comment for the full story (this is
+  // the fix for the "quotient and remainder of the same operands,
+  // needed live simultaneously, corrupt one of the two results" bug).
+  SDValue LowerUDIVREM(SDValue Op, SelectionDAG &DAG) const;
+
+  SDValue LowerFormalArguments(SDValue Chain, CallingConv::ID CallConv,
+                                bool IsVarArg,
+                                const SmallVectorImpl<ISD::InputArg> &Ins,
+                                const SDLoc &DL, SelectionDAG &DAG,
+                                SmallVectorImpl<SDValue> &InVals) const override;
+
+  SDValue LowerCall(TargetLowering::CallLoweringInfo &CLI,
+                     SmallVectorImpl<SDValue> &InVals) const override;
+
+  SDValue LowerReturn(SDValue Chain, CallingConv::ID CallConv, bool IsVarArg,
+                       const SmallVectorImpl<ISD::OutputArg> &Outs,
+                       const SmallVectorImpl<SDValue> &OutVals,
+                       const SDLoc &DL, SelectionDAG &DAG) const override;
+
+  MachineBasicBlock *emitSelectCC(MachineInstr &MI,
+                                   MachineBasicBlock *MBB) const;
+  // Same diamond-expansion shape as emitSelectCC, for the SelectU pseudo
+  // (unsigned SETCC/SELECT_CC) — kept separate because it branches on
+  // BGEU/BLTU (two live GPR operands) rather than a single pre-computed
+  // comparison value; see EclipseISD::BGEU's comment.
+  MachineBasicBlock *emitSelectCCU(MachineInstr &MI,
+                                    MachineBasicBlock *MBB) const;
+  MachineBasicBlock *emitPushPop(MachineInstr &MI, MachineBasicBlock *MBB,
+                                  bool IsPush) const;
+  MachineBasicBlock *emitAdjCallStack(MachineInstr &MI,
+                                       MachineBasicBlock *MBB,
+                                       bool IsDown) const;
+  MachineBasicBlock *emitIndirectMem(MachineInstr &MI, MachineBasicBlock *MBB,
+                                      bool IsLoad) const;
+  // LDINDW/STINDW: the EclipseWordAdd-address-specific counterpart to
+  // emitIndirectMem above, through the dedicated `_scratch2` page-zero
+  // word instead of the shared `_scratch` -- see EclipseInstrInfo.td's
+  // LDINDW/STINDW comment and DEBUGGING_NOTES.md entry #26.
+  MachineBasicBlock *emitIndirectMemWordAdd(MachineInstr &MI,
+                                             MachineBasicBlock *MBB,
+                                             bool IsLoad) const;
+  MachineBasicBlock *emitCallIndirect(MachineInstr &MI,
+                                       MachineBasicBlock *MBB) const;
+  MachineBasicBlock *emitVLAAlloc(MachineInstr &MI,
+                                   MachineBasicBlock *MBB) const;
+  MachineBasicBlock *emitStackSave(MachineInstr &MI,
+                                    MachineBasicBlock *MBB) const;
+  MachineBasicBlock *emitStackRestore(MachineInstr &MI,
+                                       MachineBasicBlock *MBB) const;
+};
+
+} // namespace llvm
+
+#endif // LLVM_LIB_TARGET_ECLIPSE_ECLIPSEISELLOWERING_H
diff --git a/llvm/lib/Target/Eclipse/EclipseInstrFormats.td b/llvm/lib/Target/Eclipse/EclipseInstrFormats.td
new file mode 100644
index 000000000..c7b0873e1
--- /dev/null
+++ b/llvm/lib/Target/Eclipse/EclipseInstrFormats.td
@@ -0,0 +1,37 @@
+//===- EclipseInstrFormats.td - Eclipse Instruction Formats *- tablegen -*-=//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM
+// Exceptions. See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// This backend never emits machine code directly (see README.md: like the
+// sibling `eccc` project, it treats Nova/Eclipse *assembly text* as the
+// ground truth and leaves bit-level encoding to a real assembler). So these
+// aren't real bit-layout Instruction encodings, just enough structure for
+// TableGen's InstrInfo/AsmWriter/DAGISel generators; `Size` and the (unused)
+// `Inst`/`outs` bit patterns below are nominal.
+//
+//===----------------------------------------------------------------------===//
+
+class EclipseInst<dag outs, dag ins, string asmstr, list<dag> pattern>
+    : Instruction {
+  let Namespace = "Eclipse";
+  dag OutOperandList = outs;
+  dag InOperandList = ins;
+  let AsmString = asmstr;
+  let Pattern = pattern;
+  field bits<16> Inst;
+  field bits<16> SoftFail = 0;
+  let Size = 2; // nominal word count; real emission is textual, see above
+}
+
+// A pseudo-instruction: exists only in MachineInstr form, either expanded by
+// a custom inserter (EmitInstrWithCustomInserter) into real EclipseInsts, or
+// printed directly by EclipseAsmPrinter as more than one line of real text
+// (e.g. the skip-then-jump conditional branches).
+class EclipsePseudo<dag outs, dag ins, string asmstr, list<dag> pattern>
+    : EclipseInst<outs, ins, asmstr, pattern> {
+  let isPseudo = 1;
+}
diff --git a/llvm/lib/Target/Eclipse/EclipseInstrInfo.cpp b/llvm/lib/Target/Eclipse/EclipseInstrInfo.cpp
