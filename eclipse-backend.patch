+
+char EclipseAsmPrinter::ID = 0;
+
+INITIALIZE_PASS(EclipseAsmPrinter, "eclipse-asm-printer",
+                 "Eclipse Assembly Printer", false, false)
+
+// dgasm's real string-literal escaping (confirmed against a real dgasm
+// binary by the sibling eccc project — crates/eccc-codegen/src/
+// symbolic.rs's escape_dgasm_string). NUL termination is dgasm's own job
+// ("dgasm NUL-terminates `var` strings automatically"), not added here.
+static std::string escapeDgasmString(StringRef S) {
+  std::string Out;
+  for (unsigned char B : S) {
+    switch (B) {
+    case '\n': Out += "\\n"; break;
+    case '\t': Out += "\\t"; break;
+    case '\r': Out += "\\r"; break;
+    case '"': Out += "\\\""; break;
+    case '\\': Out += "\\\\"; break;
+    default:
+      if (B >= 0x20 && B <= 0x7e)
+        Out += static_cast<char>(B);
+      else
+        Out += ("\\" + Twine::utohexstr(B)).str(); // best-effort; see README.md
+    }
+  }
+  return Out;
+}
+
+static StringRef stripSlotSuffix(StringRef SlotName) {
+  return SlotName.ends_with("_SLOT") ? SlotName.drop_back(5) : SlotName;
+}
+
+bool EclipseAsmPrinter::doInitialization(Module &M) {
+  HasMain = M.getFunction("main") != nullptr;
+  if (HasMain)
+    addCallSlot("main_SLOT");
+
+  for (const Function &F : M) {
+    if (F.isDeclaration() || !F.hasFnAttribute("interrupt"))
+      continue;
+    if (!InterruptHandlerName.empty()) {
+      std::string Msg =
+          ("Eclipse backend: more than one __attribute__((interrupt)) "
+           "function in this module (\"" +
+           Twine(InterruptHandlerName) + "\" and \"" + F.getName() +
+           "\") -- real hardware has exactly one interrupt vector (memory "
+           "location 1), so only one handler is possible.")
+              .str();
+      report_fatal_error(StringRef(Msg));
+    }
+    InterruptHandlerName = std::string(F.getName());
+  }
+
+  return AsmPrinter::doInitialization(M);
+}
+
+void EclipseAsmPrinter::emitStartOfAsmFile(Module &M) {
+  OutStreamer->emitRawText(
+      "// Generated by the Eclipse LLVM backend (see README.md)");
+  OutStreamer->emitRawText(
+      "// Assemble with: dgasm -t eclipse_s140 -f simh -o out.simh <this file>");
+  if (!InterruptHandlerName.empty()) {
+    // Real hardware jumps indirect through memory location 1 on interrupt
+    // entry (see the Eclipse S/140 Programmer's Reference's Program Flow
+    // Interruption section, and this backend's RETI/INTEN/JMPABSI, which
+    // implement the matching return sequence) -- this fixed word has to
+    // hold the handler's address before anything else runs. Emitted here,
+    // ahead of even "org 0100", so reorder_asm.py's preamble detection
+    // (which takes *everything* through the first "var _scratch" line as
+    // fixed and untouched -- see its own header comment) carries it
+    // through unmolested, exactly like every hand-verified
+    // interrupt_testN.s test in this project's development history did by
+    // hand.
+    OutStreamer->emitRawText("org 1");
+    OutStreamer->emitRawText(
+        ("var VECTOR = " + Twine(InterruptHandlerName)).str());
+    OutStreamer->emitRawText("");
+  }
+  OutStreamer->emitRawText("org 0100"); // just a default; see README.md
+  OutStreamer->emitRawText("dev TTI = 010");
+  OutStreamer->emitRawText("dev TTO = 011");
+  OutStreamer->emitRawText("");
+  if (HasMain) {
+    OutStreamer->emitRawText("_start:");
+    OutStreamer->emitRawText("\tJSR @main_SLOT,0");
+    OutStreamer->emitRawText("\tHALT");
+    OutStreamer->emitRawText("");
+  }
+  OutStreamer->emitRawText("// --- fixed runtime state ---");
+  OutStreamer->emitRawText("var _SP = 020000");
+  OutStreamer->emitRawText("var _scratch = 0");
+  OutStreamer->emitRawText("");
+}
+
+void EclipseAsmPrinter::emitEndOfAsmFile(Module &M) {
+  OutStreamer->emitRawText("");
+  OutStreamer->emitRawText("// --- indirect call jump table ---");
+  for (const std::string &Slot : CallSlots)
+    OutStreamer->emitRawText(
+        ("var " + Twine(Slot) + " = " + stripSlotSuffix(Slot)).str());
+
+  if (!AddrSlots.empty()) {
+    OutStreamer->emitRawText("");
+    OutStreamer->emitRawText("// --- global address slots (LEAGA) ---");
+    for (const std::string &Target : AddrSlots)
+      OutStreamer->emitRawText(
+          ("var " + Twine(Target) + "_PTR = " + Target).str());
+  }
+
+  if (!OffsetSlots.empty()) {
+    OutStreamer->emitRawText("");
+    OutStreamer->emitRawText("// --- LEAGA offset constants ---");
+    for (auto &Entry : OffsetSlots)
+      OutStreamer->emitRawText(
+          ("var " + Twine(Entry.first) + " = " + Twine(Entry.second)).str());
+  }
+}
+
+void EclipseAsmPrinter::emitGlobalVariable(const GlobalVariable *GV) {
+  MCSymbol *Sym = getSymbol(GV);
+  if (!GV->hasInitializer()) {
+    OutStreamer->emitRawText(("var " + Twine(Sym->getName()) + " = 0").str());
+    return;
+  }
+  const Constant *Init = GV->getInitializer();
+
+  if (const auto *CDA = dyn_cast<ConstantDataArray>(Init)) {
+    if (CDA->isString()) {
+      StringRef S = CDA->getAsString();
+      S.consume_back(StringRef("\0", 1)); // dgasm adds its own terminator
+      OutStreamer->emitRawText(("var " + Twine(Sym->getName()) + " = \"" +
+                                 escapeDgasmString(S) + "\"")
+                                    .str());
+      return;
+    }
+  }
+
+  if (const auto *CI = dyn_cast<ConstantInt>(Init)) {
+    // A scalar initializer wider than one Eclipse word (e.g. a 32-bit
+    // `long`/`unsigned long`, this target's only scalar type besides i16)
+    // needs one `var` line *per word*, most-significant first — the same
+    // multi-word layout the `_off1`/"access word N" indirect-addressing
+    // scheme (see LEAGA's emitInstruction case and
+    // EclipseISelLowering.cpp's PerformDAGCombine) already assumes every
+    // >16-bit global has. A single `var NAME = <64-bit decimal value>`
+    // line here does NOT do that: dgasm's `var` only ever reserves and
+    // deposits *one* word, silently truncating the decimal value to its
+    // low 16 bits at parse time. This was a real, previously-undiscovered
+    // bug, not a hypothetical: confirmed by tracing a `static u32 g_a =
+    // 0x40400000UL;` global on eclipseemu all the way down to its actual
+    // deposited memory contents — both words came back 0x0000 (0x40400000
+    // truncated mod 2^16 happens to be exactly 0 for that value, which is
+    // what made it look, from the *load* side alone, like a "high word
+    // right, low word wrong" bug rather than "the global's storage was
+    // never really 32 bits wide in the first place"). Any 32-bit-wide
+    // global's arithmetic silently corrupts as a result, regardless of
+    // whether the *load* path is otherwise correct.
+    unsigned BitWidth = CI->getBitWidth();
+    if (BitWidth <= 16) {
+      OutStreamer->emitRawText(("var " + Twine(Sym->getName()) + " = " +
+                                 Twine(CI->getSExtValue()))
+                                    .str());
+      return;
+    }
+    APInt Val = CI->getValue();
+    unsigned NumWords = (BitWidth + 15) / 16;
+    for (unsigned i = 0; i != NumWords; ++i) {
+      unsigned ShiftAmt = (NumWords - 1 - i) * 16;
+      int16_t Word =
+          static_cast<int16_t>(Val.lshr(ShiftAmt).trunc(16).getZExtValue());
+      // Only the first (most-significant) word keeps the real symbol
+      // name — LEAGA/the `_PTR` slot always materializes *this* word's
+      // address, and every later word is only ever reached relative to
+      // it via the `_off1`-style mechanism, never addressed by its own
+      // name — same convention emitArrayElements below already uses for
+      // array elements past the first.
+      std::string Name = i == 0 ? Sym->getName().str()
+                                 : (Sym->getName() + "_word" + Twine(i)).str();
+      OutStreamer->emitRawText(
+          ("var " + Twine(Name) + " = " + Twine(static_cast<int64_t>(Word)))
+              .str());
+    }
+    return;
+  }
+
+  // Numeric array initializer (e.g. `static const unsigned int prog[] =
+  // {...}`) — every array element becomes its own `var` line, in order,
+  // so dgasm's own sequential address assignment (each `var` line takes
+  // the next word) naturally lays them out contiguously; C-level
+  // pointer/index arithmetic on the array (computed relative to the
+  // *first* element's address, which is this global's own symbol) then
+  // finds every later element correctly with no further backend support
+  // needed. Only the first element keeps the real symbol name — the
+  // rest just need *a* unique, never-referenced-by-name label so dgasm
+  // accepts the declaration; nothing ever addresses them by name.
+  //
+  // This was a real, silent bug before this comment existed: an array
+  // initializer that reached neither the ConstantInt nor the
+  // ConstantDataArray-isString() case above fell through to a single
+  // placeholder `var NAME = 0` word instead of the real data — so any
+  // array with more than one element silently lost everything past its
+  // first word, and indexing into it read whatever unrelated global
+  // happened to be laid out next. Found by tracing actual DOA/DOB
+  // values sent to a real device on eclipseemu and discovering the
+  // "array" data was actually a different global's string contents.
+  auto emitArrayElements = [&](unsigned NumElts,
+                                llvm::function_ref<int64_t(unsigned)> At) {
+    for (unsigned i = 0; i != NumElts; ++i) {
+      std::string Name = i == 0 ? Sym->getName().str()
+                                 : (Sym->getName() + "_elem" + Twine(i)).str();
+      OutStreamer->emitRawText(
+          ("var " + Twine(Name) + " = " + Twine(At(i))).str());
+    }
+  };
+
+  if (const auto *CDA = dyn_cast<ConstantDataArray>(Init)) {
+    // Reached only for the non-string (numeric) case now — isString()
+    // was already handled and returned above.
+    emitArrayElements(CDA->getNumElements(), [&](unsigned i) {
+      return CDA->getElementAsAPInt(i).getSExtValue();
+    });
+    return;
+  }
+
+  if (const auto *CA = dyn_cast<ConstantArray>(Init)) {
+    emitArrayElements(CA->getNumOperands(), [&](unsigned i) {
+      if (const auto *Elt = dyn_cast<ConstantInt>(CA->getOperand(i)))
+        return Elt->getSExtValue();
+      return int64_t{0}; // non-integer element: still not supported
+    });
+    return;
+  }
+
+  if (isa<ConstantAggregateZero>(Init)) {
+    if (auto *AT = dyn_cast<ArrayType>(GV->getValueType())) {
+      emitArrayElements(AT->getNumElements(), [](unsigned) { return 0; });
+      return;
+    }
+  }
+
+  // Structs and anything else beyond a simple i16 scalar, string
+  // literal, or numeric array aren't materialized yet — see README.md
+  // "Known limitations".
+  OutStreamer->emitRawText(
+      ("var " + Twine(Sym->getName()) + " = 0 // TODO: unsupported initializer")
+          .str());
+}
+
+void EclipseAsmPrinter::emitConstantPool() {
+  const MachineConstantPool *MCP = MF->getConstantPool();
+  const std::vector<MachineConstantPoolEntry> &Entries = MCP->getConstants();
+  if (Entries.empty())
+    return;
+  for (unsigned i = 0, e = Entries.size(); i != e; ++i) {
+    const MachineConstantPoolEntry &E = Entries[i];
+    if (E.isMachineConstantPoolEntry())
+      continue; // not used by this backend
+    int64_t Value = 0;
+    if (const auto *CI = dyn_cast<ConstantInt>(E.Val.ConstVal))
+      Value = CI->getSExtValue();
+    OutStreamer->emitRawText(
+        ("var " + Twine(GetCPISymbol(i)->getName()) + " = " + Twine(Value))
+            .str());
+  }
+}
+
+namespace {
+// Which real skip-test instruction each conditional branch pseudo prints,
+// and whether it's the zero test (MOV#) or the sign test (MOVL#) — see
+// docs/CALLING_CONVENTION.md's verified idiom in the sibling eccc project.
+struct SkipTest {
+  const char *Mnemonic; // "MOV#" or "MOVL#"
+  const char *Skip;     // "SZR", "SNR", "SZC", "SNC"
+};
+
+// The printed sequence is "<test>,<skip>" then "JMP $dst": the *skip*
+// fires (and the JMP is *not* taken) exactly when the skip-condition
+// holds. So to make the JMP execute — i.e. actually branch — precisely
+// when this pseudo's own named condition holds, each one needs the
+// *opposite* skip test: BRZ (branch when val==0) must skip when val!=0
+// (SNR), not when val==0 (that would skip the JMP in exactly the case
+// BRZ is supposed to take it). Same inversion for the other three.
+SkipTest skipTestFor(unsigned Opcode) {
+  switch (Opcode) {
+  case Eclipse::BRZ:
+    return {"MOV#", "SNR"};
+  case Eclipse::BRNZ:
+    return {"MOV#", "SZR"};
+  case Eclipse::BGEZ:
+    return {"MOVL#", "SNC"};
+  case Eclipse::BLTZ:
+    return {"MOVL#", "SZC"};
+  // BGEU/BLTU aren't in this table: unlike the other four, they test the
+  // *native* carry from "SUB# rhs,lhs" directly, not a rotated copy of a
+  // single already-computed value — see emitInstruction's own BGEU/BLTU
+  // case, which prints "SUB#" (not this function's Mnemonic) against two
+  // distinct operands. Same skip letters apply, though (SNC/SZC), which
+  // is why they're documented alongside these here rather than
+  // separately: BGEU's "branch if no borrow occurred" is the same SNC
+  // used by BGEZ's "branch if sign bit clear", just fed by a different
+  // preceding instruction.
+  default:
+    llvm_unreachable("not a conditional branch");
+  }
+}
+} // namespace
+
+void EclipseAsmPrinter::emitInstruction(const MachineInstr *MI) {
+  switch (MI->getOpcode()) {
+  case Eclipse::BRZ:
+  case Eclipse::BRNZ:
+  case Eclipse::BGEZ:
+  case Eclipse::BLTZ: {
+    SkipTest T = skipTestFor(MI->getOpcode());
+    StringRef Reg = EclipseInstPrinter::getRegisterName(MI->getOperand(0).getReg());
+    OutStreamer->emitRawText(
+        (Twine("\t") + T.Mnemonic + " " + Reg + "," + Reg + "," + T.Skip).str());
+    OutStreamer->emitRawText(
+        (Twine("\tJMP ") + MI->getOperand(1).getMBB()->getSymbol()->getName())
+            .str());
+    return;
+  }
+  case Eclipse::BGEU:
+  case Eclipse::BLTU: {
+    // Bare "SUB# rhs,lhs,<skip>" (the original design here) turned out to
+    // be a genuine hardware bug in this lowering, not just a documentation
+    // slip: on real Nova/Eclipse ALU encoding, the carry field of a plain
+    // SUB (no Z/O/C modifier) is "none" — the carry it leaves behind is
+    // *whatever carry was already set* before the instruction executed,
+    // completely independent of lhs/rhs. Confirmed empirically against
+    // eclipseemu with a direct carry-in/carry-out truth table: bare SUB#'s
+    // carry-out equals its carry-in in all four (carry-in, lhs-vs-rhs)
+    // combinations tested. This is what caused the "same source, different
+    // compiled skip letter" contradiction — the residual carry differs by
+    // program, not the node type.
+    //
+    // The real fix needs a *forced* carry-in, i.e. "SUBZ" (the Z carry
+    // modifier). But SUBZ can't be combined with "#" (test mode / no
+    // writeback) — that specific combination decodes as an unrelated XOP
+    // instruction on this hardware/simulator (also confirmed empirically:
+    // "ADDZ#"/"SUBZ#" both mis-decode). So the comparison can't be done
+    // in a single non-clobbering instruction the way the signed BGEZ/BLTZ
+    // path does.
+    //
+    // Instead: borrow AC2 (the frame pointer) as scratch, exactly like the
+    // MUL/DIV pseudo-expansion already does elsewhere in this file/backend
+    // — save it to the software stack, copy lhs into it, SUBZ rhs into it
+    // (now carry is a clean, deterministic function of lhs/rhs only:
+    // confirmed via truth table that carry=1 iff lhs>=rhs, unsigned),
+    // restore AC2, then read that already-set carry with a *bare* "SUB#"
+    // self-test (confirmed pure carry passthrough, i.e. doesn't disturb
+    // the carry we just restored-past) purely to attach the skip
+    // modifier. DSZ/STA/LDA/ISZ (the save/restore sequence) were each
+    // confirmed not to disturb carry either.
+    // Skip-field semantics confirmed via a direct, isolated eclipseemu
+    // test (deposit carry explicitly, execute *only* the skip
+    // instruction, watch whether PC advances by one word or two): "SZC"
+    // fires (skips) when C=1, "SNC" fires when C=0 — the opposite of
+    // what the mnemonics suggest. Combined with the SUBZ truth table
+    // above (C=1 iff lhs>=rhs), BGEU needs "SNC" (skip — i.e. don't take
+    // the branch — when C=0/lhs<rhs) and BLTU needs "SZC" (skip when
+    // C=1/lhs>=rhs).
+    const char *Skip = MI->getOpcode() == Eclipse::BGEU ? "SNC" : "SZC";
+    StringRef Lhs = EclipseInstPrinter::getRegisterName(MI->getOperand(0).getReg());
+    StringRef Rhs = EclipseInstPrinter::getRegisterName(MI->getOperand(1).getReg());
+    OutStreamer->emitRawText("\tDSZ _SP,0");
+    OutStreamer->emitRawText("\tSTA 2,@_SP");
+    OutStreamer->emitRawText((Twine("\tMOV ") + Lhs + ",2").str());
+    OutStreamer->emitRawText((Twine("\tSUBZ ") + Rhs + ",2").str());
+    OutStreamer->emitRawText("\tLDA 2,@_SP");
+    OutStreamer->emitRawText("\tISZ _SP,0");
+    OutStreamer->emitRawText((Twine("\tSUB# 2,2,") + Skip).str());
+    OutStreamer->emitRawText(
+        (Twine("\tJMP ") + MI->getOperand(2).getMBB()->getSymbol()->getName())
+            .str());
+    return;
+  }
+  case Eclipse::CALL: {
+    StringRef Slot = MI->getOperand(0).getSymbolName();
+    addCallSlot(Slot);
+    break; // fall through to normal lowering for the JSR text itself
+  }
+  case Eclipse::LEAGA: {
+    StringRef Dst = EclipseInstPrinter::getRegisterName(MI->getOperand(0).getReg());
+    StringRef Target = getSymbol(MI->getOperand(1).getGlobal())->getName();
+    addAddrSlot(Target);
+    OutStreamer->emitRawText(
+        (Twine("\tLDA ") + Dst + "," + Target + "_PTR").str());
+
+    // A GlobalAddress operand's offset is real: `opt` folds a
+    // compile-time-constant `getelementptr(@global, N)` (from indexing
+    // an array with a literal, or one the optimizer proved constant)
+    // directly into this offset field rather than leaving it as a
+    // separate runtime ADD — confirmed by inspecting the IR this
+    // backend actually receives (`getelementptr inbounds nuw (i8, ptr
+    // @foo, i16 N)` baked into the load's pointer operand). Previously
+    // ignored entirely here: every LEAGA silently loaded the global's
+    // *base* address regardless of N, so indexed access anywhere past
+    // element 0 of an array read whatever unrelated data happened to
+    // follow it in memory — a real, confirmed-the-hard-way bug (traced
+    // actual DOA/DOB values sent to a real device on eclipseemu against
+    // the known-correct source data to find it).
+    //
+    // AC2 is temporarily repurposed as scratch to hold the offset
+    // constant for the ADD, saved/restored around it exactly like
+    // MULrr/UDIVrr's post-RA expansion already does for the hardware
+    // MUL/DIV operand convention (EclipseInstrInfo.cpp) — $dst is
+    // always AC0 or AC1 (LEAGA's register class excludes the reserved
+    // AC2/AC3), so this can never save/restore the wrong register.
+    //
+    // MI->getOperand(1).getOffset() is a *byte* offset (LLVM's
+    // GlobalAddress offsets always are), but this backend's addresses
+    // are word-granular (every Eclipse word is 2 of those DataLayout
+    // bytes — same reason EclipseFrameLowering::
+    // processFunctionBeforeFrameFinalized divides object sizes by 2).
+    // Adding the raw byte count here landed 2x too far — confirmed the
+    // hard way: reading at "base + 10" actually returned element 10's
+    // value, not element 5's, once traced against the real deposited
+    // memory addresses in a generated .simh.
+    //
+    // That "2 DataLayout bytes per word" rule only holds for globals
+    // this backend actually *packs* two-bytes-to-a-word — i.e. numeric
+    // array initializers, emitted one full word per element by
+    // emitGlobalVariable below regardless of the element's own
+    // DataLayout size (so 2 bytes worth of *offset* really does mean 1
+    // word of address). A string literal is emitted completely
+    // differently: dgasm's `var name = "..."` (no `packed` suffix, what
+    // emitGlobalVariable emits) reserves one full word *per character*
+    // (see dgasm's assembler.c, VARIABLE_STRING vs VARIABLE_PACKED_STRING)
+    // — so a byte offset into a string is already a word offset, and
+    // dividing it by 2 here truncates every *odd* byte offset down to
+    // its even neighbour's word (bytes 2 and 3 both landing on word 1,
+    // etc.), silently reading/writing the wrong character. Found via a
+    // local `char arr[5] = {'H','e','l','l','o'}` whose compiler-
+    // generated initializer copy (an unaligned `llvm.memcpy` from the
+    // string constant, expanded into byte-sized sub-loads by LLVM's
+    // generic unaligned-access lowering) corrupted exactly the odd-byte-
+    // offset accesses this truncation predicts.
+    int64_t Divisor = 2;
+    if (const auto *GV = dyn_cast<GlobalVariable>(MI->getOperand(1).getGlobal())) {
+      if (GV->hasInitializer()) {
+        if (const auto *CDA = dyn_cast<ConstantDataArray>(GV->getInitializer()))
+          if (CDA->isString())
+            Divisor = 1;
+      }
+    }
+    int64_t Offset = MI->getOperand(1).getOffset() / Divisor;
+    if (Offset != 0) {
+      std::string OffSym = addOffsetSlot(Target, Offset);
+      OutStreamer->emitRawText("\tDSZ _SP,0");
+      OutStreamer->emitRawText("\tSTA 2,@_SP");
+      OutStreamer->emitRawText(("\tLDA 2," + Twine(OffSym)).str());
+      OutStreamer->emitRawText((Twine("\tADD 2,") + Dst).str());
+      OutStreamer->emitRawText("\tLDA 2,@_SP");
+      OutStreamer->emitRawText("\tISZ _SP,0");
+    }
+    return;
+  }
+  default:
+    break;
+  }
+
+  EclipseMCInstLower Lower(OutContext, *this);
+  MCInst TmpInst;
+  Lower.Lower(MI, TmpInst);
+  EmitToStreamer(*OutStreamer, TmpInst);
+}
+
+void EclipseAsmPrinter::printOperand(const MachineInstr *MI, int OpNum,
+                                      raw_ostream &O) {
+  const MachineOperand &MO = MI->getOperand(OpNum);
+  switch (MO.getType()) {
+  case MachineOperand::MO_Register:
+    O << EclipseInstPrinter::getRegisterName(MO.getReg());
+    break;
+  case MachineOperand::MO_Immediate:
+    O << MO.getImm();
+    break;
+  case MachineOperand::MO_MachineBasicBlock:
+    MO.getMBB()->getSymbol()->print(O, MAI);
+    break;
+  case MachineOperand::MO_GlobalAddress:
+    getSymbol(MO.getGlobal())->print(O, MAI);
+    break;
+  case MachineOperand::MO_ExternalSymbol:
+    GetExternalSymbolSymbol(MO.getSymbolName())->print(O, MAI);
+    break;
+  default:
+    llvm_unreachable("unsupported inline-asm operand kind");
+  }
+}
+
+// No ExtraCode ('%a'/'%c'/'%n'/'%s'-style) modifiers are supported yet —
+// only plain %0/%1/... substitution, which is all a device-I/O
+// instruction's operands (an accumulator, a device code) need.
+bool EclipseAsmPrinter::PrintAsmOperand(const MachineInstr *MI, unsigned OpNo,
+                                         const char *ExtraCode,
+                                         raw_ostream &O) {
+  if (ExtraCode && ExtraCode[0])
+    return true; // unknown/unsupported modifier
+  printOperand(MI, OpNo, O);
+  return false;
+}
+
+extern "C" LLVM_ABI LLVM_EXTERNAL_VISIBILITY void
+LLVMInitializeEclipseAsmPrinter() {
+  RegisterAsmPrinter<EclipseAsmPrinter> X(getTheEclipseTarget());
+}
diff --git a/llvm/lib/Target/Eclipse/EclipseAsmPrinter.h b/llvm/lib/Target/Eclipse/EclipseAsmPrinter.h
new file mode 100644
index 000000000..2c2b2c809
--- /dev/null
+++ b/llvm/lib/Target/Eclipse/EclipseAsmPrinter.h
@@ -0,0 +1,154 @@
+//===-- EclipseAsmPrinter.h - Eclipse LLVM assembly writer -----*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM
+// Exceptions. See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// Drives the module-level structure a real dgasm source file needs (an
+// `org`/`dev` preamble, an optional `_start`/HALT entry trampoline when
+// the module defines `main`, `var` declarations for globals/string
+// literals/constant-pool entries, and one `var <callee>_SLOT = <callee>`
+// per distinct call target for the indirect-call jump table) around the
+// per-function instruction text. See README.md and the sibling `eccc`
+// project's crates/eccc-codegen/src/symbolic.rs, which this mirrors.
+//
+// IMPORTANT — page-zero placement: all `var` declarations (constant
+// pool, globals, the jump table, `_SP`/`_scratch`) must physically end up
+// within the first ~200 words of the address space: `LDA`/`STA ac,addr`
+// default to *page-zero* (absolute, no index) addressing with only an
+// 8-bit displacement, and dgasm assigns addresses strictly in textual
+// source order starting at `org` (confirmed by reading its assembler.c
+// directly, not assumed). Growing function bodies can push a `var` line
+// emitted after them past address 255, which dgasm rejects.
+//
+// This AsmPrinter does *not* solve that itself (it would require
+// buffering and reordering essentially everything AsmPrinter emits,
+// including labels emitted by its own internal machinery, not just this
+// file's explicit emitRawText calls — real surgery for a marginal gain
+// over the alternative). Instead, the toolchain wrapper this project
+// ships (see the driver script) runs a small, separate text-level
+// reordering pass on `llc`'s output before handing it to dgasm: keep the
+// fixed org/dev/_start preamble first, then move every remaining `var `
+// line before every remaining non-`var` line, preserving relative order
+// within each group. Pure line-oriented text manipulation, easy to
+// verify independently of AsmPrinter's internals. Matches eccc's own
+// proven layout (docs/DESIGN.md / docs/CALLING_CONVENTION.md): small
+// page-zero data first, arbitrarily-large code after, reached only via
+// PC-relative jumps or through-the-jump-table calls, never direct
+// page-zero addressing.
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_LIB_TARGET_ECLIPSE_ECLIPSEASMPRINTER_H
+#define LLVM_LIB_TARGET_ECLIPSE_ECLIPSEASMPRINTER_H
+
+#include "llvm/ADT/SmallVector.h"
+#include "llvm/CodeGen/AsmPrinter.h"
+#include <string>
+
+namespace llvm {
+
+class EclipseAsmPrinter : public AsmPrinter {
+  SmallVector<std::string, 8> CallSlots;
+  // Pointer-word slots for LEAGA (see EclipseInstrInfo.td's LEAGA comment):
+  // "var <name>_PTR = <name>" holds a global's *address* as a page-zero
+  // data word, the same indirection CallSlots already uses for function
+  // addresses. Stores the *target* name (e.g. ".str"); the printer
+  // appends "_PTR" itself when declaring and referencing the slot.
+  SmallVector<std::string, 8> AddrSlots;
+  // Constant page-zero words holding a nonzero LEAGA offset (see the
+  // LEAGA case in emitInstruction): `getelementptr(@global, N)` folded
+  // into a GlobalAddress operand's offset, for N != 0. This ISA has no
+  // immediate-operand ADD, so combining a compile-time-constant offset
+  // into a loaded pointer needs the offset materialized as its own data
+  // word first, the same reason every other "constant" in this backend
+  // goes through a var/constant-pool word (see EclipseInstrInfo.td's
+  // file header). Keyed by (target, offset) so the same offset into the
+  // same global is only declared once. This is a *separate* bookkeeping
+  // vector from AddrSlots (not reusing MF->getConstantPool()) because a
+  // constant pool entry added this late — during per-instruction text
+  // emission — would arrive after emitConstantPool() already ran for
+  // this function and never get its `var` line emitted at all; AddrSlots
+  // and CallSlots already solve exactly this ordering problem by
+  // collecting names during instruction emission and flushing them in
+  // emitEndOfAsmFile, so this follows the same proven pattern.
+  SmallVector<std::pair<std::string, int64_t>, 8> OffsetSlots;
+  bool HasMain = false;
+
+  // Name of the module's `__attribute__((interrupt))` function, if any
+  // (computed once in doInitialization, before any function body is
+  // emitted, since emitStartOfAsmFile needs it for the vector directive
+  // it writes ahead of everything else). Empty means no interrupt handler
+  // in this module. Real hardware has exactly one interrupt vector
+  // (memory location 1), so more than one such function is a hard error
+  // (doInitialization), not a "pick one" situation.
+  std::string InterruptHandlerName;
+
+  void addCallSlot(StringRef Slot) {
+    if (!llvm::is_contained(CallSlots, Slot.str()))
+      CallSlots.push_back(Slot.str());
+  }
+
+  void addAddrSlot(StringRef Target) {
+    if (!llvm::is_contained(AddrSlots, Target.str()))
+      AddrSlots.push_back(Target.str());
+  }
+
+  // Returns the symbol name to use for `Target`'s Offset constant word,
+  // declaring it (once) if this is the first time this exact
+  // (Target, Offset) pair has been seen.
+  std::string addOffsetSlot(StringRef Target, int64_t Offset) {
+    std::string Name = (Target + "_off" + Twine(Offset)).str();
+    for (auto &Entry : OffsetSlots)
+      if (Entry.first == Name)
+        return Name;
+    OffsetSlots.emplace_back(Name, Offset);
+    return Name;
+  }
+
+  // NB: internal JMPs (conditional-branch trailing jumps and plain
+  // unconditional ones) stay direct/PC-relative here, not indirected
+  // through a page-zero slot the way CALL is. Unlike CALL — one slot per
+  // *function*, a naturally small set — a real program can have many
+  // dozens of basic blocks; giving every one a permanent page-zero slot
+  // was tried and overflowed the 256-word page-zero budget on nothing
+  // fancier than eclipse_rt.c's printf/scanf. Out-of-range jumps (dgasm:
+  // "Address out of range", displacement outside -128..127) are instead
+  // relaxed selectively, only where actually needed, by
+  // eclipse-toolchain/reorder_asm.py — it runs after llc, when real
+  // per-instruction addresses are computable, which this AsmPrinter
+  // (still mid-codegen, no real addresses yet) cannot do itself.
+
+public:
+  explicit EclipseAsmPrinter(TargetMachine &TM,
+                              std::unique_ptr<MCStreamer> Streamer)
+      : AsmPrinter(TM, std::move(Streamer), ID) {}
+
+  StringRef getPassName() const override { return "Eclipse Assembly Printer"; }
+
+  bool doInitialization(Module &M) override;
+  void emitStartOfAsmFile(Module &M) override;
+  void emitEndOfAsmFile(Module &M) override;
+  void emitInstruction(const MachineInstr *MI) override;
+  void emitGlobalVariable(const GlobalVariable *GV) override;
+  void emitConstantPool() override;
+
+  // Inline asm operand substitution (e.g. `asm volatile("DOAS %0,012" ::
+  // "r"(ch))` — the escape hatch for device I/O instructions, since those
+  // have no ordinary-C-semantics mapping; see README.md).
+  void printOperand(const MachineInstr *MI, int OpNum, raw_ostream &O);
+  bool PrintAsmOperand(const MachineInstr *MI, unsigned OpNo,
+                        const char *ExtraCode, raw_ostream &O) override;
+
+  // dgasm's grammar has no linkage-visibility directive (".globl" and
+  // friends are a GNU-assembler concept) — labels are just labels.
+  void emitLinkage(const GlobalValue *, MCSymbol *) const override {}
+
+  static char ID;
+};
+
+} // namespace llvm
+
+#endif // LLVM_LIB_TARGET_ECLIPSE_ECLIPSEASMPRINTER_H
