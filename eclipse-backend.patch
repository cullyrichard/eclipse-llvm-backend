diff --git a/llvm/lib/Target/Eclipse/MCTargetDesc/EclipseInstPrinter.cpp b/llvm/lib/Target/Eclipse/MCTargetDesc/EclipseInstPrinter.cpp
new file mode 100644
index 000000000..0fc7b5ea8
--- /dev/null
+++ b/llvm/lib/Target/Eclipse/MCTargetDesc/EclipseInstPrinter.cpp
@@ -0,0 +1,48 @@
+//===-- EclipseInstPrinter.cpp - Convert MCInst to dgasm syntax ----------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM
+// Exceptions. See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "EclipseInstPrinter.h"
+#include "llvm/MC/MCAsmInfo.h"
+#include "llvm/MC/MCExpr.h"
+#include "llvm/MC/MCInst.h"
+
+using namespace llvm;
+
+#define DEBUG_TYPE "asm-printer"
+
+#include "EclipseGenAsmWriter.inc"
+
+// Register "names" are bare accumulator numbers ("0".."3"), matching real
+// Nova/Eclipse assembly (e.g. "ADD 1,0"), not a "%"-prefixed syntax.
+void EclipseInstPrinter::printRegName(raw_ostream &OS, MCRegister Reg) {
+  OS << getRegisterName(Reg);
+}
+
+void EclipseInstPrinter::printInst(const MCInst *MI, uint64_t Address,
+                                    StringRef Annotation,
+                                    const MCSubtargetInfo & /*STI*/,
+                                    raw_ostream &OS) {
+  printInstruction(MI, Address, OS);
+  printAnnotation(OS, Annotation);
+}
+
+// dgasm parses numbers decimal-by-default (see EclipseMCAsmInfo.cpp /
+// eccc's crates/eccc-codegen/src/symbolic.rs), so plain immediates print
+// decimal here, not hex/octal.
+void EclipseInstPrinter::printOperand(const MCInst *MI, unsigned OpNo,
+                                       raw_ostream &OS) {
+  const MCOperand &Op = MI->getOperand(OpNo);
+  if (Op.isReg()) {
+    printRegName(OS, Op.getReg());
+  } else if (Op.isImm()) {
+    OS << Op.getImm();
+  } else {
+    assert(Op.isExpr() && "Expected an expression");
+    MAI.printExpr(OS, *Op.getExpr());
+  }
+}
