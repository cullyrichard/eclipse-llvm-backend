+++ b/llvm/lib/Target/Eclipse/EclipseSubtarget.h
@@ -0,0 +1,142 @@
+//===-- EclipseSubtarget.h - Define Subtarget for the Eclipse -*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM
+// Exceptions. See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_LIB_TARGET_ECLIPSE_ECLIPSESUBTARGET_H
+#define LLVM_LIB_TARGET_ECLIPSE_ECLIPSESUBTARGET_H
+
+#include "EclipseFrameLowering.h"
+#include "EclipseISelLowering.h"
+#include "EclipseInstrInfo.h"
+#include "llvm/CodeGen/LibcallLoweringInfo.h"
+#include "llvm/CodeGen/SelectionDAGTargetInfo.h"
+#include "llvm/CodeGen/TargetSubtargetInfo.h"
+
+#define GET_SUBTARGETINFO_HEADER
+#include "EclipseGenSubtargetInfo.inc"
+
+namespace llvm {
+
+class EclipseSubtarget : public EclipseGenSubtargetInfo {
+  // IMPORTANT — declaration order matters here, and it must stay above
+  // InstrInfo/FrameLowering/TLInfo/TSInfo below: C++ initializes data
+  // members in DECLARATION order regardless of the constructor's own
+  // initializer-list order or of which member's initializer happens to
+  // run ParseSubtargetFeatures as a side effect (see
+  // initializeSubtargetDependencies below). These two bools have no
+  // explicit mention in EclipseSubtarget's own constructor initializer
+  // list, so whatever value ParseSubtargetFeatures gave them gets
+  // silently overwritten right back to their in-class default (`=
+  // false`) the moment the initializer reaches *their own* declaration
+  // position — if that position were *after* InstrInfo/TLInfo/etc (as it
+  // was until this was found and fixed here), every reader of
+  // hasHWFloat()/hasIEEEFloat()/useHardwareFloat() that runs *after* the
+  // constructor body finishes (i.e. essentially every real caller —
+  // EclipseSubtarget::initLibcallLoweringInfo and
+  // EclipseAsmPrinter::emitGlobalVariable both included, since both are
+  // ordinary post-construction method calls) would see the reset `false`
+  // regardless of what `-mattr=` actually requested. Confirmed
+  // empirically, not just reasoned about: a debug build with instance-
+  // address-tagged `errs()` prints in both EclipseSubtarget's own
+  // constructor body and EclipseAsmPrinter::emitGlobalVariable showed
+  // the exact same `this` pointer but HasIEEEFloat having reverted from
+  // true (implicitly, per EclipseTargetLowering's constructor picking
+  // the correct software `__addsf3` under `+ieee` — that read happens
+  // *during* construction, before the reset) back to false by the time
+  // the outer constructor body's own print ran. This was a real,
+  // pre-existing latent bug (present for HasHWFloat since entry #27,
+  // just never previously observed because *every* existing reader of
+  // hasHWFloat() happened to run during construction, not after) — not
+  // something newly introduced by DEBUGGING_NOTES.md entry #30, just
+  // newly exposed by it (emitGlobalVariable's ConstantFP handling is
+  // this file's first-ever post-construction consumer). Fixed here by
+  // reordering, not by touching the (already-correct, and already the
+  // standard LLVM idiom for this exact class of problem)
+  // initializeSubtargetDependencies mechanism itself.
+  bool HasHWFloat = false;
+  bool HasIEEEFloat = false;
+
+  EclipseInstrInfo InstrInfo;
+  EclipseFrameLowering FrameLowering;
+  EclipseTargetLowering TLInfo;
+  SelectionDAGTargetInfo TSInfo;
+
+  // Called from the very first member initializer below (InstrInfo's),
+  // *before* TLInfo (EclipseTargetLowering) is constructed -- its
+  // constructor reads hasHWFloat()/hasIEEEFloat() to decide which
+  // ADD_F32/SUB_F32 libcall implementation to wire up, so
+  // ParseSubtargetFeatures (which sets HasHWFloat/HasIEEEFloat) has to
+  // have already run by then. Plain field initializers can't guarantee
+  // that ordering against another member's constructor (C++ initializes
+  // members in declaration order regardless of initializer-list order,
+  // and ParseSubtargetFeatures itself was previously only called from
+  // the constructor *body*, which always runs after every member is
+  // already constructed) -- this is the standard fix other LLVM
+  // subtargets use for the same problem. See HasHWFloat/HasIEEEFloat's
+  // own comment above for the *other*, separate ordering gotcha this
+  // class had (their declaration position relative to InstrInfo et al.,
+  // not relative to this method).
+  const EclipseSubtarget &initializeSubtargetDependencies(StringRef CPU,
+                                                            StringRef FS);
+
+public:
+  EclipseSubtarget(const Triple &TT, StringRef CPU, StringRef FS,
+                    const TargetMachine &TM);
+
+  void ParseSubtargetFeatures(StringRef CPU, StringRef TuneCPU, StringRef FS);
+
+  bool hasHWFloat() const { return HasHWFloat; }
+  bool hasIEEEFloat() const { return HasIEEEFloat; }
+
+  // Whether ADD_F32/SUB_F32 (and, per entry #30, global float-constant
+  // materialization) should use this target's DG hardware-accelerated
+  // path rather than the original pure-software/IEEE-754-only one --
+  // the single predicate both EclipseSubtarget.cpp's
+  // initLibcallLoweringInfo and EclipseISelLowering.cpp's constructor
+  // key their float-related choices on, kept here so the two copies
+  // (see this class's own comment on why both are needed) can't drift
+  // apart. True whenever `+ieee` was NOT requested (the new default),
+  // or when `+hwfloat` was requested regardless of `+ieee` (preserves
+  // the original, narrower `--hwfloat` meaning exactly).
+  bool useHardwareFloat() const { return !HasIEEEFloat || HasHWFloat; }
+
+  const EclipseInstrInfo *getInstrInfo() const override { return &InstrInfo; }
+  const TargetFrameLowering *getFrameLowering() const override {
+    return &FrameLowering;
+  }
+  const EclipseRegisterInfo *getRegisterInfo() const override {
+    return &InstrInfo.getRegisterInfo();
+  }
+  const EclipseTargetLowering *getTargetLowering() const override {
+    return &TLInfo;
+  }
+  const SelectionDAGTargetInfo *getSelectionDAGInfo() const override {
+    return &TSInfo;
+  }
+
+  // The soft-float libcall names EclipseTargetLowering's constructor sets
+  // via TargetLowering::setLibcallImpl only reach TargetLowering's own
+  // (separate!) LibcallLoweringInfo copy — SelectionDAG's own copy
+  // (DAG.getLibcalls(), which softenSetCCOperands's selectFPCmpLibcall
+  // uses to *choose* between candidate comparison libcalls before the
+  // final makeLibCall) is built independently, straight from the
+  // architecture-keyed default table, via this exact hook. "eclipse"
+  // isn't a recognized architecture there, so without overriding this,
+  // that selection falls through to the generic three-way FCMP3_F32
+  // libcall, which nothing implements — confirmed empirically ("unsupported
+  // library call operation" crashing inside softenSetCCOperands even
+  // after wiring every individual comparison predicate on
+  // EclipseTargetLowering itself). See EclipseSubtarget.cpp's
+  // implementation for the actual mappings (kept in sync with
+  // EclipseISelLowering.cpp's constructor by hand — both need the same
+  // set, since each is consulted by a different softening code path).
+  void initLibcallLoweringInfo(LibcallLoweringInfo &Info) const override;
+};
+
+} // namespace llvm
+
+#endif // LLVM_LIB_TARGET_ECLIPSE_ECLIPSESUBTARGET_H
diff --git a/llvm/lib/Target/Eclipse/EclipseTargetMachine.cpp b/llvm/lib/Target/Eclipse/EclipseTargetMachine.cpp
new file mode 100644
index 000000000..ea2bc5d2c
--- /dev/null
+++ b/llvm/lib/Target/Eclipse/EclipseTargetMachine.cpp
@@ -0,0 +1,99 @@
+//===-- EclipseTargetMachine.cpp - Define TargetMachine for Eclipse -----===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM
+// Exceptions. See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "EclipseTargetMachine.h"
+
+#include "Eclipse.h"
+#include "EclipseMachineFunctionInfo.h"
+#include "TargetInfo/EclipseTargetInfo.h"
+#include "llvm/CodeGen/Passes.h"
+#include "llvm/CodeGen/TargetLoweringObjectFileImpl.h"
+#include "llvm/CodeGen/TargetPassConfig.h"
+#include "llvm/MC/TargetRegistry.h"
+#include "llvm/Support/Compiler.h"
+#include "llvm/Target/TargetOptions.h"
+#include <optional>
+
+using namespace llvm;
+
+// This target's real output is Nova/Eclipse-S140 assembly *text* (see
+// README.md), not an object file — sections/directives in the usual ELF
+// sense don't apply. EclipseAsmPrinter drives module-level emission (the
+// `org`/`dev`/`var`/jump-table preamble, per-function labels) itself
+// directly, bypassing per-global section selection entirely, so which
+// concrete TargetLoweringObjectFile this is doesn't actually matter — ELF
+// is reused here only because it's a ready-made concrete (non-abstract)
+// implementation, not because this target produces ELF output.
+
+extern "C" LLVM_ABI LLVM_EXTERNAL_VISIBILITY void
+LLVMInitializeEclipseTarget() {
+  RegisterTargetMachine<EclipseTargetMachine> X(getTheEclipseTarget());
+  PassRegistry &PR = *PassRegistry::getPassRegistry();
+  initializeEclipseDAGToDAGISelLegacyPass(PR);
+  initializeEclipseAsmPrinterPass(PR);
+}
+
+static std::string computeDataLayout() {
+  // Big-endian (docs/ECLIPSE_ISA_NOTES.md: 32-bit MUL/DIV results treat
+  // AC0 as the *high* word), 16-bit pointers, i16 the native/natural
+  // integer width. There is no 8-bit-addressable byte on real hardware —
+  // this backend promotes everything narrower than i16 up to i16
+  // (mirroring the sibling eccc project's "char is one 16-bit word"
+  // simplification, docs/LIMITATIONS.md) — but LLVM's memory model always
+  // has an 8-bit "byte" as its base unit regardless, so object sizes as
+  // seen by MachineFrameInfo etc. are still real bytes; this backend's own
+  // frame-offset code (EclipseFrameLowering.cpp) converts those to
+  // 16-bit-word counts itself where it matters.
+  return "E-p:16:16-i16:16-i32:16-f32:16-f64:16-n16";
+}
+
+static Reloc::Model getEffectiveRelocModel(std::optional<Reloc::Model> RM) {
+  return RM.value_or(Reloc::Static);
+}
+
+EclipseTargetMachine::EclipseTargetMachine(
+    const Target &T, const Triple &TT, StringRef CPU, StringRef FS,
+    const TargetOptions &Options, std::optional<Reloc::Model> RM,
+    std::optional<CodeModel::Model> CM, CodeGenOptLevel OL, bool JIT)
+    : CodeGenTargetMachineImpl(T, computeDataLayout(), TT, CPU, FS, Options,
+                                getEffectiveRelocModel(RM),
+                                getEffectiveCodeModel(CM, CodeModel::Small),
+                                OL),
+      Subtarget(TT, CPU, FS, *this),
+      TLOF(std::make_unique<TargetLoweringObjectFileELF>()) {
+  initAsmInfo();
+}
+
+namespace {
+class EclipsePassConfig : public TargetPassConfig {
+public:
+  EclipsePassConfig(EclipseTargetMachine &TM, PassManagerBase &PM)
+      : TargetPassConfig(TM, PM) {}
+
+  EclipseTargetMachine &getEclipseTargetMachine() const {
+    return getTM<EclipseTargetMachine>();
+  }
+
+  bool addInstSelector() override {
+    addPass(createEclipseISelDagLegacyPass(getEclipseTargetMachine()));
+    return false;
+  }
+};
+} // namespace
+
+TargetPassConfig *
+EclipseTargetMachine::createPassConfig(PassManagerBase &PM) {
+  return new EclipsePassConfig(*this, PM);
+}
+
+MachineFunctionInfo *EclipseTargetMachine::createMachineFunctionInfo(
+    BumpPtrAllocator &Allocator, const Function &F,
+    const TargetSubtargetInfo *STI) const {
+  return EclipseMachineFunctionInfo::create<EclipseMachineFunctionInfo>(
+      Allocator, F, STI);
+}
