new file mode 100644
index 000000000..5d48a48cb
--- /dev/null
+++ b/llvm/lib/Target/Eclipse/EclipseAsmPrinter.cpp
@@ -0,0 +1,785 @@
+//===-- EclipseAsmPrinter.cpp - Eclipse LLVM assembly writer ------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM
+// Exceptions. See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "EclipseAsmPrinter.h"
+#include "Eclipse.h"
+#include "EclipseMCInstLower.h"
+#include "EclipseSubtarget.h"
+#include "EclipseTargetMachine.h"
+#include "MCTargetDesc/EclipseInstPrinter.h"
+#include "MCTargetDesc/EclipseMCTargetDesc.h"
+#include "TargetInfo/EclipseTargetInfo.h"
+#include "llvm/ADT/APFloat.h"
+#include "llvm/ADT/STLFunctionalExtras.h"
+#include "llvm/ADT/SmallVector.h"
+#include "llvm/CodeGen/MachineConstantPool.h"
+#include "llvm/CodeGen/MachineFunction.h"
+#include "llvm/CodeGen/MachineInstr.h"
+#include "llvm/IR/Constants.h"
+#include "llvm/IR/DerivedTypes.h"
+#include "llvm/IR/GlobalVariable.h"
+#include "llvm/IR/Module.h"
+#include "llvm/MC/MCContext.h"
+#include "llvm/MC/MCInst.h"
+#include "llvm/MC/MCStreamer.h"
+#include "llvm/MC/MCSymbol.h"
+#include "llvm/MC/TargetRegistry.h"
+#include "llvm/Support/Compiler.h"
+#include "llvm/Support/ErrorHandling.h"
+#include "llvm/Support/raw_ostream.h"
+
+#include <functional>
+
+using namespace llvm;
+
+char EclipseAsmPrinter::ID = 0;
+
+INITIALIZE_PASS(EclipseAsmPrinter, "eclipse-asm-printer",
+                 "Eclipse Assembly Printer", false, false)
+
+// dgasm's real string-literal escaping (confirmed against a real dgasm
+// binary by the sibling eccc project — crates/eccc-codegen/src/
+// symbolic.rs's escape_dgasm_string). NUL termination is dgasm's own job
+// ("dgasm NUL-terminates `var` strings automatically"), not added here.
+static std::string escapeDgasmString(StringRef S) {
+  std::string Out;
+  for (unsigned char B : S) {
+    switch (B) {
+    case '\n': Out += "\\n"; break;
+    case '\t': Out += "\\t"; break;
+    case '\r': Out += "\\r"; break;
+    case '"': Out += "\\\""; break;
+    case '\\': Out += "\\\\"; break;
+    default:
+      if (B >= 0x20 && B <= 0x7e)
+        Out += static_cast<char>(B);
+      else
+        Out += ("\\" + Twine::utohexstr(B)).str(); // best-effort; see README.md
+    }
+  }
+  return Out;
+}
+
+// This target's `float`/`double` are both 32 bits wide (double aliased
+// to float -- see README.md/SOFT_FLOAT_NOTES.md), so getValueAPF()'s
+// bitcastToAPInt() is always exactly 32 bits here; DEBUGGING_NOTES.md
+// entry #30 (see Eclipse.td's FeatureIEEEFloat) is what makes this
+// path reachable at all -- see emitGlobalVariable/flattenConstant's own
+// callers for why this is gated on !STI.hasIEEEFloat().
+static uint32_t constantFPBits32(const ConstantFP *CFP) {
+  return static_cast<uint32_t>(CFP->getValueAPF().bitcastToAPInt().getZExtValue());
+}
+
+bool EclipseAsmPrinter::doInitialization(Module &M) {
+  HasMain = M.getFunction("main") != nullptr;
+
+  for (const Function &F : M) {
+    if (F.isDeclaration() || !F.hasFnAttribute("interrupt"))
+      continue;
+    if (!InterruptHandlerName.empty()) {
+      std::string Msg =
+          ("Eclipse backend: more than one __attribute__((interrupt)) "
+           "function in this module (\"" +
+           Twine(InterruptHandlerName) + "\" and \"" + F.getName() +
+           "\") -- real hardware has exactly one interrupt vector (memory "
+           "location 1), so only one handler is possible.")
+              .str();
+      report_fatal_error(StringRef(Msg));
+    }
+    InterruptHandlerName = std::string(F.getName());
+  }
+
+  return AsmPrinter::doInitialization(M);
+}
+
+void EclipseAsmPrinter::emitStartOfAsmFile(Module &M) {
+  OutStreamer->emitRawText(
+      "// Generated by the Eclipse LLVM backend (see README.md)");
+  OutStreamer->emitRawText(
+      "// Assemble with: dgasm -t eclipse_s140 -f simh -o out.simh <this file>");
+  if (!InterruptHandlerName.empty()) {
+    // Real hardware jumps indirect through memory location 1 on interrupt
+    // entry (see the Eclipse S/140 Programmer's Reference's Program Flow
+    // Interruption section, and this backend's RETI/INTEN/JMPABSI, which
+    // implement the matching return sequence) -- this fixed word has to
+    // hold the handler's address before anything else runs. Emitted here,
+    // ahead of even "org 0100", so reorder_asm.py's preamble detection
+    // (which takes *everything* through the first "var _scratch" line as
+    // fixed and untouched -- see its own header comment) carries it
+    // through unmolested, exactly like every hand-verified
+    // interrupt_testN.s test in this project's development history did by
+    // hand.
+    OutStreamer->emitRawText("org 1");
+    OutStreamer->emitRawText(
+        ("var VECTOR = " + Twine(InterruptHandlerName)).str());
+    OutStreamer->emitRawText("");
+  }
+  // org 050 (40 decimal), not the dgasm-default org 0100 (64
+  // decimal): addresses 0 through 047 octal (0-39 decimal) are
+  // *entirely* hardware-reserved on real Eclipse hardware -- not
+  // just the handful this backend itself uses (0/1 for the
+  // interrupt return-address/vector, 040-042 for the hardware
+  // SAVE/RTN stack pointer/frame pointer/stack limit). Confirmed
+  // against the authoritative source, the eclipseemu simulator's
+  // own eclipse_cpu.c header comment ("certain low-memory
+  // locations are reserved for special purposes"), which lists a
+  // real purpose for literally every word from 0 through 047
+  // octal -- including several this backend never touches
+  // (system-call/protection-fault/VCT vectors at 2-7, the
+  // auto-increment/auto-decrement *indirect-addressing* locations
+  // at 020-037 -- genuinely dangerous to repurpose for ordinary
+  // data, since indirectly *referencing* one of these auto-
+  // increments or -decrements it as a side effect regardless of
+  // what the programmer intended it to hold -- and the XOP/FP-
+  // fault/commercial-fault vectors at 044-046, plus 047 itself,
+  // documented there in so many words as "Reserved, do not use").
+  // 050 is the first word after all of that. Moving the origin
+  // down from 0100 reclaims 24 more decimal words (050-077 octal)
+  // of this target's shared 256-word (0-377 octal) page-zero
+  // budget for constant-pool/call-slot/address-slot data -- real,
+  // useful headroom given how often a program has come in just a
+  // few words over that budget in practice (see DEBUGGING_NOTES.md).
+  OutStreamer->emitRawText("org 050"); // see the comment above -- not just a default anymore
+  OutStreamer->emitRawText("dev TTI = 010");
+  OutStreamer->emitRawText("dev TTO = 011");
+  OutStreamer->emitRawText("");
+  if (HasMain) {
+    OutStreamer->emitRawText("_start:");
+    // Real hardware SAVE/RTN (EclipseFrameLowering.cpp's prologue/
+    // epilogue) implicitly use three fixed memory locations as
+    // registers: 040 (stack pointer), 041 (frame pointer), 042 (stack
+    // limit) — see EclipseInstrInfo.td's SAVE/RET comments. Nothing
+    // hardware-resets these, so the very first thing this program does
+    // is deposit real starting values into them; 041 (frame pointer)
+    // needs no explicit init since main's own SAVE writes it before
+    // anything ever reads it. Confirmed empirically on eclipseemu:
+    // without this, main's own first SAVE computes a stack-limit check
+    // against whatever garbage (typically 0) location 042 already
+    // holds, overflows immediately, and traps through location 043 —
+    // which nothing has installed a handler at either — landing on an
+    // unhandled "JMP 0" loop. _STACKTOP is patched to a real,
+    // program-size-aware value by reorder_asm.py's fix_stack_pointer
+    // pass, exactly like the old `_SP` was; _STACKLIM is a fixed,
+    // generous constant near the top of this target's 65536-word
+    // address space (stack grows *upward* from _STACKTOP under real
+    // SAVE/RTN, the opposite direction from the old software stack, so
+    // the limit only needs to clear the hard ceiling, not track program
+    // size the way the starting point does).
+    OutStreamer->emitRawText("\tLDA 0,_STACKTOP");
+    OutStreamer->emitRawText("\tSTA 0,040");
+    OutStreamer->emitRawText("\tLDA 0,_STACKLIM");
+    OutStreamer->emitRawText("\tSTA 0,042");
+    // Direct EJSR, absolute mode -- see EclipseInstrInfo.td's CALL comment
+    // for why "main" (a real symbol) needs no page-zero slot here anymore.
+    OutStreamer->emitRawText("\tEJSR main,0");
+    OutStreamer->emitRawText("\tHALT");
+    OutStreamer->emitRawText("");
+  }
+  OutStreamer->emitRawText("// --- fixed runtime state ---");
+  OutStreamer->emitRawText("var _STACKTOP = 020000");
+  OutStreamer->emitRawText("var _STACKLIM = 0177700");
+  OutStreamer->emitRawText("var _scratch = 0");
+  // A second, independent scratch word, used ONLY by loads/stores whose
+  // address is an EclipseWordAdd node (PerformDAGCombine's low-word/
+  // runtime-GEP address materialization) -- see EclipseInstrInfo.td's
+  // LDINDW/STINDW comment and DEBUGGING_NOTES.md entry #26. Emitted
+  // right after `_scratch`, still ahead of the blank line, so it's swept
+  // into reorder_asm.py's fixed preamble the same way (that script scans
+  // for the first "var _scratch" line specifically, which this is not --
+  // see its own comment -- but it consumes through the next blank line
+  // regardless, and this line is before that blank line).
+  OutStreamer->emitRawText("var _scratch2 = 0");
+  OutStreamer->emitRawText("");
+}
+
+// No module-end bookkeeping needed anymore: direct calls (EJSR) and
+// global access (ELEF/ELDA/ESTA) both reach their targets via real
+// extended addressing, with no page-zero jump-table/pointer-slot
+// declarations left to flush here -- see EclipseInstrInfo.td's CALL and
+// LEAGA comments, and DEBUGGING_NOTES.md, for what this replaced.
+void EclipseAsmPrinter::emitEndOfAsmFile(Module &M) {}
+
+void EclipseAsmPrinter::emitGlobalVariable(const GlobalVariable *GV) {
+  MCSymbol *Sym = getSymbol(GV);
+  if (!GV->hasInitializer()) {
+    OutStreamer->emitRawText(("var " + Twine(Sym->getName()) + " = 0").str());
+    return;
+  }
+  const Constant *Init = GV->getInitializer();
+
+  if (const auto *CDA = dyn_cast<ConstantDataArray>(Init)) {
+    if (CDA->isString()) {
+      StringRef S = CDA->getAsString();
+      S.consume_back(StringRef("\0", 1)); // dgasm adds its own terminator
+      OutStreamer->emitRawText(("var " + Twine(Sym->getName()) + " = \"" +
+                                 escapeDgasmString(S) + "\"")
+                                    .str());
+      return;
+    }
+  }
+
+  // A scalar pointer initializer that's the address of another global (a
+  // function or a data global) -- e.g. `int (*fp)() = foo;` or `int *p =
+  // &g;` -- rather than materializing it at runtime the way LEAGA does for
+  // an ordinary *value* use, this can go directly into the `var` line as a
+  // symbol reference: dgasm resolves `var NAME = OTHERSYMBOL` to
+  // OTHERSYMBOL's own assigned address at assemble time -- the same
+  // "symbol[+N]" expression-folding dgasm's assembler does for every
+  // ELEF/ELDA/ESTA address operand elsewhere in this file (see LEAGA's
+  // emitInstruction case).
+  // No offset/GEP/bitcast unwrapping attempted here -- only a bare
+  // GlobalValue used directly as the initializer, which is what `&foo`/`foo`
+  // (a function decaying to its own pointer) actually look like at the IR
+  // level; anything more complex still falls through to the "unsupported"
+  // case at the end of this function, same as before this existed.
+  if (const auto *GVInit = dyn_cast<GlobalValue>(Init)) {
+    OutStreamer->emitRawText(("var " + Twine(Sym->getName()) + " = " +
+                               Twine(getSymbol(GVInit)->getName()))
+                                  .str());
+    return;
+  }
+
+  // A scalar `float`/`double` initializer (e.g. `static float ga = 12.5f;`)
+  // -- DEBUGGING_NOTES.md entry #30. Pre-entry-#30 (and still, with
+  // `+ieee` set -- see Eclipse.td's FeatureIEEEFloat), this fell all the
+  // way through to the generic "unsupported leaf constant" fallback at
+  // the end of this function and silently materialized as a single zero
+  // word -- a real, confirmed, pre-existing bug (entry #27 point 9),
+  // *not* fixed unconditionally here since doing so would make `+ieee`
+  // fail its own "byte-for-byte identical to every pre-entry-#30 build"
+  // requirement. Emits the constant's real IEEE-754 bit pattern (not
+  // DG hex-float -- entry #30's own design-rationale comment on
+  // Eclipse.td's FeatureIEEEFloat explains why a true native hex-float
+  // ABI wasn't pursued end-to-end) as two words, most-significant first,
+  // using the exact same "`_word1`, decimal, most-significant-first"
+  // convention the >16-bit ConstantInt case just below already
+  // establishes -- so this target's existing "access word N of a bulk
+  // global" addressing (LEAGA/ELDA/ESTA, EclipseISelLowering.cpp's
+  // PerformDAGCombine) finds it correctly with no further backend
+  // support needed.
+  if (const auto *CFP = dyn_cast<ConstantFP>(Init)) {
+    const EclipseSubtarget &STI =
+        static_cast<const EclipseTargetMachine &>(TM).getSubtarget();
+    if (!STI.hasIEEEFloat()) {
+      uint32_t Bits = constantFPBits32(CFP);
+      OutStreamer->emitRawText(
+          ("var " + Twine(Sym->getName()) + " = " +
+           Twine(static_cast<int64_t>(static_cast<int16_t>(Bits >> 16))))
+              .str());
+      OutStreamer->emitRawText(
+          ("var " + Twine(Sym->getName()) + "_word1 = " +
+           Twine(static_cast<int64_t>(static_cast<int16_t>(Bits & 0xFFFFu))))
+              .str());
+      return;
+    }
+    // +ieee: fall through to the "unsupported leaf constant" case at the
+    // end of this function, preserving this target's original behavior
+    // (silently materializes as 0) exactly.
+  }
+
+  if (const auto *CI = dyn_cast<ConstantInt>(Init)) {
+    // A scalar initializer wider than one Eclipse word (e.g. a 32-bit
+    // `long`/`unsigned long`, this target's only scalar type besides i16)
+    // needs one `var` line *per word*, most-significant first — the same
+    // multi-word layout the `_off1`/"access word N" indirect-addressing
+    // scheme (see LEAGA's emitInstruction case and
+    // EclipseISelLowering.cpp's PerformDAGCombine) already assumes every
+    // >16-bit global has. A single `var NAME = <64-bit decimal value>`
+    // line here does NOT do that: dgasm's `var` only ever reserves and
+    // deposits *one* word, silently truncating the decimal value to its
+    // low 16 bits at parse time. This was a real, previously-undiscovered
+    // bug, not a hypothetical: confirmed by tracing a `static u32 g_a =
+    // 0x40400000UL;` global on eclipseemu all the way down to its actual
+    // deposited memory contents — both words came back 0x0000 (0x40400000
+    // truncated mod 2^16 happens to be exactly 0 for that value, which is
+    // what made it look, from the *load* side alone, like a "high word
+    // right, low word wrong" bug rather than "the global's storage was
+    // never really 32 bits wide in the first place"). Any 32-bit-wide
+    // global's arithmetic silently corrupts as a result, regardless of
+    // whether the *load* path is otherwise correct.
+    unsigned BitWidth = CI->getBitWidth();
+    if (BitWidth <= 16) {
+      OutStreamer->emitRawText(("var " + Twine(Sym->getName()) + " = " +
+                                 Twine(CI->getSExtValue()))
+                                    .str());
+      return;
+    }
+    APInt Val = CI->getValue();
+    unsigned NumWords = (BitWidth + 15) / 16;
+    for (unsigned i = 0; i != NumWords; ++i) {
+      unsigned ShiftAmt = (NumWords - 1 - i) * 16;
+      int16_t Word =
+          static_cast<int16_t>(Val.lshr(ShiftAmt).trunc(16).getZExtValue());
+      // Only the first (most-significant) word keeps the real symbol
+      // name — LEAGA/ELDAGA/ESTAGA always materialize/access *this*
+      // word's address directly, and every later word is only ever
+      // reached relative to it via a "target+N" address expression
+      // (extendedAddrExpr), never addressed by its own name — same
+      // convention emitArrayElements below already uses for
+      // array elements past the first.
+      std::string Name = i == 0 ? Sym->getName().str()
+                                 : (Sym->getName() + "_word" + Twine(i)).str();
+      OutStreamer->emitRawText(
+          ("var " + Twine(Name) + " = " + Twine(static_cast<int64_t>(Word)))
+              .str());
+    }
+    return;
+  }
+
+  // Numeric array initializer (e.g. `static const unsigned int prog[] =
+  // {...}`) — every array element becomes its own `var` line, in order,
+  // so dgasm's own sequential address assignment (each `var` line takes
+  // the next word) naturally lays them out contiguously; C-level
+  // pointer/index arithmetic on the array (computed relative to the
+  // *first* element's address, which is this global's own symbol) then
+  // finds every later element correctly with no further backend support
+  // needed. Only the first element keeps the real symbol name — the
+  // rest just need *a* unique, never-referenced-by-name label so dgasm
+  // accepts the declaration; nothing ever addresses them by name.
+  //
+  // This was a real, silent bug before this comment existed: an array
+  // initializer that reached neither the ConstantInt nor the
+  // ConstantDataArray-isString() case above fell through to a single
+  // placeholder `var NAME = 0` word instead of the real data — so any
+  // array with more than one element silently lost everything past its
+  // first word, and indexing into it read whatever unrelated global
+  // happened to be laid out next. Found by tracing actual DOA/DOB
+  // values sent to a real device on eclipseemu and discovering the
+  // "array" data was actually a different global's string contents.
+  auto emitArrayElements = [&](unsigned NumElts,
+                                llvm::function_ref<int64_t(unsigned)> At) {
+    for (unsigned i = 0; i != NumElts; ++i) {
+      std::string Name = i == 0 ? Sym->getName().str()
+                                 : (Sym->getName() + "_elem" + Twine(i)).str();
+      OutStreamer->emitRawText(
+          ("var " + Twine(Name) + " = " + Twine(At(i))).str());
+    }
+  };
+
+  if (const auto *CDA = dyn_cast<ConstantDataArray>(Init)) {
+    // Reached only for the non-string (numeric) case now — isString()
+    // was already handled and returned above.
+    emitArrayElements(CDA->getNumElements(), [&](unsigned i) {
+      return CDA->getElementAsAPInt(i).getSExtValue();
+    });
+    return;
+  }
+
+  if (const auto *CA = dyn_cast<ConstantArray>(Init)) {
+    emitArrayElements(CA->getNumOperands(), [&](unsigned i) {
+      if (const auto *Elt = dyn_cast<ConstantInt>(CA->getOperand(i)))
+        return Elt->getSExtValue();
+      return int64_t{0}; // non-integer element: still not supported
+    });
+    return;
+  }
+
+  if (isa<ConstantAggregateZero>(Init)) {
+    if (auto *AT = dyn_cast<ArrayType>(GV->getValueType())) {
+      emitArrayElements(AT->getNumElements(), [](unsigned) { return 0; });
+      return;
+    }
+  }
+
+  // Struct initializer (e.g. `static fps_word_struct g = {...};`) —
+  // flattened field-by-field into one `var` line per word, in source
+  // field order, on the same "sequential `var` lines lay out
+  // contiguously, only the first keeps the real symbol name" convention
+  // emitArrayElements above already relies on. This backend has no
+  // padding to account for: every scalar field here is i16- or
+  // (32-bit-as-two-i16-words) granular (see the ConstantInt case above),
+  // so the field's own declaration order *is* its word order.
+  //
+  // This was a real, confirmed bug before this existed, not a
+  // hypothetical gap: a struct-typed global fell all the way through to
+  // the single-placeholder-word case below regardless of how many fields
+  // it actually had, so every field past the first silently aliased
+  // whatever global happened to be laid out immediately after it in
+  // page-zero — confirmed by tracing a 3-word `fps_word_struct` global
+  // whose `.mh`/`.ml` fields came back reading two bytes of an unrelated
+  // string constant's own text, and confirming the *values* computed
+  // going *into* the struct were correct at every call site the whole
+  // time (i.e. this was purely a storage-size bug, not a codegen bug in
+  // whatever computed the field values).
+  //
+  // flattenConstant recurses through nested aggregates (a struct field
+  // that's itself an array or struct, or vice versa) rather than only
+  // handling one level, since dgasm's sequential `var` layout needs the
+  // *fully* flattened word sequence regardless of how deep the C-level
+  // nesting is. Each flattened word is the literal RHS text for its own
+  // `var` line -- almost always a decimal number, but a struct field that's
+  // itself a pointer to another global (a function pointer field, e.g.
+  // `struct S { int (*fptr)(); } s = { &zero };`) instead becomes a symbol
+  // reference to that global's own assembler name, exactly like the
+  // top-level scalar-pointer-initializer case just above this lambda
+  // (same dgasm `var NAME = OTHERSYMBOL` mechanism relied on elsewhere in
+  // this file) -- this was a real, confirmed gap, not
+  // a hypothetical: `struct S s = { &zero };` previously fell through to
+  // the final "unsupported leaf constant" case below and silently stored a
+  // literal 0 instead of zero's real address (found via c-testsuite 00089,
+  // "calling through a function pointer reached via nested struct/typedef
+  // indirection" -- traced directly to this exact fallback). A field type
+  // genuinely unsupported here (a float; a pointer expression more complex
+  // than a bare GlobalValue, e.g. an offset/bitcast -- this target has no
+  // register class for a directly materializable float constant, and no
+  // attempt is made here to compute a compile-time symbol-plus-offset
+  // expression dgasm might not accept anyway) still degrades to a single
+  // zero word for just that field rather than losing the fields around it.
+  std::function<void(const Constant *, Type *, SmallVectorImpl<std::string> &)>
+      flattenConstant = [&](const Constant *C, Type *Ty,
+                             SmallVectorImpl<std::string> &Out) {
+        if (!C || isa<ConstantAggregateZero>(C) || isa<UndefValue>(C)) {
+          if (auto *ST = dyn_cast<StructType>(Ty)) {
+            for (unsigned i = 0, e = ST->getNumElements(); i != e; ++i)
+              flattenConstant(nullptr, ST->getElementType(i), Out);
+          } else if (auto *AT = dyn_cast<ArrayType>(Ty)) {
+            for (unsigned i = 0, e = AT->getNumElements(); i != e; ++i)
+              flattenConstant(nullptr, AT->getElementType(), Out);
+          } else if (auto *IT = dyn_cast<IntegerType>(Ty)) {
+            unsigned NumWords = (IT->getBitWidth() + 15) / 16;
+            for (unsigned i = 0; i != NumWords; ++i)
+              Out.push_back("0");
+          } else {
+            Out.push_back("0"); // unsupported leaf type
+          }
+          return;
+        }
+        if (const auto *GVLeaf = dyn_cast_or_null<GlobalValue>(C)) {
+          Out.push_back(getSymbol(GVLeaf)->getName().str());
+          return;
+        }
+        // A `float`/`double` struct field -- same DEBUGGING_NOTES.md
+        // entry #30 handling as the top-level scalar case above (see its
+        // own comment), just emitting into this lambda's flattened word
+        // list instead of directly to a `var` line. `+ieee` deliberately
+        // falls through to the "unsupported leaf constant" case at the
+        // bottom of this lambda, preserving the original single-zero-word
+        // behavior exactly.
+        if (const auto *CFP = dyn_cast_or_null<ConstantFP>(C)) {
+          const EclipseSubtarget &STI =
+              static_cast<const EclipseTargetMachine &>(TM).getSubtarget();
+          if (!STI.hasIEEEFloat()) {
+            uint32_t Bits = constantFPBits32(CFP);
+            Out.push_back(
+                Twine(static_cast<int64_t>(static_cast<int16_t>(Bits >> 16)))
+                    .str());
+            Out.push_back(Twine(static_cast<int64_t>(
+                                     static_cast<int16_t>(Bits & 0xFFFFu)))
+                              .str());
+            return;
+          }
+        }
+        if (const auto *CI = dyn_cast_or_null<ConstantInt>(C)) {
+          unsigned BitWidth = CI->getBitWidth();
+          if (BitWidth <= 16) {
+            Out.push_back(Twine(CI->getSExtValue()).str());
+            return;
+          }
+          APInt Val = CI->getValue();
+          unsigned NumWords = (BitWidth + 15) / 16;
+          for (unsigned i = 0; i != NumWords; ++i) {
+            unsigned ShiftAmt = (NumWords - 1 - i) * 16;
+            Out.push_back(Twine(static_cast<int16_t>(
+                                     Val.lshr(ShiftAmt).trunc(16).getZExtValue()))
+                              .str());
+          }
+          return;
+        }
+        if (const auto *CS = dyn_cast_or_null<ConstantStruct>(C)) {
+          for (unsigned i = 0, e = CS->getNumOperands(); i != e; ++i)
+            flattenConstant(CS->getOperand(i),
+                             CS->getOperand(i)->getType(), Out);
+          return;
+        }
+        if (const auto *CA = dyn_cast_or_null<ConstantArray>(C)) {
+          for (unsigned i = 0, e = CA->getNumOperands(); i != e; ++i)
+            flattenConstant(CA->getOperand(i),
+                             CA->getOperand(i)->getType(), Out);
+          return;
+        }
+        if (const auto *CDA = dyn_cast_or_null<ConstantDataArray>(C)) {
+          for (unsigned i = 0, e = CDA->getNumElements(); i != e; ++i)
+            Out.push_back(Twine(CDA->getElementAsAPInt(i).getSExtValue()).str());
+          return;
+        }
+        Out.push_back("0"); // unsupported leaf constant (e.g. a float)
+      };
+
+  if (isa<StructType>(GV->getValueType()) &&
+      (isa<ConstantStruct>(Init) || isa<ConstantAggregateZero>(Init))) {
+    SmallVector<std::string, 8> Words;
+    flattenConstant(Init, GV->getValueType(), Words);
+    for (unsigned i = 0, e = Words.size(); i != e; ++i) {
+      std::string Name = i == 0 ? Sym->getName().str()
+                                 : (Sym->getName() + "_field" + Twine(i)).str();
+      OutStreamer->emitRawText(
+          ("var " + Twine(Name) + " = " + Twine(Words[i])).str());
+    }
+    return;
+  }
+
+  // Anything else beyond a simple i16 scalar, string literal, numeric
+  // array, or struct isn't materialized yet — see README.md "Known
+  // limitations".
+  OutStreamer->emitRawText(
+      ("var " + Twine(Sym->getName()) + " = 0 // TODO: unsupported initializer")
+          .str());
+}
+
+void EclipseAsmPrinter::emitConstantPool() {
+  const MachineConstantPool *MCP = MF->getConstantPool();
+  const std::vector<MachineConstantPoolEntry> &Entries = MCP->getConstants();
+  if (Entries.empty())
+    return;
+  for (unsigned i = 0, e = Entries.size(); i != e; ++i) {
+    const MachineConstantPoolEntry &E = Entries[i];
+    if (E.isMachineConstantPoolEntry())
+      continue; // not used by this backend
+    int64_t Value = 0;
+    if (const auto *CI = dyn_cast<ConstantInt>(E.Val.ConstVal))
+      Value = CI->getSExtValue();
+    OutStreamer->emitRawText(
+        ("var " + Twine(GetCPISymbol(i)->getName()) + " = " + Twine(Value))
+            .str());
+  }
+}
