+
+#ifndef LLVM_LIB_TARGET_ECLIPSE_ECLIPSESUBTARGET_H
+#define LLVM_LIB_TARGET_ECLIPSE_ECLIPSESUBTARGET_H
+
+#include "EclipseFrameLowering.h"
+#include "EclipseISelLowering.h"
+#include "EclipseInstrInfo.h"
+#include "llvm/CodeGen/LibcallLoweringInfo.h"
+#include "llvm/CodeGen/SelectionDAGTargetInfo.h"
+#include "llvm/CodeGen/TargetSubtargetInfo.h"
+
+#define GET_SUBTARGETINFO_HEADER
+#include "EclipseGenSubtargetInfo.inc"
+
+namespace llvm {
+
+class EclipseSubtarget : public EclipseGenSubtargetInfo {
+  EclipseInstrInfo InstrInfo;
+  EclipseFrameLowering FrameLowering;
+  EclipseTargetLowering TLInfo;
+  SelectionDAGTargetInfo TSInfo;
+
+public:
+  EclipseSubtarget(const Triple &TT, StringRef CPU, StringRef FS,
+                    const TargetMachine &TM);
+
+  void ParseSubtargetFeatures(StringRef CPU, StringRef TuneCPU, StringRef FS);
+
+  const EclipseInstrInfo *getInstrInfo() const override { return &InstrInfo; }
+  const TargetFrameLowering *getFrameLowering() const override {
+    return &FrameLowering;
+  }
+  const EclipseRegisterInfo *getRegisterInfo() const override {
+    return &InstrInfo.getRegisterInfo();
+  }
+  const EclipseTargetLowering *getTargetLowering() const override {
+    return &TLInfo;
+  }
+  const SelectionDAGTargetInfo *getSelectionDAGInfo() const override {
+    return &TSInfo;
+  }
+
+  // The soft-float libcall names EclipseTargetLowering's constructor sets
+  // via TargetLowering::setLibcallImpl only reach TargetLowering's own
+  // (separate!) LibcallLoweringInfo copy — SelectionDAG's own copy
+  // (DAG.getLibcalls(), which softenSetCCOperands's selectFPCmpLibcall
+  // uses to *choose* between candidate comparison libcalls before the
+  // final makeLibCall) is built independently, straight from the
+  // architecture-keyed default table, via this exact hook. "eclipse"
+  // isn't a recognized architecture there, so without overriding this,
+  // that selection falls through to the generic three-way FCMP3_F32
+  // libcall, which nothing implements — confirmed empirically ("unsupported
+  // library call operation" crashing inside softenSetCCOperands even
+  // after wiring every individual comparison predicate on
+  // EclipseTargetLowering itself). See EclipseSubtarget.cpp's
+  // implementation for the actual mappings (kept in sync with
+  // EclipseISelLowering.cpp's constructor by hand — both need the same
+  // set, since each is consulted by a different softening code path).
+  void initLibcallLoweringInfo(LibcallLoweringInfo &Info) const override;
+};
+
+} // namespace llvm
