+//===-- EclipseRegisterInfo.cpp - Eclipse Register Information ----------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM
+// Exceptions. See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "EclipseRegisterInfo.h"
+#include "EclipseFrameLowering.h"
+#include "EclipseInstrInfo.h"
+#include "llvm/CodeGen/MachineConstantPool.h"
+#include "llvm/CodeGen/MachineFrameInfo.h"
+#include "llvm/CodeGen/MachineFunction.h"
+#include "llvm/CodeGen/MachineInstrBuilder.h"
+#include "llvm/CodeGen/MachineRegisterInfo.h"
+#include "llvm/IR/Constants.h"
+
+#define GET_REGINFO_TARGET_DESC
+#include "EclipseGenRegisterInfo.inc"
+
+using namespace llvm;
+
+EclipseRegisterInfo::EclipseRegisterInfo()
+    : EclipseGenRegisterInfo(Eclipse::AC3 /*RA, JSR's implicit target*/) {}
+
+const MCPhysReg *
+EclipseRegisterInfo::getCalleeSavedRegs(const MachineFunction *MF) const {
+  // AC2 (FP) and AC3 (return address) are saved/restored explicitly by
+  // EclipseFrameLowering's prologue/epilogue (mirroring the sibling `eccc`
+  // project's proven convention — see docs/CALLING_CONVENTION.md), not via
+  // the generic callee-saved-register spill mechanism.
+  static const MCPhysReg NoRegs[] = {0};
+  // An `__attribute__((interrupt))` handler is entered asynchronously, not
+  // via a normal call site, so there's no caller-side spill code protecting
+  // AC0/AC1 across it the way there would be across an ordinary call.
+  // Treating them as callee-saved here makes the generic prologue/epilogue
+  // inserter spill/reload whichever of the two the handler body actually
+  // clobbers, using the same frame-slot machinery already used for regular
+  // register-allocator spills.
+  static const MCPhysReg InterruptRegs[] = {Eclipse::AC0, Eclipse::AC1, 0};
+  if (MF && MF->getFunction().hasFnAttribute("interrupt"))
+    return InterruptRegs;
+  return NoRegs;
+}
+
+BitVector EclipseRegisterInfo::getReservedRegs(const MachineFunction &MF) const {
+  BitVector Reserved(getNumRegs());
+  // Only AC0/AC1 are available to the allocator: AC2 is the frame pointer,
+  // AC3 holds JSR's return address. Four accumulators total, two already
+  // spoken for — see docs/CALLING_CONVENTION.md.
+  Reserved.set(Eclipse::AC2);
+  Reserved.set(Eclipse::AC3);
+  return Reserved;
+}
+
+bool EclipseRegisterInfo::eliminateFrameIndex(MachineBasicBlock::iterator II,
+                                               int /*SPAdj*/,
+                                               unsigned FIOperandNum,
+                                               RegScavenger * /*RS*/) const {
+  MachineInstr &MI = *II;
+  int FI = MI.getOperand(FIOperandNum).getIndex();
+  MachineFunction &MF = *MI.getParent()->getParent();
+  const MachineFrameInfo &MFI = MF.getFrameInfo();
+
+  // EclipseFrameLowering assigns every stack object an FP-relative
+  // displacement up front (its processFunctionBeforeFrameFinalized),
+  // matching eccc's frame.rs formula exactly: parameters at FP+2.., locals
+  // /temps at FP-cumulative-word-count.
+  int64_t Offset = MFI.getObjectOffset(FI);
+
+  if (MI.getOpcode() == Eclipse::LEAFI) {
+    // No load-effective-address instruction, and no immediate-operand
+    // instructions at all on this ISA (see EclipseInstrInfo.td) — an
+    // address-of-local genuinely needs: copy FP, materialize the now-known
+    // offset via a fresh constant-pool entry, add it in. This is the one
+    // place the offset is concrete, so it's also the one place this
+    // pseudo can be expanded.
+    MachineBasicBlock &MBB = *MI.getParent();
+    const auto &TII = *MF.getSubtarget().getInstrInfo();
+    MachineRegisterInfo &MRI = MF.getRegInfo();
+    DebugLoc DL = MI.getDebugLoc();
+    Register Dst = MI.getOperand(0).getReg();
+
+    unsigned CPI = MF.getConstantPool()->getConstantPoolIndex(
+        ConstantInt::get(
+            Type::getInt16Ty(MF.getFunction().getContext()), Offset, true),
+        Align(2));
+    Register OffReg = MRI.createVirtualRegister(&Eclipse::GPRRegClass);
+    BuildMI(MBB, MI, DL, TII.get(Eclipse::LDABS), OffReg)
+        .addConstantPoolIndex(CPI);
+    BuildMI(MBB, MI, DL, TII.get(Eclipse::MOVrr), Dst).addReg(Eclipse::AC2);
+    BuildMI(MBB, MI, DL, TII.get(Eclipse::ADDrr), Dst)
+        .addReg(OffReg)
+        .addReg(Dst);
+    MI.eraseFromParent();
+    return true; // MI is gone; caller must not touch it further.
+  }
+
+  // LDFI/STFI bake index=2 (AC2/FP-relative) into their AsmString, and
+  // real hardware only encodes an 8-bit *signed* displacement for
+  // AC2-relative indexed addressing (-128..127 — dgasm's own "Address
+  // out of range" diagnostic confirms the same bound). A large enough
+  // stack frame (big local arrays, or just many locals) can easily push
+  // a variable's FP-relative displacement past that; when it does,
+  // substituting the raw offset in place like the in-range path below
+  // does produces an instruction dgasm will reject outright (confirmed
+  // against c-testsuite 00128/00143/00200, all of which have large local
+  // frames). Fall back to the same address-materialize-then-indirect-
+  // through-page-zero mechanism the LEAFI case above already uses for
+  // &local, and that LDIND/STIND's emitIndirectMem
+  // (EclipseISelLowering.cpp) already uses for a runtime pointer value:
+  // build the real address (FP + Offset) into a register, stash it in
+  // the shared page-zero `_scratch` word, and access memory through
+  // `@_scratch` indirection — exactly like a runtime pointer, just with
+  // a compile-time-known value playing the role of the pointer.
+  constexpr int64_t MinDisp = -128, MaxDisp = 127;
+  if ((MI.getOpcode() == Eclipse::LDFI || MI.getOpcode() == Eclipse::STFI) &&
+      (Offset < MinDisp || Offset > MaxDisp)) {
+    MachineBasicBlock &MBB = *MI.getParent();
+    const auto &TII = *MF.getSubtarget().getInstrInfo();
+    MachineRegisterInfo &MRI = MF.getRegInfo();
+    DebugLoc DL = MI.getDebugLoc();
+    LLVMContext &Ctx = MF.getFunction().getContext();
+    Type *I16Ty = Type::getInt16Ty(Ctx);
+
+    // Materializing Offset as a single full-width constant (one
+    // MF.getConstantPool() entry per *distinct* offset value) is the
+    // obvious approach, and was tried first — but page-zero data
+    // (constant pool entries included) is a hard, shared 256-word budget
+    // across the *whole program* (see eclipse-cc's own comment), and a
+    // single function can have many separately out-of-range locals with
+    // all-different offsets (confirmed: c-testsuite 00200 has 58 of
+    // them, from one big block of small temporaries) — 58 one-off
+    // constants was enough to overflow that budget on its own, even
+    // though nothing else about the program is unusually large. Instead,
+    // decompose |Offset| into its power-of-two components and accumulate
+    // them: every out-of-range site in a function only ever needs a
+    // constant for a bit *value* (1, 2, 4, ... at most 16 of them for an
+    // i16), never for the full offset, and MachineConstantPool already
+    // dedups identical constants — so 58 different offsets sharing the
+    // same handful of set bits collectively costs at most ~16 words
+    // instead of 58.
+    bool Negative = Offset < 0;
+    uint64_t Mag = Negative ? static_cast<uint64_t>(-Offset)
+                             : static_cast<uint64_t>(Offset);
+
+    bool IsLoad = MI.getOpcode() == Eclipse::LDFI;
+    Register Src;
+    if (!IsLoad) {
+      // A store's operand 0 is the value being stored, which needs to
+      // stay live all the way to the final indirect store below — but
+      // the address-decomposition loop just below can need two scratch
+      // registers live at once (the running total plus the bit it's
+      // currently folding in), and this target's allocatable GPR class
+      // has only two members (AC0/AC1; AC2/AC3 are reserved — see
+      // getReservedRegs above) to begin with. Protecting Src through
+      // that whole loop as a *third* concurrently-live value is exactly
+      // the register pressure that overwhelmed the scavenger's single
+      // emergency spill slot the first time this was tried (confirmed
+      // empirically: "Cannot scavenge register without an emergency
+      // spill slot!" on c-testsuite 00128, before this stash was added).
+      // Stashing Src's value into the shared page-zero `_scratch` word
+      // up front frees its physical register for the loop to use, same
+      // as any other now-dead value; it gets reloaded, by value, right
+      // before the final indirect store overwrites `_scratch` with the
+      // address instead.
+      Src = MI.getOperand(0).getReg();
+      BuildMI(MBB, MI, DL, TII.get(Eclipse::STABS))
+          .addReg(Src)
+          .addExternalSymbol("_scratch");
+    }
+
+    // Loads have a spare register the way stores don't (operand 0, the
+    // destination, is otherwise unused until the final result lands in
+    // it) — reuse it as the running total, same trick LEAFI uses above,
+    // instead of allocating yet another fresh one.
+    Register AddrReg = IsLoad ? MI.getOperand(0).getReg()
+                               : MRI.createVirtualRegister(&Eclipse::GPRRegClass);
+    bool First = true;
+    for (unsigned Bit = 0; Bit < 16; ++Bit) {
+      uint64_t BitVal = 1ULL << Bit;
+      if (!(Mag & BitVal))
+        continue;
+      int64_t Signed = Negative ? -static_cast<int64_t>(BitVal)
+                                 : static_cast<int64_t>(BitVal);
+      unsigned CPI = MF.getConstantPool()->getConstantPoolIndex(
+          ConstantInt::get(I16Ty, Signed, true), Align(2));
+      if (First) {
+        BuildMI(MBB, MI, DL, TII.get(Eclipse::LDABS), AddrReg)
+            .addConstantPoolIndex(CPI);
+        First = false;
+      } else {
+        Register BitReg = MRI.createVirtualRegister(&Eclipse::GPRRegClass);
+        BuildMI(MBB, MI, DL, TII.get(Eclipse::LDABS), BitReg)
+            .addConstantPoolIndex(CPI);
+        BuildMI(MBB, MI, DL, TII.get(Eclipse::ADDrr), AddrReg)
+            .addReg(BitReg)
+            .addReg(AddrReg);
+      }
+    }
+    // Mag is never 0 here (Offset would already have taken the in-range
+    // path above), so the loop above always runs at least once and
+    // AddrReg always ends up defined before this next instruction reads
+    // it.
+    BuildMI(MBB, MI, DL, TII.get(Eclipse::ADDrr), AddrReg)
+        .addReg(Eclipse::AC2)
+        .addReg(AddrReg);
+
+    if (IsLoad) {
+      BuildMI(MBB, MI, DL, TII.get(Eclipse::STABS))
+          .addReg(AddrReg)
+          .addExternalSymbol("_scratch");
+      BuildMI(MBB, MI, DL, TII.get(Eclipse::LDABSI), AddrReg)
+          .addExternalSymbol("_scratch");
+    } else {
+      Register ValReg = MRI.createVirtualRegister(&Eclipse::GPRRegClass);
+      BuildMI(MBB, MI, DL, TII.get(Eclipse::LDABS), ValReg)
+          .addExternalSymbol("_scratch");
+      BuildMI(MBB, MI, DL, TII.get(Eclipse::STABS))
+          .addReg(AddrReg)
+          .addExternalSymbol("_scratch");
+      BuildMI(MBB, MI, DL, TII.get(Eclipse::STABSI))
+          .addReg(ValReg)
+          .addExternalSymbol("_scratch");
+    }
+    MI.eraseFromParent();
+    return true; // MI is gone; caller must not touch it further.
+  }
+
+  // LDFI/STFI-family instructions bake index=2 (AC2/FP-relative)
+  // into their AsmString, so eliminating the frame index here just means
+  // substituting the resolved displacement in place of the operand.
+  MI.getOperand(FIOperandNum).ChangeToImmediate(Offset);
+  return false;
+}
+
+Register EclipseRegisterInfo::getFrameRegister(const MachineFunction & /*MF*/) const {
+  return Eclipse::AC2;
+}
